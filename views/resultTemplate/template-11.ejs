<%
  const resultList = Array.isArray(results)
    ? results
    : (results ? [results] : []);
  const isBulk = resultList.length > 1;
  const firstResult = resultList[0];

  const session = firstResult?.section || '';
  const term = firstResult?.term || '';
  const schoolName = firstResult?.schoolName || '';

  const params = new URLSearchParams({
    session,
    term,
    schoolName,
    sclass: sclass 
  }).toString();

  const pdfUrl = `/results/pdf?${params}`;
  const imageUrl = `/results/image?${params}`;

  const safe = (value, fallback = '—') =>
    value !== undefined && value !== null && value !== ''
      ? value
      : fallback;

  const overall = (avg) => {
    avg = Number(avg) || 0;
    if (avg >= 80) return ['A', 'Excellent'];
    if (avg >= 70) return ['B', 'Very Good'];
    if (avg >= 60) return ['C', 'Good'];
    if (avg >= 50) return ['D', 'Fair'];
    if (avg >= 40) return ['E', 'Pass'];
    return ['F', 'Fail'];
  };

  // Conduct rows: only the ones that have a value are shown
  const conductFields = [
    ['attitude', 'Attitude to Learning'],
    ['neatness', 'Neatness'],
    ['punctuality', 'Punctuality'],
    ['participation', 'Participation'],
    ['cooperation', 'Cooperation'],
    ['teamwork', 'Teamwork'],
    ['respect', 'Respect'],
    ['relationship', 'Relationship With Others'],
    ['responsibility', 'Responsibility'],
    ['leadership', 'Leadership']
  ];
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Result - <%= school.schoolName %></title>
    <link rel="stylesheet" href="/styles/results/template-11.css">
</head>

<body>

    <!-- DOWNLOAD CONTROLS -->
    <% if (resultList.length > 0) { %>
        <div class="no-print download-toolbar">
            <a href="<%= pdfUrl %>" class="download-btn pdf-btn">Download PDF</a>

            <% if (!isBulk) { %>
                <a href="<%= imageUrl %>" class="download-btn image-btn">Download Image</a>
            <% } %>

            <button onclick="window.print()" class="download-btn print-btn">Print</button>
        </div>
    <% } else { %>
        <div class="empty-state">
            <h2>No result available</h2>
            <p>There are no results to display.</p>
        </div>
    <% } %>

<% resultList.forEach((result) => {
     const [gradeLetter, gradeWord] = overall(result.average);
     const avg = Math.max(0, Math.min(100, Number(result.average) || 0));
     const days = (Number(result.present) || 0) + (Number(result.absent) || 0);
     const rate = days > 0 ? ((Number(result.present) || 0) / days) * 100 : 0;
     const schoolEmail = school.schoolEmail || school.email;
     const nextTerm = result.nextTerm || result.nextterm;
     const conduct = conductFields.filter(f => result[f[0]] !== undefined && result[f[0]] !== null && result[f[0]] !== '');
%>

<div class="result-page">

    <!-- HEADER BAND -->
    <header class="school-header">

        <div class="header-logo">
            <% if (school.image?.logo) { %>
                <img src="<%= school.image.logo %>" alt="School Logo">
            <% } %>
        </div>

        <div class="header-text">
            <h1><%= school.schoolName %></h1>

            <% if (school.motto) { %>
                <p class="motto"><%= school.motto %></p>
            <% } %>

            <% if (school.address) { %>
                <p class="address"><%= school.address %></p>
            <% } %>

            <p class="contact">
                <% if (school.phone) { %>Tel: <%= school.phone %><% } %>
                <% if (school.phone && schoolEmail) { %> &nbsp;|&nbsp; <% } %>
                <% if (schoolEmail) { %><%= schoolEmail %><% } %>
            </p>
        </div>

        <div class="header-tag">
            <span>REPORT CARD</span>
            <strong><%= safe(result.term) %></strong>
            <small><%= safe(result.section) %></small>
        </div>

    </header>

    <!-- STUDENT PROFILE -->
    <section class="profile">

        <div class="profile-photo">
            <% if (result.passport) { %>
                <img src="<%= result.passport %>" alt="Student Photo">
            <% } %>
        </div>

        <div class="profile-main">
            <span class="eyebrow">STUDENT</span>
            <h2><%= safe(result.fullname) %></h2>

            <div class="profile-grid">
                <div>
                    <span>Student ID</span>
                    <strong><%= safe(result.studentId) %></strong>
                </div>
                <div>
                    <span>Class</span>
                    <strong><%= safe(result.studentClass) %></strong>
                </div>
                <div>
                    <span>Gender</span>
                    <strong><%= safe(result.gender) %></strong>
                </div>
                <div>
                    <span>Session</span>
                    <strong><%= safe(result.section) %></strong>
                </div>
            </div>
        </div>

        <div class="ring-wrap">
            <div class="ring" style="--pct: <%= avg %>">
                <div class="ring-inner">
                    <strong><%= safe(result.average, 0) %>%</strong>
                    <span>AVERAGE</span>
                </div>
            </div>
            <div class="ring-grade"><%= gradeLetter %> &middot; <%= gradeWord %></div>
        </div>

    </section>

    <!-- MAIN: TABLE ON THE LEFT, DETAILS ON THE RIGHT -->
    <div class="main-content">

        <!-- LEFT: TABLE -->
        <section class="academic">

            <h3 class="block-title">Academic Performance</h3>

            <table class="result-table">
                <thead>
                    <tr>
                        <th class="no">#</th>
                        <th class="subject">Subject</th>
                        <th>1st</th>
                        <th>2nd</th>
                        <th>CA</th>
                        <th>Exam</th>
                        <th>Total</th>
                        <th>Grade</th>
                        <th class="remark">Remark</th>
                    </tr>
                </thead>

                <tbody>
                    <% (result.subjects || []).forEach((subject, i) => { %>
                        <tr>
                            <td><%= i + 1 %></td>
                            <td class="subject-name"><%= safe(subject.subjectName) %></td>
                            <td><%= safe(subject.firstTest, 0) %></td>
                            <td><%= safe(subject.secondTest, 0) %></td>
                            <td><%= safe(subject.cca, 0) %></td>
                            <td><%= safe(subject.exam, 0) %></td>
                            <td class="total"><%= safe(subject.total, 0) %></td>
                            <td>
                                <span class="grade grade-<%= String(subject.grade || '').toLowerCase().charAt(0) %>">
                                    <%= safe(subject.grade) %>
                                </span>
                            </td>
                            <td><%= safe(subject.remark) %></td>
                        </tr>
                    <% }) %>

                    <% if (!result.subjects || result.subjects.length === 0) { %>
                        <tr>
                            <td colspan="9" class="empty-table">No subjects available.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>

        </section>

        <!-- RIGHT: SIDEBAR -->
        <aside class="sidebar">

            <!-- SCORE TILES -->
            <section class="tiles">
                <div class="tile">
                    <span>Score Obtained</span>
                    <strong><%= safe(result.score_obtain, 0) %></strong>
                    <small>out of <%= safe(result.score_obtainable, 0) %></small>
                </div>
                <div class="tile">
                    <span>Subjects</span>
                    <strong><%= safe(result.No_subj, (result.subjects || []).length) %></strong>
                    <small>offered</small>
                </div>
            </section>

            <!-- ATTENDANCE -->
            <section class="card">
                <h3 class="card-title">Attendance</h3>
                <div class="attendance-numbers">
                    <div>
                        <strong><%= days %></strong>
                        <span>School days</span>
                    </div>
                    <div>
                        <strong><%= safe(result.present, 0) %></strong>
                        <span>Present</span>
                    </div>
                    <div>
                        <strong><%= safe(result.absent, 0) %></strong>
                        <span>Absent</span>
                    </div>
                </div>
                <div class="bar">
                    <div class="bar-fill" style="width: <%= rate.toFixed(1) %>%"></div>
                </div>
                <div class="bar-label"><%= rate.toFixed(1) %>% attendance</div>
            </section>

            <!-- CONDUCT -->
            <section class="card">
                <h3 class="card-title">Conduct</h3>
                <% if (conduct.length > 0) { %>
                    <div class="conduct-list">
                        <% conduct.forEach(f => { %>
                            <div>
                                <span><%= f[1] %></span>
                                <strong><%= result[f[0]] %></strong>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p class="muted">No conduct record.</p>
                <% } %>
            </section>

            <!-- COMMENTS -->
            <section class="card">
                <h3 class="card-title">Class Teacher's Comment</h3>
                <p class="comment"><%= safe(result.tReport, 'No comment available.') %></p>
            </section>

            <section class="card">
                <h3 class="card-title">Head Teacher's Comment</h3>
                <p class="comment"><%= safe(result.Treport, 'No comment available.') %></p>
            </section>

        </aside>

    </div>

    <!-- PROMOTION STRIP -->
    <section class="strip">
        <div>
            <span>Promoted To</span>
            <strong><%= safe(result.promote) %></strong>
        </div>
        <div>
            <span>Next Term Begins</span>
            <strong><%= safe(nextTerm) %></strong>
        </div>
        <% if (result.fees) { %>
            <div>
                <span>Outstanding Fees</span>
                <strong><%= result.fees %></strong>
            </div>
        <% } %>
    </section>

    <!-- GRADING SCALE -->
    <section class="scale">
        <span class="scale-title">GRADING SCALE</span>
        <div class="scale-items">
            <div><strong>A</strong> 80 - 100 <em>Excellent</em></div>
            <div><strong>B</strong> 70 - 79 <em>Very Good</em></div>
            <div><strong>C</strong> 60 - 69 <em>Good</em></div>
            <div><strong>D</strong> 50 - 59 <em>Fair</em></div>
            <div><strong>E</strong> 40 - 49 <em>Pass</em></div>
            <div><strong>F</strong> 0 - 39 <em>Fail</em></div>
        </div>
    </section>

    <!-- SIGNATURES -->
    <section class="signatures">
        <div class="signature">
            <div class="signature-space"></div>
            <div class="signature-line"></div>
            <strong>Class Teacher</strong>
        </div>
        <div class="signature">
            <div class="signature-space"></div>
            <div class="signature-line"></div>
            <strong>Head Teacher</strong>
        </div>
        <div class="signature">
            <div class="signature-space"></div>
            <div class="signature-line"></div>
            <strong>Parent / Guardian</strong>
        </div>
    </section>

</div>

<% }) %>

<!-- Scale the A4 sheet down on small screens (same layout as laptop) -->
<script>
  (function () {
    var PAGE_WIDTH = 794; // A4 width (210mm) in CSS px

    function fit() {
      var available = document.documentElement.clientWidth - 16;
      var scale = available < PAGE_WIDTH ? available / PAGE_WIDTH : 1;
      document.querySelectorAll('.result-page').forEach(function (page) {
        page.style.zoom = scale === 1 ? '' : scale;
      });
    }

    fit();
    window.addEventListener('resize', fit);
    window.addEventListener('orientationchange', fit);
    window.addEventListener('beforeprint', function () {
      document.querySelectorAll('.result-page').forEach(function (p) { p.style.zoom = ''; });
    });
    window.addEventListener('afterprint', fit);
  })();
</script>

</body>
</html>