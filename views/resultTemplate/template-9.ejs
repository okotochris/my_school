                            <th class="th1">1st test 10%</th>
                            <th class="th1">2nd test 10%</th>
                            <th class="th1">project 10%</th>
                            <th class="th1">Exam 70%</th>
                            <th class="th1">Total 100%</th>
                            <th class="th1" width="30">Grades</th>
                            <th width="65">REMARKS</th>
                        </tr>
						<% if(result.subjects.length > 0){ %>
                            <% result.subjects.forEach(subject=>{ %>
                                <tr>
                                    <td><%= subject.subjectName.toUpperCase() %></td>
                                    <td><%= subject.firstTest %></td>
                                    <td><%= subject.secondTest %></td>
                                    <td><%= subject.cca %></td>
                                    <td><%= subject.exam %></td>
                                    <td><%= subject.total %></td>
                                    <td><%= subject.grade %></td>
                                    <td><%= subject.remark %></td>
                                </tr>
                            <%}) %>
                        <%}%>
						
						
