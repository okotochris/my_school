								<li>70% - 79% = A = Very Good</li>
								<li>60% - 69% = B = Credit</li>
								<li>50% - 59% = C = Merit</li>
								<li>40% - 49% = D = Pass</li>
								<li>0%  - 39% = F = Fail</li>
