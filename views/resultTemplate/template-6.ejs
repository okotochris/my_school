
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= school.fullname %> - Result</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/styles/results/template-6.css">
</head>

<body>
<div class="no-print flex justify-center gap-2 p-4 print:hidden">

    <a
        href="/result/<%= result._id %>/pdf"
        class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700"
    >
        Download PDF
    </a>

    <a
        href="/result/<%= result._id %>/image"
        class="rounded-lg bg-teal-600 px-4 py-2 text-sm font-semibold text-white hover:bg-teal-700"
    >
        Download Image
    </a>

    <button
        onclick="window.print()"
        class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
    >
        Print
    </button>

</div>
<div class="report-sheet">

    <!-- =====================================================
         SCHOOL HEADER
    ====================================================== -->

    <header class="school-header">

        <div class="header-top">

            <div class="school-logo">
                <img
                   src="<%= school.image.logo %>"
                    alt="School Logo"
                >
            </div>

            <div class="school-info">

                <h1><%= school.schoolName %></h1>

                <p class="motto">
                    <%= school.motto %>
                </p>

                <p>
                    <%= school.address %>
                </p>

                <p>
                    Tel: <%= school.phone %> • Email: <%= school.email %>
                </p>

            </div>

        </div>


        <div class="report-title">

            <span>ACADEMIC REPORT</span>

            <h2>STUDENT'S REPORT SHEET</h2>

            <p>
                <%= result.term %> • <%= result.section %> ACADEMIC SESSION
            </p>

        </div>

    </header>


    <!-- =====================================================
         STUDENT INFORMATION
    ====================================================== -->

    <section class="student-section">

        <div class="student-photo">

            <img
               src="<%= student.passport %>"
                alt="Student Photo"
            >

        </div>


        <div class="student-information">

            <div class="info-row">

                <div class="info-item large">

                    <span>STUDENT NAME</span>

                    <strong>
                        <%= student.fullname %> 
                    </strong>

                </div>

                <div class="info-item">

                    <span>STUDENT ID</span>

                    <strong>
                        <%= student.studentId %>
                    </strong>

                </div>

            </div>


            <div class="info-row">

                <div class="info-item">

                    <span>CLASS</span>

                    <strong><%= result.studentClass %></strong>

                </div>

                <div class="info-item">

                    <span>ARM</span>

                    <strong>
                       
                    </strong>

                </div>

                <div class="info-item">

                    <span>GENDER</span>

                    <strong>
                        <%= student.gender %>
                    </strong>

                </div>

                <div class="info-item">

                    <span>HOUSE</span>

                    <strong>
                        <%= student.house %>
                    </strong>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         RESULT TABLE
    ====================================================== -->

    <section class="result-section">

        <div class="section-title">

            <span>01</span>

            <div>
                <small>ACADEMIC PERFORMANCE</small>
                <h3>SUBJECT RESULTS</h3>
            </div>

        </div>


        <table class="result-table">

            <thead>

                <tr>

                    <th class="sn">S/N</th>

                    <th class="subject">
                        SUBJECT
                    </th>

                    <th>1st TEST</th>

                    <th>2ND TEST</th>
                    <th>CA</th>

                    <th>EXAM</th>

                    <th>TOTAL</th>

                    <th>GRADE</th>

                    <th>REMARK</th>

                </tr>

            </thead>


            <tbody>
                 <% result.subjects.forEach((subject, i)=>{  %>
                    <tr>

                    <td><%= i + 1 %></td>

                    <td class="subject-name">
                        <%= subject.subjectName %>
                    </td>
                    <td> <%= subject.firstTest %></td>
                    <td> <%= subject.secondTest %></td>
                    <td> <%= subject.cca %></td>
                    <td> <%= subject.exam %></td>

                    <td class="total-score"> <%= subject.total %></td>

                    <td>
                        <span class="grade grade-a"> <%= subject.grade %></span>
                    </td>

                    <td> <%= subject.remark %></td>

                </tr>
                <% }) %>

            </tbody>

        </table>

    </section>


    <!-- =====================================================
         ACADEMIC SUMMARY
    ====================================================== -->

    <section class="summary-section">

        <div class="summary-box">

            <span>TOTAL SCORE</span>
                 <strong> <%= result.score_obtain %></strong>

            <small>OUT OF <%= result.score_obtainable %></small>

        </div>


        <div class="summary-box">

            <span>AVERAGE</span>

              <% if (result.average >= 80) { %>
                    <strong>A</strong>
                    <small>EXCELLENT</small>
                <% } else if (result.average >= 70) { %>
                    <strong>B</strong>
                    <small>VERY GOOD</small>
                <% } else if (result.average >= 60) { %>
                    <strong>C</strong>
                    <small>GOOD</small>
                <% } else if (result.average >= 50) { %>
                    <strong>D</strong>
                    <small>FAIR</small>
                <% } else if (result.average >= 40) { %>
                    <strong>E</strong>
                    <small>PASS</small>
                <% } else { %>
                    <strong>F</strong>
                    <small>FAILED</small>
                <% } %>


        </div>


        <div class="summary-box">
            <span>SUBJECTS</span>
            <strong><%= result.No_subj %></strong>
        </div>


        <div class="summary-box">

            <span>OVERALL GRADE</span>

             <% if (result.average >= 80) { %>
                    <strong>A</strong>
                    <small>EXCELLENT</small>
                <% } else if (result.average >= 70) { %>
                    <strong>B</strong>
                    <small>VERY GOOD</small>
                <% } else if (result.average >= 60) { %>
                    <strong>C</strong>
                    <small>GOOD</small>
                <% } else if (result.average >= 50) { %>
                    <strong>D</strong>
                    <small>FAIR</small>
                <% } else if (result.average >= 40) { %>
                    <strong>E</strong>
                    <small>PASS</small>
                <% } else { %>
                    <strong>F</strong>
                    <small>FAILED</small>
                <% } %>


        </div>

    </section>


    <!-- =====================================================
         ATTENDANCE & CONDUCT
    ====================================================== -->

    <section class="two-column">

        <div class="panel">

            <div class="panel-heading">
                ATTENDANCE RECORD
            </div>

            <div class="attendance-content">

                <div>
                    <span>School Days</span>
                    <strong><%= result.present + result.absent %></strong>
                </div>

                <div>
                    <span>Present</span>
                    <strong><%=result.present %></strong>
                </div>

                <div>
                    <span>Absent</span>
                    <strong><%= result.absent %></strong>
                </div>

                <div>
                    <span>Rate</span>
                    <strong><%= (result.present + result.absent) > 0
                            ? ((result.present / (result.present + result.absent)) * 100).toFixed(1)
                            : 0
                        %>% </strong>
                </div>

            </div>

        </div>


        <div class="panel">

            <div class="panel-heading">
                GENERAL CONDUCT
            </div>

            <div class="conduct-list">

                <div>
                    <span>Attitude to Learning</span>
                   <strong><%= student.attitude %></strong>
                </div>

                <div>
                    <span>Neatness</span>
                 <strong><%= student.neatness %></strong>
                </div>

                <div>
                    <span>Punctuality</span>
                    <strong><%= student.punctuality %></strong>
                </div>

                <div>
                    <span>Responsibility</span>

                <strong><%= student.responsibility %></strong>
                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         COMMENTS
    ====================================================== -->

    <section class="comments-section">

        <div class="comment-box">

            <div class="panel-heading">
                CLASS TEACHER'S COMMENT
            </div>

            <p>
              <%= result.tReport %>
            </p>

        </div>


        <div class="comment-box">

            <div class="panel-heading">
                PRINCIPAL'S COMMENT
            </div>

            <p>
              <%= result.Treport %>
            </p>

        </div>

    </section>


    <!-- =====================================================
         GRADING SCALE
    ====================================================== -->

    <section class="grading-section">

        <div class="grading-heading">
            GRADING SCALE
        </div>


        <div class="grading-table">

            <div>
                <strong>A</strong>
                <span>80 - 100</span>
                <small>Excellent</small>
            </div>

            <div>
                <strong>B</strong>
                <span>70 - 79</span>
                <small>Very Good</small>
            </div>

            <div>
                <strong>C</strong>
                <span>60 - 69</span>
                <small>Good</small>
            </div>

            <div>
                <strong>D</strong>
                <span>50 - 59</span>
                <small>Fair</small>
            </div>

            <div>
                <strong>E</strong>
                <span>40 - 49</span>
                <small>Pass</small>
            </div>

            <div>
                <strong>F</strong>
                <span>0 - 39</span>
                <small>Fail</small>
            </div>

        </div>

    </section>


    <!-- =====================================================
         SIGNATURES
    ====================================================== -->

    <section class="signature-section">

        <div class="signature">

            <div class="signature-space"></div>

            <div class="signature-line"></div>

            <strong>Class Teacher</strong>

            <span>Date</span>

        </div>


        <div class="signature">

            <div class="signature-space"></div>

            <div class="signature-line"></div>

            <strong>Principal</strong>

            <span><%= new Date(result.createdAt).toLocaleDateString('en-GB') %></span>

        </div>


        <div class="signature">

            <div class="signature-space"></div>

            <div class="signature-line"></div>

            <strong>Parent / Guardian</strong>

            <span><%= new Date(result.createdAt).toLocaleDateString('en-GB') %></span>

        </div>

    </section>


    <!-- =====================================================
         FOOTER
    ====================================================== -->

    <footer class="report-footer">

        <span>
            ROYAL HEIGHTS COLLEGE
        </span>

        <span>
            Official Academic Report • 2025 / 2026
        </span>

        <span>
            Powered by MySchoolResult
        </span>

    </footer>


</div>

</body>
</html>

