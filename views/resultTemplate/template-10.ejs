<!DOCTYPE html>
<html lang="en">

<head>
  <link rel="stylesheet" type="text/css" href="styles/download_button.css"/>
  <link rel="stylesheet" href="/styles/results/template-10.css">
   <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
  <!-- details.ejs -->
<div class="no-print flex justify-center gap-2 p-4 print:hidden">

    <a
        href="/result/<%= result._id %>/pdf"
        class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700"
    >
        Download PDF
    </a>

    <a
        href="/result/<%= result._id %>/image"
        class="rounded-lg bg-teal-600 px-4 py-2 text-sm font-semibold text-white hover:bg-teal-700"
    >
        Download Image
    </a>

    <button
        onclick="window.print()"
        class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
    >
        Print
    </button>

</div>

  
  <div class="t_container" id="resultContainer">
      <div class="style">
        
        <div class="school_details">
          
            <img class="logo" src="<%=school.image.logo %>" />
         
          <div>
            <h1>
             <%= school.schoolName?.toUpperCase() %>
            </h1>
            <p>
              <%= school.address %>
              <p><%= school.phone %></p>
            </p>
            
          </div>
          <div class="avatar">
            <p>ID: <%= student.studentId %></p>
          </div>
        </div>
        
        <div class="reportSheet">
          <div>
            <h3>BASIC SCHOOL STUDENT'S ACADEMIC REPORT/SHEET</h3>
          </div>
        </div>

        <br />
        <div class="top_info">
            <p>Name: <b><%= student.fullname %></b> </p>
            <p>Class:<b><%= result.studentClass%></b> </p>
            <p>Term: <b><%= result.term %></b></p>
   
        </div>
        <div class="table_design">
          <div class="table">
            <table>
              <tr>
                <th style="width:200px;">Subject</th>
                <th>1st Test [15%]</th>
                <th>2nd Test [15%]</th>
                <th>CA </th>
                <th>Exam [70%]</th>
                <th>Total [100%]</th>
                <th>Grade</th>
              </tr>
              <% if(result.subjects.length > 0){ %>
                            <% result.subjects.forEach(subject=>{ %>
                                <tr>
                                    <td><%= subject.subjectName.toUpperCase() %></td>
                                    <td><%= subject.firstTest %></td>
                                    <td><%= subject.secondTest %></td>
                                    <td><%= subject.cca %></td>
                                    <td><%= subject.exam %></td>
                                    <td><%= subject.total %></td>
                                    <td><%= subject.grade %></td>
                                </tr>
                            <%}) %>
                        <%}%>
             
            </table>
          </div>
          <div class="class_info">
            <div>
              <table style="font-size:12px; margin:0px;">
                <tr>
                  <th>
                    <h3>Skill & Behavior</h3>
                  </th>
                  <th>5</th>
                  <th>4</th>
                  <th>3</th>
                  <th>2</th>
                  <th>1</th>
                </tr>
                <tr>
                  <td>1. Attendance</td>
                  <td>&#10003;</td>
                  <td></td>
                  <td></td>
                  <td></td>
                  <td></td>
                </tr>
                <tr>
                  <td>2. Attentiveness</td>
                  <td>&#10003;</td>
                  <td></td>
                  <td></td>
                  <td></td>
                  <td></td>
                </tr>
                <tr>
                  <td>3. Honesty</td>
                  <td>&#10003;</td>
                  <td></td>
                  <td></td>
                  <td></td>
                  <td></td>
                </tr>
                <tr>
                  <td>4. Initiative</td>
                  <td>&#10003;</td>
                  <td></td>
                  <td></td>
                  <td></td>
                  <td></td>
                </tr>
                <tr>
                  <td>5. Neatness</td>
                  <td>&#10003;</td>
                  <td></td>
                  <td></td>
                  <td></td>
                  <td></td>
                </tr>
                <tr>
                  <td>6. Organization ability</td>
                  <td></td>
                  <td>&#10003;</td>
                  <td></td>
                  <td></td>
                  <tb></tb>
                  <td></td>
                </tr>
                <tr>
                  <td>7. Perseverance</td>
                  <td>&#10003;</td>
                  <td></td>
                  <td></td>
                  <td></td>
                  <td></td>
                </tr>
                <tr>
                  <td>8. Punctuality </td>
                  <td>&#10003;</td>
                  <td></td>
                  <td></td>
                  <td></td>
                  <td></td>
                </tr>
                <tr>
                  <td>9. Spirit of Cooperation</td>
                  <td>&#10003;</td>
                  <td></td>
                  <td></td>
                  <td></td>
                  <td></td>
                </tr>
                <tr>
                  <td>10. Self control</td>
                  <td>&#10003;</td>
                  <td></td>
                  <td></td>
                  <td></td>
                  <td></td>
                </tr>
              </table>
            </div>
            <div>
              <h4>KEYS TO SKILL & BEHAVIOR </h4>
              <P> 5....Excellent degree of observation </P>
              <P> 4....High level fo observation </P>
              <P> 3....Acceptable level of observation </P>
              <P> 2....Minimal level Observed </P>
              <P> 1....No level observed </P>
            </div>
            <div class="grade">
              <P> 80 - 100--A+ Distinction </P>
              <P> 70 - 79---A Excellent </P>
              <P> 60 - 69---B Very Good </P>
              <P> 50 - 59---C Credit </P>
              <p> 40 - 49---D Pass</p>
              
              <P> 0 -  39----F Fail</P>
            </div>
            
          </div>
        </div>

        <h3>STUDENT PERFORMANCE ANALYSIS</h3>
        <div class="score_container">
          <div class="student_score">
            <div><h5>SUBJECT OFFERED</h5><h4><%= result.No_subj %></h4></div>
            <div><h5>SCORE OBTAINABLE</h5><h4></h4><%= result.score_obtainable %></div>
            <div><h5>SCORE OBTAIN</h5><h4><%= result.score_obtain %></h4></div>
            <div><h5>AVERAGE SCORE</h5><h4><%= result.average %></h4></div>
          </div>

        </div>
        
        <div class="extraInfo">
          <div>
            <p>Time Present: <b><%= result.present %></b></p>
            <p>Time Absent: <b> <%= result.absent %></b></p>
            <P>Class Teacher's Report </p><p><b> <%= result.tReport %></b></P>
              <P>Promoted to <b><%=result.promote %></b></P>
          </div>
         
          <div>
            <p>Head Teacher Remark :<b><%= result.Treport %></b></p>
            <p>Next Term Begin: <b><%= result.nextterm %></b></p>
            <p>Head Teacher Sign</p>
          </div>
        </div>
      </div>
    </div>
  </div>
        <!-- Your content here -->
</div>


  <div class="button"><button class="download" onclick="downloadResult()">Download Result</button></div>
  <div class="button"><button class="download" onclick="downloadResultAsJPG()">Download JPEG</button></div>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/dom-to-image/2.6.0/dom-to-image.min.js"></script>
  <!-- Your custom JavaScript code -->
  <script src="download.js"></script>
  <script src="Java Script/dwonloadJPEG.js"></script>
</body>

</html>