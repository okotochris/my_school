<%
  const resultList = Array.isArray(results)
    ? results
    : (results ? [results] : []);
  const isBulk = resultList.length > 1;
  const firstResult = resultList[0];

  const session = firstResult?.section || '';
  const term = firstResult?.term || '';
  const schoolName = firstResult?.schoolName || '';

  const params = new URLSearchParams({
    session,
    term,
    schoolName,
    sclass: sclass 
  }).toString();

  const pdfUrl = `/results/pdf?${params}`;
  const imageUrl = `/results/image?${params}`;

  const safe = (value, fallback = '—') =>
    value !== undefined && value !== null && value !== ''
      ? value
      : fallback;

  // Skill & behaviour rows: [label, rating ticked (1-5)]
  const skills = [
    ['Attendance', 5],
    ['Attentiveness', 5],
    ['Honesty', 5],
    ['Initiative', 5],
    ['Neatness', 5],
    ['Organization ability', 4],
    ['Perseverance', 5],
    ['Punctuality', 5],
    ['Spirit of Cooperation', 5],
    ['Self control', 5]
  ];
%>
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Result - <%= school.schoolName %></title>
  <link rel="stylesheet" href="/styles/results/template-10.css">
</head>

<body>

  <!-- DOWNLOAD CONTROLS -->
  <% if (resultList.length > 0) { %>
    <div class="no-print download-toolbar">
      <div class="download-info">
        <strong><%= isBulk ? 'Class Results' : 'Student Result' %></strong>
        <span>
          <%= isBulk ? `${resultList.length} student results` : safe(firstResult.fullname) %>
        </span>
      </div>

      <div class="download-actions">
        <a href="<%= pdfUrl %>" class="download-btn pdf-btn">
          <span>↓</span> Download PDF
        </a>

        <% if (!isBulk) { %>
          <a href="<%= imageUrl %>" class="download-btn image-btn">
            <span>↓</span> Download Image
          </a>
        <% } %>

        <button onclick="window.print()" class="download-btn print-btn">
          Print Result
        </button>
      </div>
    </div>
  <% } %>

  <% if (resultList.length === 0) { %>
    <div class="empty-state">
      <h2>No result available</h2>
      <p>There are no results to display.</p>
    </div>
  <% } %>

<% resultList.forEach((result) => { %>

  <div class="t_container" id="resultContainer">
    <div class="style">

      <!-- SCHOOL HEADER -->
      <div class="school_details">

        <div class="logo-box">
          <% if (school.image?.logo) { %>
            <img class="logo" src="<%= school.image.logo %>" alt="School Logo" />
          <% } %>
        </div>

        <div class="school_text">
          <h1><%= safe(school.schoolName, '').toUpperCase() %></h1>

          <% if (school.motto) { %>
            <p class="motto"><%= school.motto %></p>
          <% } %>

          <% if (school.address) { %>
            <p class="address"><%= school.address %></p>
          <% } %>

          <% if (school.phone) { %>
            <p class="phone">Tel: <%= school.phone %></p>
          <% } %>
        </div>

        <div class="avatar">
          <% if (result.passport) { %>
            <img src="<%= result.passport %>" alt="Student Photo" />
          <% } %>
          <p>ID: <%= safe(result.studentId) %></p>
        </div>

      </div>

      <!-- REPORT TITLE -->
      <div class="reportSheet">
        <div>
          <h3>BASIC SCHOOL STUDENT'S ACADEMIC REPORT SHEET</h3>
        </div>
      </div>

      <!-- STUDENT INFO -->
      <div class="top_info">
        <p>Name: <b><%= safe(result.fullname) %></b></p>
        <p>Class: <b><%= safe(result.studentClass) %></b></p>
        <p>Term: <b><%= safe(result.term) %></b></p>
      </div>

      <!-- TABLE (LEFT) + SKILLS (RIGHT) -->
      <div class="table_design">

        <div class="table">
          <table class="result-table">
            <thead>
              <tr>
                <th class="subject-col">Subject</th>
                <th>1st Test</th>
                <th>2nd Test</th>
                <th>CA</th>
                <th>Exam</th>
                <th>Total</th>
                <th>Grade</th>
              </tr>
            </thead>
            <tbody>
              <% (result.subjects || []).forEach(subject => { %>
                <tr>
                  <td class="subject-name"><%= safe(subject.subjectName, '').toUpperCase() %></td>
                  <td><%= safe(subject.firstTest, 0) %></td>
                  <td><%= safe(subject.secondTest, 0) %></td>
                  <td><%= safe(subject.cca, 0) %></td>
                  <td><%= safe(subject.exam, 0) %></td>
                  <td class="total-score"><%= safe(subject.total, 0) %></td>
                  <td>
                    <span class="grade-pill grade-<%= String(subject.grade || '').toLowerCase().charAt(0) %>">
                      <%= safe(subject.grade) %>
                    </span>
                  </td>
                </tr>
              <% }) %>

              <% if (!result.subjects || result.subjects.length === 0) { %>
                <tr>
                  <td colspan="7" class="empty-table">No subjects available.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <div class="class_info">

          <div class="info-block">
            <table class="skills-table">
              <thead>
                <tr>
                  <th class="skill-title">Skill &amp; Behavior</th>
                  <th>5</th>
                  <th>4</th>
                  <th>3</th>
                  <th>2</th>
                  <th>1</th>
                </tr>
              </thead>
              <tbody>
                <% skills.forEach((skill, i) => { %>
                  <tr>
                    <td class="skill-name"><%= i + 1 %>. <%= skill[0] %></td>
                    <% for (let r = 5; r >= 1; r--) { %>
                      <td><%- skill[1] === r ? '&#10003;' : '' %></td>
                    <% } %>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <div class="info-block keys">
            <h4>KEYS TO SKILL &amp; BEHAVIOR</h4>
            <p><b>5</b> Excellent degree of observation</p>
            <p><b>4</b> High level of observation</p>
            <p><b>3</b> Acceptable level of observation</p>
            <p><b>2</b> Minimal level observed</p>
            <p><b>1</b> No level observed</p>
          </div>

          <div class="info-block grade-scale">
            <h4>GRADING SCALE</h4>
            <p><b>80 - 100</b> A+ Distinction</p>
            <p><b>70 - 79</b> A Excellent</p>
            <p><b>60 - 69</b> B Very Good</p>
            <p><b>50 - 59</b> C Credit</p>
            <p><b>40 - 49</b> D Pass</p>
            <p><b>0 - 39</b> F Fail</p>
          </div>

        </div>

      </div>

      <!-- PERFORMANCE ANALYSIS -->
      <h3 class="section-title">STUDENT PERFORMANCE ANALYSIS</h3>
      <div class="score_container">
        <div class="student_score">
          <div><h5>SUBJECTS OFFERED</h5><h4><%= safe(result.No_subj, (result.subjects || []).length) %></h4></div>
          <div><h5>SCORE OBTAINABLE</h5><h4><%= safe(result.score_obtainable, 0) %></h4></div>
          <div><h5>SCORE OBTAINED</h5><h4><%= safe(result.score_obtain, 0) %></h4></div>
          <div><h5>AVERAGE SCORE</h5><h4><%= safe(result.average, 0) %></h4></div>
        </div>
      </div>

      <!-- EXTRA INFO -->
      <div class="extraInfo">

        <div class="extra-row two">
          <p>Times Present: <b><%= safe(result.present, 0) %></b></p>
          <p>Times Absent: <b><%= safe(result.absent, 0) %></b></p>
          <p>Promoted to: <b><%= safe(result.promote) %></b></p>
          <p>Next Term Begins: <b><%= safe(result.nextterm) %></b></p>
        </div>

        <div class="extra-row">
          <div class="remark-box">
            <h6>CLASS TEACHER'S REPORT</h6>
            <p><%= safe(result.tReport, 'No comment available.') %></p>
          </div>
          <div class="remark-box">
            <h6>HEAD TEACHER'S REMARK</h6>
            <p><%= safe(result.Treport, 'No comment available.') %></p>
          </div>
        </div>

        <div class="sign-row">
          <div class="sign-box">
            <div class="sign-line"></div>
            <span>Class Teacher's Sign</span>
          </div>
          <div class="sign-box">
            <div class="sign-line"></div>
            <span>Head Teacher's Sign</span>
          </div>
        </div>

      </div>

    </div>
  </div>

<% }) %>

<!-- Scale the A4 sheet down on small screens (same layout as laptop) -->
<script>
  (function () {
    var PAGE_WIDTH = 794; // A4 width (210mm) in CSS px

    function fit() {
      var available = document.documentElement.clientWidth - 16;
      var scale = available < PAGE_WIDTH ? available / PAGE_WIDTH : 1;
      document.querySelectorAll('.t_container').forEach(function (page) {
        page.style.zoom = scale === 1 ? '' : scale;
      });
    }

    fit();
    window.addEventListener('resize', fit);
    window.addEventListener('orientationchange', fit);
    window.addEventListener('beforeprint', function () {
      document.querySelectorAll('.t_container').forEach(function (p) { p.style.zoom = ''; });
    });
    window.addEventListener('afterprint', fit);
  })();
</script>

</body>
</html>