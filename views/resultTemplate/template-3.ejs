<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Academic Report - Greenfield International School</title>

    <link rel="stylesheet" href="/styles/results/template-3.css">

    <style>
        :root {
            --primary: #14532d;
            --secondary: #16a34a;
            --accent: #d4af37;
            --light: #f5f8f5;
            --border: #d8e2da;
            --text: #243027;
            --muted: #6b7280;
        }
    </style>
</head>


<body>

<div class="result-sheet">


    <!-- =====================================================
         SCHOOL HEADER
    ====================================================== -->

    <header class="school-header">

        <div class="header-top">

            <div class="logo">
                <img
                    src="/images/school-logo.png"
                    alt="School Logo"
                >
            </div>


            <div class="school-information">

                <div class="school-name">
                    GREENFIELD INTERNATIONAL SCHOOL
                </div>

                <div class="school-motto">
                    Excellence • Discipline • Integrity
                </div>

                <div class="school-address">
                    45 Airport Road, Benin City, Edo State, Nigeria
                </div>

                <div class="school-contact">
                    Tel: 0806 456 7890 &nbsp; | &nbsp;
                    info@greenfieldschool.edu.ng
                </div>

            </div>

        </div>


        <div class="header-line"></div>


        <div class="report-information">

            <div>
                <span>ACADEMIC SESSION</span>
                <strong>2025 / 2026</strong>
            </div>

            <div>
                <span>TERM</span>
                <strong>FIRST TERM</strong>
            </div>

            <div>
                <span>REPORT TYPE</span>
                <strong>CONTINUOUS ASSESSMENT</strong>
            </div>

        </div>

    </header>


    <!-- =====================================================
         REPORT TITLE
    ====================================================== -->

    <section class="report-heading">

        <div class="heading-line"></div>

        <h1>STUDENT ACADEMIC REPORT</h1>

        <p>
            FIRST TERM REPORT SHEET
        </p>

        <div class="heading-line"></div>

    </section>


    <!-- =====================================================
         STUDENT INFORMATION
    ====================================================== -->

    <section class="student-information">

        <div class="photo-box">

            <img
                src="/images/student.jpg"
                alt="Student Photo"
            >

        </div>


        <div class="student-details">

            <div class="student-full-name">
                JOHN MICHAEL DOE
            </div>


            <div class="details-row">

                <div>
                    <span>STUDENT ID</span>
                    <strong>GIS/2025/0184</strong>
                </div>

                <div>
                    <span>CLASS</span>
                    <strong>SS 2 SCIENCE</strong>
                </div>

                <div>
                    <span>GENDER</span>
                    <strong>MALE</strong>
                </div>

            </div>


            <div class="details-row">

                <div>
                    <span>DATE OF BIRTH</span>
                    <strong>14 MAY 2010</strong>
                </div>

                <div>
                    <span>HOUSE</span>
                    <strong>UNITY HOUSE</strong>
                </div>

                <div>
                    <span>TERM ENDS</span>
                    <strong>18 DECEMBER 2025</strong>
                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         RESULT TABLE
    ====================================================== -->

    <section class="academic-record">

        <div class="section-title">

            <span>01</span>

            <h2>ACADEMIC PERFORMANCE</h2>

        </div>


        <table class="academic-table">

            <thead>

                <tr>

                    <th>NO.</th>

                    <th class="subject">
                        SUBJECT
                    </th>

                    <th>CA 1<br><small>20</small></th>

                    <th>CA 2<br><small>20</small></th>

                    <th>EXAM<br><small>60</small></th>

                    <th>TOTAL<br><small>100</small></th>

                    <th>GRADE</th>

                    <th>REMARK</th>

                </tr>

            </thead>


            <tbody>

                <tr>

                    <td>01</td>

                    <td class="subject">
                        Mathematics
                    </td>

                    <td>18</td>
                    <td>17</td>
                    <td>55</td>

                    <td class="total">
                        90
                    </td>

                    <td>
                        <strong class="grade-a">A</strong>
                    </td>

                    <td>Excellent</td>

                </tr>


                <tr>

                    <td>02</td>

                    <td class="subject">
                        English Language
                    </td>

                    <td>17</td>
                    <td>16</td>
                    <td>51</td>

                    <td class="total">
                        84
                    </td>

                    <td>
                        <strong class="grade-a">A</strong>
                    </td>

                    <td>Excellent</td>

                </tr>


                <tr>

                    <td>03</td>

                    <td class="subject">
                        Physics
                    </td>

                    <td>16</td>
                    <td>15</td>
                    <td>48</td>

                    <td class="total">
                        79
                    </td>

                    <td>
                        <strong class="grade-b">B</strong>
                    </td>

                    <td>Very Good</td>

                </tr>


                <tr>

                    <td>04</td>

                    <td class="subject">
                        Chemistry
                    </td>

                    <td>15</td>
                    <td>16</td>
                    <td>46</td>

                    <td class="total">
                        77
                    </td>

                    <td>
                        <strong class="grade-b">B</strong>
                    </td>

                    <td>Very Good</td>

                </tr>


                <tr>

                    <td>05</td>

                    <td class="subject">
                        Biology
                    </td>

                    <td>17</td>
                    <td>14</td>
                    <td>44</td>

                    <td class="total">
                        75
                    </td>

                    <td>
                        <strong class="grade-b">B</strong>
                    </td>

                    <td>Very Good</td>

                </tr>


                <tr>

                    <td>06</td>

                    <td class="subject">
                        Economics
                    </td>

                    <td>14</td>
                    <td>15</td>
                    <td>42</td>

                    <td class="total">
                        71
                    </td>

                    <td>
                        <strong class="grade-b">B</strong>
                    </td>

                    <td>Good</td>

                </tr>


                <tr>

                    <td>07</td>

                    <td class="subject">
                        Government
                    </td>

                    <td>13</td>
                    <td>14</td>
                    <td>41</td>

                    <td class="total">
                        68
                    </td>

                    <td>
                        <strong class="grade-c">C</strong>
                    </td>

                    <td>Good</td>

                </tr>


                <tr>

                    <td>08</td>

                    <td class="subject">
                        Computer Science
                    </td>

                    <td>19</td>
                    <td>18</td>
                    <td>56</td>

                    <td class="total">
                        93
                    </td>

                    <td>
                        <strong class="grade-a">A</strong>
                    </td>

                    <td>Excellent</td>

                </tr>


                <tr>

                    <td>09</td>

                    <td class="subject">
                        Civic Education
                    </td>

                    <td>16</td>
                    <td>15</td>
                    <td>43</td>

                    <td class="total">
                        74
                    </td>

                    <td>
                        <strong class="grade-b">B</strong>
                    </td>

                    <td>Very Good</td>

                </tr>


                <tr>

                    <td>10</td>

                    <td class="subject">
                        Data Processing
                    </td>

                    <td>18</td>
                    <td>17</td>
                    <td>50</td>

                    <td class="total">
                        85
                    </td>

                    <td>
                        <strong class="grade-a">A</strong>
                    </td>

                    <td>Excellent</td>

                </tr>

            </tbody>

        </table>

    </section>


    <!-- =====================================================
         PERFORMANCE SUMMARY
    ====================================================== -->

    <section class="performance-summary">

        <div class="summary-heading">
            PERFORMANCE SUMMARY
        </div>


        <div class="summary-content">

            <div class="summary-item">

                <span>TOTAL MARKS</span>

                <strong>796</strong>

                <small>OUT OF 1000</small>

            </div>


            <div class="summary-item">

                <span>AVERAGE SCORE</span>

                <strong>79.6%</strong>

                <small>VERY GOOD</small>

            </div>


            <div class="summary-item">

                <span>SUBJECTS PASSED</span>

                <strong>10 / 10</strong>

                <small>100% PASS RATE</small>

            </div>


            <div class="summary-item">

                <span>OVERALL GRADE</span>

                <strong>B</strong>

                <small>VERY GOOD</small>

            </div>

        </div>

    </section>


    <!-- =====================================================
         ATTENDANCE
    ====================================================== -->

    <section class="attendance-section">

        <div class="section-title">

            <span>02</span>

            <h2>ATTENDANCE RECORD</h2>

        </div>


        <div class="attendance-content">

            <div class="attendance-stat">

                <span>TOTAL SCHOOL DAYS</span>

                <strong>65</strong>

            </div>


            <div class="attendance-stat">

                <span>DAYS PRESENT</span>

                <strong>61</strong>

            </div>


            <div class="attendance-stat">

                <span>DAYS ABSENT</span>

                <strong>4</strong>

            </div>


            <div class="attendance-stat">

                <span>ATTENDANCE RATE</span>

                <strong>93.8%</strong>

            </div>

        </div>

    </section>


    <!-- =====================================================
         AFFECTIVE / CONDUCT
    ====================================================== -->

    <section class="conduct-section">

        <div class="section-title">

            <span>03</span>

            <h2>AFFECTIVE DEVELOPMENT</h2>

        </div>


        <table class="conduct-table">

            <thead>

                <tr>
                    <th>AREA</th>
                    <th>RATING</th>
                    <th>AREA</th>
                    <th>RATING</th>
                </tr>

            </thead>


            <tbody>

                <tr>

                    <td>Attitude to Work</td>
                    <td><strong>Excellent</strong></td>

                    <td>Neatness</td>
                    <td><strong>Very Good</strong></td>

                </tr>


                <tr>

                    <td>Punctuality</td>
                    <td><strong>Very Good</strong></td>

                    <td>Self Control</td>
                    <td><strong>Excellent</strong></td>

                </tr>


                <tr>

                    <td>Teamwork</td>
                    <td><strong>Excellent</strong></td>

                    <td>Leadership</td>
                    <td><strong>Good</strong></td>

                </tr>


                <tr>

                    <td>Relationship with Others</td>
                    <td><strong>Excellent</strong></td>

                    <td>Responsibility</td>
                    <td><strong>Very Good</strong></td>

                </tr>

            </tbody>

        </table>

    </section>


    <!-- =====================================================
         COMMENTS
    ====================================================== -->

    <section class="comments-section">

        <div class="comment-box">

            <div class="comment-title">
                CLASS TEACHER'S COMMENT
            </div>

            <p>
                John has shown commendable academic progress this term.
                He is attentive during lessons and participates actively
                in classroom activities. He should continue to develop
                consistency in all his subjects.
            </p>

        </div>


        <div class="comment-box">

            <div class="comment-title">
                HEAD TEACHER'S COMMENT
            </div>

            <p>
                A very impressive term. Continue to demonstrate the
                discipline and commitment required for academic success.
                We expect even greater achievements in the next term.
            </p>

        </div>

    </section>


    <!-- =====================================================
         GRADING SCALE
    ====================================================== -->

    <section class="grading-section">

        <div class="grading-title">
            GRADING SYSTEM
        </div>


        <div class="grading-grid">

            <div>
                <strong>A</strong>
                <span>80 - 100</span>
                <small>Excellent</small>
            </div>

            <div>
                <strong>B</strong>
                <span>70 - 79</span>
                <small>Very Good</small>
            </div>

            <div>
                <strong>C</strong>
                <span>60 - 69</span>
                <small>Good</small>
            </div>

            <div>
                <strong>D</strong>
                <span>50 - 59</span>
                <small>Fair</small>
            </div>

            <div>
                <strong>E</strong>
                <span>40 - 49</span>
                <small>Pass</small>
            </div>

            <div>
                <strong>F</strong>
                <span>0 - 39</span>
                <small>Fail</small>
            </div>

        </div>

    </section>


    <!-- =====================================================
         SIGNATURES
    ====================================================== -->

    <section class="signatures">

        <div class="signature">

            <div class="signature-space"></div>

            <div class="signature-line"></div>

            <strong>Class Teacher</strong>

            <span>18 December 2025</span>

        </div>


        <div class="signature">

            <div class="signature-space"></div>

            <div class="signature-line"></div>

            <strong>Head Teacher / Principal</strong>

            <span>18 December 2025</span>

        </div>


        <div class="signature">

            <div class="signature-space"></div>

            <div class="signature-line"></div>

            <strong>Parent / Guardian</strong>

            <span>________________</span>

        </div>

    </section>


    <!-- =====================================================
         FOOTER
    ====================================================== -->

    <footer class="result-footer">

        <div>
            GREENFIELD INTERNATIONAL SCHOOL
        </div>

        <div>
            Official Academic Report • 2025 / 2026
        </div>

        <div>
            Powered by MySchoolResult
        </div>

    </footer>

<script src="https://cdn.tailwindcss.com"></script>
<div class="flex flex-wrap items-center justify-center gap-3 my-6">

    <a
        href="/result/<%= result.id %>/jpg"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg
               bg-blue-600 text-white text-sm font-medium
               hover:bg-blue-700 transition"
    >
        📷
        Download Image
    </a>

    <a
        href="/result/<%= result.id %>/pdf"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg
               bg-red-600 text-white text-sm font-medium
               hover:bg-red-700 transition"
    >
        📄
        Download PDF
    </a>

    <button
        type="button"
        onclick="window.print()"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg
               bg-gray-800 text-white text-sm font-medium
               hover:bg-gray-900 transition"
    >
        🖨️
        Print Result
    </button>

</div>


</div>

</body>
</html>