<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Academic Report - Greenfield International School</title>

    <link rel="stylesheet" href="/styles/results/template-3.css">

    <style>
        :root {
            --primary: #14532d;
            --secondary: #16a34a;
            --accent: #d4af37;
            --light: #f5f8f5;
            --border: #d8e2da;
            --text: #243027;
            --muted: #6b7280;
        }
    </style>
</head>


<body>

<div class="result-sheet">


    <!-- =====================================================
         SCHOOL HEADER
    ====================================================== -->

    <header class="school-header">

        <div class="header-top">

            <div class="logo">
                <img
                    src="<%= school.image.logo %>"
                    alt="<%= school.schoolName %> Logo"
                >
            </div>


            <div class="school-information">

                <div class="school-name">
                    <%= school.schoolName %>
                </div>

                <div class="school-motto">
                    <%= school.motto || 'Excellence • Discipline • Integrity' %>
                </div>

                <div class="school-address">
                    <%= school.address %>
                </div>

                <div class="school-contact">
                    Tel: <%= school.phone %> &nbsp; | &nbsp;
                    <%= school.schoolEmail %>
                </div>

            </div>

        </div>


        <div class="header-line"></div>
    </header>

    <!-- =====================================================
         STUDENT INFORMATION
    ====================================================== -->

    <section class="student-information">

        <div class="photo-box">

            <img
               src="<%= student.passport %>" alt="Student Photo"
            >

        </div>


        <div class="student-details">

            <div class="student-full-name">
                <%= student.fullname %>
            </div>


            <div class="details-row">

                <div>
                    <span>STUDENT ID</span>
                    <strong><%= student.studentId %></strong>
                </div>

                <div>
                    <span>CLASS</span>
                    <strong><%= student.class %></strong>
                </div>

                <div>
                    <span>GENDER</span>
                    <strong><%= student.gender %></strong>
                </div>

            </div>


            <div class="details-row">

                <div>
                    <span>DATE OF BIRTH</span>
                    <strong><%= student.dob %></strong>
                </div>

                <div>
                    <span>HOUSE</span>
                    <strong><%= student.house %></strong>
                </div>

                <div>
                    <span>TERM</span>
                    <strong><%= result.term %></strong>
                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         RESULT TABLE
    ====================================================== -->

    <section class="academic-record">

        <div class="section-title">

            <span>01</span>

            <h2>ACADEMIC PERFORMANCE</h2>

        </div>


        <table class="academic-table">

            <thead>

                <tr>

                    <th>NO.</th>

                    <th class="subject">
                        SUBJECT
                    </th>

                    <th>1st Test<br>
                        <!-- <small>20</small> -->
                    </th>

                    <th>2nd Test
                        <!-- <br><small>20</small> -->
                    </th>
                    <th>
                        CA
                        <!-- <br><small>40</small> -->
                    </th>
                    <th>EXAM
                        <!-- <br><small>60</small> -->
                    </th>

                    <th>TOTAL<br><small>100</small></th>

                    <th>GRADE</th>

                    <th>REMARK</th>

                </tr>

            </thead>


            <tbody>

               
               <% result.subjects.forEach((subject, index) => { %>
                     <tr>

                    <td><%= index + 1 %></td>

                    <td class="subject">
                        <%= subject.subjectName %>
                    </td>

                    <td><%= subject.firstTest %></td>
                    <td><%= subject.secondTest %></td>
                    <td><%= subject.cca %></td>

                    <td class="total">
                        <%= subject.total %>
                    </td>

                    <td>
                        <strong class="grade-a"><%= subject.grade %></strong>
                    </td>

                    <td><%= subject.remark %></td>

                </tr>
                <% }) %>


            </tbody>

        </table>

    </section>


    <!-- =====================================================
         PERFORMANCE SUMMARY
    ====================================================== -->

    <section class="performance-summary">

        <div class="summary-heading">
           <%= result.Treport %>
        </div>


        <div class="summary-content">

            <div class="summary-item">

                <span>TOTAL MARKS</span>

                <strong><%= result.score_obtain %></strong>

                <small>OUT OF <%= result.score_obtainable %></small>

            </div>


            <div class="summary-item">

                <span>AVERAGE SCORE</span>

                <strong><%= result.average %></strong>

               

            </div>


            <div class="summary-item">

                <span>TOTAL SUBJECTS DONE</span>

                <strong><%= result.No_subj %></strong>
            </div>


            <div class="summary-item">

                <span>OVERALL GRADE</span>

                 <% if (result.average >= 80) { %>

                    <strong>A</strong>
                    <small>EXCELLENT</small>

                <% } else if (result.average >= 70) { %>

                    <strong>B</strong>
                    <small>VERY GOOD</small>

                <% } else if (result.average >= 60) { %>

                    <strong>C</strong>
                    <small>GOOD</small>

                <% } else if (result.average >= 50) { %>

                    <strong>D</strong>
                    <small>FAIR</small>

                <% } else if (result.average >= 40) { %>

                    <strong>E</strong>
                    <small>PASS</small>

                <% } else { %>

                    <strong>F</strong>
                    <small>FAILED</small>

                <% } %>

            </div>

        </div>

    </section>


    <!-- =====================================================
         ATTENDANCE
    ====================================================== -->

    <section class="attendance-section">

        <div class="section-title">

            <span>02</span>

            <h2>ATTENDANCE RECORD</h2>

        </div>


        <div class="attendance-content">

            <div class="attendance-stat">

                <span>TOTAL SCHOOL DAYS</span>

                <strong><%= result.present + result.absent %></strong>

            </div>


            <div class="attendance-stat">

                <span>DAYS PRESENT</span>

                <strong><%= result.present %></strong>

            </div>


            <div class="attendance-stat">

                <span>DAYS ABSENT</span>

                <strong><%= result.absent %></strong>

            </div>


            <div class="attendance-stat">

                <span>ATTENDANCE RATE</span>

                <strong>
                     <%= (result.present + result.absent) > 0
                            ? ((result.present / (result.present + result.absent)) * 100).toFixed(1)
                            : 0
                        %>%
                </strong>

            </div>

        </div>

    </section>


    <!-- =====================================================
         AFFECTIVE / CONDUCT
    ====================================================== -->

    <section class="conduct-section">

        <div class="section-title">

            <span>03</span>

            <h2>AFFECTIVE DEVELOPMENT</h2>

        </div>

<!-- 
        <table class="conduct-table">

            <thead>

                <tr>
                    <th>AREA</th>
                    <th>RATING</th>
                    <th>AREA</th>
                    <th>RATING</th>
                </tr>

            </thead>


            <tbody>

                <tr>

                    <td>Attitude to Work</td>
                    <td><strong>Excellent</strong></td>

                    <td>Neatness</td>
                    <td><strong>Very Good</strong></td>

                </tr>


                <tr>

                    <td>Punctuality</td>
                    <td><strong>Very Good</strong></td>

                    <td>Self Control</td>
                    <td><strong>Excellent</strong></td>

                </tr>


                <tr>

                    <td>Teamwork</td>
                    <td><strong>Excellent</strong></td>

                    <td>Leadership</td>
                    <td><strong>Good</strong></td>

                </tr>


                <tr>

                    <td>Relationship with Others</td>
                    <td><strong>Excellent</strong></td>

                    <td>Responsibility</td>
                    <td><strong>Very Good</strong></td>

                </tr>

            </tbody>

        </table> -->

    </section>


    <!-- =====================================================
         COMMENTS
    ====================================================== -->

    <section class="comments-section">

        <div class="comment-box">

            <div class="comment-title">
                CLASS TEACHER'S COMMENT
            </div>

            <p>
                <%= result.tReport %>
            </p>

        </div>


        <div class="comment-box">

            <div class="comment-title">
                HEAD TEACHER'S COMMENT
            </div>

            <p>
                <%= result.Treport %>
            </p>

        </div>

    </section>


    <!-- =====================================================
         GRADING SCALE
    ====================================================== -->

    <section class="grading-section">

        <div class="grading-title">
            GRADING SYSTEM
        </div>


        <div class="grading-grid">

            <div>
                <strong>A</strong>
                <span>80 - 100</span>
                <small>Excellent</small>
            </div>

            <div>
                <strong>B</strong>
                <span>70 - 79</span>
                <small>Very Good</small>
            </div>

            <div>
                <strong>C</strong>
                <span>60 - 69</span>
                <small>Good</small>
            </div>

            <div>
                <strong>D</strong>
                <span>50 - 59</span>
                <small>Fair</small>
            </div>

            <div>
                <strong>E</strong>
                <span>40 - 49</span>
                <small>Pass</small>
            </div>

            <div>
                <strong>F</strong>
                <span>0 - 39</span>
                <small>Fail</small>
            </div>

        </div>

    </section>


    <!-- =====================================================
         SIGNATURES
    ====================================================== -->

    <section class="signatures">

        <div class="signature">

            <div class="signature-space"></div>

            <div class="signature-line"></div>

            <strong>Class Teacher</strong>

            <span>    Date: <%= new Date(result.createdAt).toLocaleDateString('en-GB') %></span>

        </div>


        <div class="signature">

            <div class="signature-space"></div>

            <div class="signature-line"></div>

            <strong>Head Teacher / Principal</strong>

            <span>    Date: <%= new Date(result.createdAt).toLocaleDateString('en-GB') %></span>

        </div>


        <div class="signature">

            <div class="signature-space"></div>

            <div class="signature-line"></div>

            <strong>Parent / Guardian</strong>

            <span>________________</span>

        </div>

    </section>


    <!-- =====================================================
         FOOTER
    ====================================================== -->

    <footer class="result-footer">

        <div>
            GREENFIELD INTERNATIONAL SCHOOL
        </div>

        <div>
            Official Academic Report • 2025 / 2026
        </div>

        <div>
            Powered by MySchoolResult
        </div>

    </footer>

<script src="https://cdn.tailwindcss.com"></script>
<div class="flex flex-wrap items-center justify-center gap-3 my-6">

    <a
        href="/result/<%= result.id %>/jpg"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg
               bg-blue-600 text-white text-sm font-medium
               hover:bg-blue-700 transition"
    >
        📷
        Download Image
    </a>

    <a
        href="/result/<%= result.id %>/pdf"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg
               bg-red-600 text-white text-sm font-medium
               hover:bg-red-700 transition"
    >
        📄
        Download PDF
    </a>

    <button
        type="button"
        onclick="window.print()"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg
               bg-gray-800 text-white text-sm font-medium
               hover:bg-gray-900 transition"
    >
        🖨️
        Print Result
    </button>

</div>


</div>

</body>
</html>