<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Academic Result - Royal Crest College</title>

    <link rel="stylesheet" href="/styles/results/template-4.css">

    <style>
        :root {
            --primary: #312e81;
            --secondary: #4f46e5;
            --accent: #c9a227;
            --light: #f7f7fb;
            --border: #dddde8;
            --text: #27272a;
            --muted: #71717a;
        }
    </style>
</head>

<body>
<div class="no-print flex justify-center gap-2 p-4 print:hidden">

    <a
        href="/result/<%= result._id %>/pdf"
        class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700"
    >
        Download PDF
    </a>

    <a
        href="/result/<%= result._id %>/image"
        class="rounded-lg bg-teal-600 px-4 py-2 text-sm font-semibold text-white hover:bg-teal-700"
    >
        Download Image
    </a>

    <button
        onclick="window.print()"
        class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
    >
        Print
    </button>

</div>
<div class="result-page">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header class="school-header">

        <div class="school-brand">

            <div class="logo-wrapper">

                <img
                    src="<%= school.image.logo %> "
                    alt="<%= school.schoolName %> Logo"
                >

            </div>


            <div class="school-info">

                <h1><%= school.schoolName %></h1>

                <p class="motto">
                    <%= school.motto %>
                </p>

                <p class="address">
                    <%= school.address %>
                </p>

                <p class="contact">
                    Tel: <%= school.phone %> &nbsp; | &nbsp;
                    <%= school.schoolEmail %>
                </p>

            </div>

        </div>


        <div class="academic-badge">

            <span>ACADEMIC</span>

            <strong>REPORT</strong>

            <small><%= result.section %></small>

        </div>

    </header>


    <!-- =====================================================
         TERM BAR
    ====================================================== -->

    <div class="term-bar">

        <div>
            <span>SESSION</span>
            <strong><%= result.section %></strong>
        </div>

        <div>
            <span>TERM</span>
            <strong><%= result.term %></strong>
        </div>

        <div>
            <span>CLASS</span>
            <strong><%= result.studentClass %></strong>
        </div>

        <div>
            <span>RESULT STATUS</span>
            <strong>COMPLETED</strong>
        </div>

    </div>


    <!-- =====================================================
         STUDENT CARD
    ====================================================== -->

    <section class="student-card">

        <div class="student-photo">

            <img
                src="<%= student.passport %>"
                alt="<%= student.fullname?.toUpperCase() %> Photo"
            >

        </div>


        <div class="student-main">

            <span class="label">
                STUDENT
            </span>

            <h2>
                <%= student.fullname %>
            </h2>


            <div class="student-meta">

                <div>
                    <span>Student ID</span>
                    <strong><%= student.studentId %></strong>
                </div>

                <div>
                    <span>Class</span>
                    <strong><%= student.class %></strong>
                </div>

                <div>
                    <span>Gender</span>
                    <strong><%= student.gender %></strong>
                </div>

                <div>
                    <span>House</span>
                    <strong><%= student.house %></strong>
                </div>

            </div>

        </div>


        <div class="student-summary">

            <span>AVERAGE</span>

            <strong><%= result.average %>%</strong>
                 <% if (result.average >= 80) { %>
                    <small>EXCELLENT</small>
                <% } else if (result.average >= 70) { %>
                    <small>VERY GOOD</small>
                <% } else if (result.average >= 60) { %>
                    <small>GOOD</small>
                <% } else if (result.average >= 50) { %>
                    <small>FAIR</small>
                <% } else if (result.average >= 40) { %>
                    <small>PASS</small>
                <% } else { %>
                    <small>FAILED</small>
                <% } %>
        </div>

    </section>


    <!-- =====================================================
         RESULT TITLE
    ====================================================== -->

    <div class="result-title">

        <span>ACADEMIC ASSESSMENT</span>

        <h2><%= result.term %> RESULT</h2>

    </div>


    <!-- =====================================================
         RESULT TABLE
    ====================================================== -->

    <section class="result-section">

        <table class="result-table">

            <thead>

                <tr>

                    <th class="sn">NO.</th>

                    <th class="subject">
                        SUBJECT
                    </th>

                    <th>1st Test</th>

                    <th>2nd Test</th>
                    <th>C.A</th>

                    <th>EXAM</th>

                    <th>TOTAL</th>

                    <th>GRADE</th>

                    <th>REMARK</th>

                </tr>

            </thead>


            <tbody>

                <% result.subjects.forEach((subject, i)=>{  %>
                    <tr>

                    <td><%= i + 1 %></td>

                    <td class="subject-name">
                        <%= subject.subjectName %>
                    </td>
                    <td> <%= subject.firstTest %></td>
                    <td> <%= subject.secondTest %></td>
                    <td> <%= subject.cca %></td>
                    <td> <%= subject.exam %></td>

                    <td class="total-score"> <%= subject.total %></td>

                    <td>
                        <span class="grade grade-a"> <%= subject.grade %></span>
                    </td>

                    <td> <%= subject.remark %></td>

                </tr>
                <% }) %>

            </tbody>

        </table>

    </section>


    <!-- =====================================================
         RESULT SUMMARY
    ====================================================== -->

    <section class="summary-grid">

        <div class="summary-box">

            <span>TOTAL SCORE</span>

            <strong> <%= result.score_obtain %></strong>

            <small>OUT OF <%= result.score_obtainable %></small>

        </div>


        <div class="summary-box">
            <span>AVERAGE SCORE</span>
            <strong>
                 <%= (result.present + result.absent) > 0
                            ? ((result.present / (result.present + result.absent)) * 100).toFixed(1)
                            : 0
                        %>%
            </strong>
        </div>


        <div class="summary-box">

            <span>SUBJECTS OFFERED</span>

            <strong><%= result.subjects.length %></strong>

        </div>


        <div class="summary-box featured">

            <span>OVERALL GRADE</span>
                <% if (result.average >= 80) { %>

                    <strong>A</strong>
                    <small>EXCELLENT</small>

                <% } else if (result.average >= 70) { %>

                    <strong>B</strong>
                    <small>VERY GOOD</small>

                <% } else if (result.average >= 60) { %>

                    <strong>C</strong>
                    <small>GOOD</small>

                <% } else if (result.average >= 50) { %>

                    <strong>D</strong>
                    <small>FAIR</small>

                <% } else if (result.average >= 40) { %>

                    <strong>E</strong>
                    <small>PASS</small>

                <% } else { %>

                    <strong>F</strong>
                    <small>FAILED</small>

                <% } %>


        </div>

    </section>


    <!-- =====================================================
         ATTENDANCE + DEVELOPMENT
    ====================================================== -->

    <section class="two-column">

        <div class="panel">

            <div class="panel-heading">
                ATTENDANCE
            </div>


            <div class="attendance">

                <div>
                    <span>School Days</span>
                    <strong><%= result.present + result.absent %></strong>
                </div>

                <div>
                    <span>Present</span>
                    <strong><%= result.present %></strong>
                </div>

                <div>
                    <span>Absent</span>
                    <strong><%= result.absent %></strong>
                </div>

                <div>
                    <span>Rate</span>
                    <strong>
                        <%= (result.present + result.absent) > 0
                            ? ((result.present / (result.present + result.absent)) * 100).toFixed(1)
                            : 0
                        %>%
                    </strong>
                </div>

            </div>

        </div>


        <div class="panel">

            <div class="panel-heading">
                GENERAL DEVELOPMENT
            </div>


            <div class="development">

                <div>
                    <span>Attitude</span>
                    <strong><%= student.attitude %></strong>
                </div>

                <div>
                    <span>Neatness</span>
                    <strong><%= student.neatness %></strong>
                </div>

                <div>
                    <span>Punctuality</span>
                    <strong><%= student.punctuality %></strong>
                </div>

                <div>
                    <span>Responsibility</span>
                    <strong><%= student.responsibility %></strong>
                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         COMMENTS
    ====================================================== -->

    <section class="comments">

        <div class="comment">

            <div class="comment-label">
                TEACHER'S COMMENT
            </div>

            <p>
                <%= student.tReport %>
            </p>

        </div>


        <div class="comment">

            <div class="comment-label">
                PRINCIPAL'S COMMENT
            </div>

            <p>
                <%= student.Treport %>
            </p>

        </div>

    </section>


    <!-- =====================================================
         GRADING SCALE
    ====================================================== -->

    <section class="grading">

        <div class="grading-heading">
            GRADING SCALE
        </div>


        <div class="grading-list">

            <div>
                <strong>A</strong>
                <span>80 - 100</span>
                <small>Excellent</small>
            </div>

            <div>
                <strong>B</strong>
                <span>70 - 79</span>
                <small>Very Good</small>
            </div>

            <div>
                <strong>C</strong>
                <span>60 - 69</span>
                <small>Good</small>
            </div>

            <div>
                <strong>D</strong>
                <span>50 - 59</span>
                <small>Fair</small>
            </div>

            <div>
                <strong>E</strong>
                <span>40 - 49</span>
                <small>Pass</small>
            </div>

            <div>
                <strong>F</strong>
                <span>0 - 39</span>
                <small>Fail</small>
            </div>

        </div>

    </section>


    <!-- =====================================================
         SIGNATURES
    ====================================================== -->

    <section class="signature-section">

        <div class="signature">

            <div class="signature-space"></div>

            <div class="signature-line"></div>

            <strong>Class Teacher</strong>

            <span>  Date: <%= new Date(result.createdAt).toLocaleDateString('en-GB') %></span>

        </div>


        <div class="signature">

            <div class="signature-space"></div>

            <div class="signature-line"></div>

            <strong>Principal</strong>

            <span>  Date: <%= new Date(result.createdAt).toLocaleDateString('en-GB') %></span>

        </div>


        <div class="signature">

            <div class="signature-space"></div>

            <div class="signature-line"></div>

            <strong>Parent / Guardian</strong>

            <span>________________</span>

        </div>

    </section>


    <!-- =====================================================
         FOOTER
    ====================================================== -->

    <footer class="footer">

        <span>
            ROYAL CREST COLLEGE
        </span>

        <span>
            Official Academic Record
        </span>

        <span>
            Powered by MySchoolResult
        </span>

    </footer>

</div>
<script src="https://cdn.tailwindcss.com"></script>



</body>
</html>
