
<%
  const resultList = Array.isArray(results)
    ? results
    : (results ? [results] : []);
  const isBulk = resultList.length > 1;
  const firstResult = resultList[0];

  const session = firstResult?.section || '';
  const term = firstResult?.term || '';
  const schoolName = firstResult?.schoolName || '';

  const params = new URLSearchParams({
    session,
    term,
    schoolName,
    sclass: sclass 
  }).toString();

  const pdfUrl = `/results/pdf?${params}`;
  const imageUrl = `/results/image?${params}`;

  const safe = (value, fallback = '—') =>
    value !== undefined && value !== null && value !== ''
      ? value
      : fallback;
%>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Result - <%= school.schoolName %></title>

  <link rel="stylesheet" href="/styles/results/template-1.css">

  <style>
    :root {
      --primary-color: <%= school.primaryColor || '#1d4ed8' %>;
      --secondary-color: <%= school.secondaryColor || '#f59e0b' %>;
    }
  </style>
</head>

<body>

  <!-- DOWNLOAD CONTROLS -->
  <% if (resultList.length > 0) { %>
    <div class="no-print download-toolbar">
      <div class="download-info">
        <strong><%= isBulk ? 'Class Results' : 'Student Result' %></strong>
        <span>
          <%= isBulk ? `${resultList.length} student results` : safe(firstResult.fullname) %>
        </span>
      </div>

      <div class="download-actions">
        <a href="<%= pdfUrl %>" class="download-btn pdf-btn">
          <span>↓</span> Download PDF
        </a>

        <% if (!isBulk) { %>
          <a href="<%= imageUrl %>" class="download-btn image-btn">
            <span>↓</span> Download Image
          </a>
        <% } %>

        <button onclick="window.print()" class="download-btn print-btn">
          Print Result
        </button>
      </div>
    </div>
  <% } %>

  <% if (resultList.length === 0) { %>
    <div class="empty-state">
      <h2>No result available</h2>
      <p>There are no results to display.</p>
    </div>
  <% } %>

  <% resultList.forEach((result, index) => { %>

    <main class="result-page">

      <!-- SCHOOL HEADER -->
      <header class="school-header">

        <div class="school-logo">
          <% if (school.image?.logo) { %>
            <img src="<%= school.image.logo %>" alt="School Logo">
          <% } else { %>
            <div class="logo-placeholder">LOGO</div>
          <% } %>
        </div>

        <div class="school-details">
          <h1><%= safe(school.schoolName, 'School Name') %></h1>

          <% if (school.motto) { %>
            <p class="motto"><%= school.motto %></p>
          <% } %>

          <% if (school.address) { %>
            <p class="address"><%= school.address %></p>
          <% } %>

          <% if (school.phone) { %>
            <p class="phone">Tel: <%= school.phone %></p>
          <% } %>
        </div>

      </header>

      <div class="report-heading">
        <h2>STUDENT ACADEMIC REPORT</h2>
        <span>END OF TERM REPORT</span>
      </div>

      <!-- STUDENT INFORMATION -->
      <section class="student-section">

        <div class="student-photo">
          <% if (result.passport) { %>
            <img src="<%= result.passport %>" alt="Student Photo">
          <% } else { %>
            <div class="photo-placeholder">PHOTO</div>
          <% } %>
        </div>

        <div class="student-info">

          <div class="info-item">
            <span>Name</span>
            <strong><%= safe(result.fullname) %></strong>
          </div>

          <div class="info-item">
            <span>Student ID</span>
            <strong><%= safe(result.studentId) %></strong>
          </div>

          <div class="info-item">
            <span>Class</span>
            <strong><%= safe(result.studentClass) %></strong>
          </div>

          <div class="info-item">
            <span>Gender</span>
            <strong><%= safe(result.gender) %></strong>
          </div>

          <div class="info-item">
            <span>Term</span>
            <strong><%= safe(result.term) %></strong>
          </div>

          <div class="info-item">
            <span>Academic Session</span>
            <strong><%= safe(result.section) %></strong>
          </div>

        </div>

      </section>

      <!-- TWO-COLUMN RESULT CONTENT -->
      <div class="result-content">

        <!-- LEFT: ACADEMIC PERFORMANCE -->
        <section class="academic-section">

          <h3 class="section-heading">ACADEMIC PERFORMANCE</h3>

          <table class="result-table">
            <thead>
              <tr>
                <th>#</th>
                <th class="subject-heading">Subject</th>
                <th>1st</th>
                <th>2nd</th>
                <th>CA</th>
                <th>Exam</th>
                <th>Total</th>
                <th>Grade</th>
                <th>Remark</th>
              </tr>
            </thead>

            <tbody>
              <% (result.subjects || []).forEach((subject, subjectIndex) => { %>
                <tr>
                  <td><%= subjectIndex + 1 %></td>

                  <td class="subject">
                    <%= safe(subject.subjectName) %>
                  </td>

                  <td><%= safe(subject.firstTest, 0) %></td>
                  <td><%= safe(subject.secondTest, 0) %></td>
                  <td><%= safe(subject.cca, 0) %></td>
                  <td><%= safe(subject.exam, 0) %></td>

                  <td class="total">
                    <%= safe(subject.total, 0) %>
                  </td>

                  <td>
                    <span class="grade"><%= safe(subject.grade) %></span>
                  </td>

                  <td><%= safe(subject.remark) %></td>
                </tr>
              <% }) %>

              <% if (!result.subjects || result.subjects.length === 0) { %>
                <tr>
                  <td colspan="9" class="empty-table">
                    No subjects available.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>

          <div class="subject-count">
            Subjects offered: <strong><%= safe(result.No_subj, result.subjects?.length || 0) %></strong>
          </div>

        </section>

        <!-- RIGHT: SUMMARY, ATTENDANCE AND COMMENTS -->
        <aside class="result-sidebar">

          <section class="summary-section">

            <h3 class="section-heading">RESULT SUMMARY</h3>

            <div class="summary-grid">

              <div class="summary-card">
                <span>Total Score</span>
                <strong><%= safe(result.score_obtain, 0) %></strong>
                <small>OUT OF <%= safe(result.score_obtainable, 0) %></small>
              </div>

              <div class="summary-card">
                <span>Average</span>
                <strong><%= safe(result.average, 0) %>%</strong>
              </div>

              <div class="summary-card">
                <span>Grade</span>
                <strong><%= safe(result.grade) %></strong>
              </div>

              <div class="summary-card">
                <span>Subjects</span>
                <strong><%= safe(result.No_subj, result.subjects?.length || 0) %></strong>
              </div>

            </div>

            <div class="promotion-status">
              <span>Promotion</span>
              <strong><%= safe(result.promote) %></strong>
            </div>

          </section>

          <section class="attendance-section">

            <h3 class="section-heading">ATTENDANCE</h3>

            <div class="attendance-grid">

              <div>
                <span>Present</span>
                <strong><%= safe(result.present, 0) %></strong>
              </div>

              <div>
                <span>Absent</span>
                <strong><%= safe(result.absent, 0) %></strong>
              </div>

              <div>
                <span>Resumes</span>
                <strong><%= safe(result.nextTerm) %></strong>
              </div>

            </div>

          </section>

          <section class="comments-section">

            <h3 class="section-heading">REMARKS AND COMMENTS</h3>

            <div class="comment-box">
              <h4>Class Teacher</h4>
              <p><%= safe(result.Treport, 'No comment available.') %></p>
            </div>

            <div class="comment-box">
              <h4>Principal / Head Teacher</h4>
              <p><%= safe(result.tReport, 'No comment available.') %></p>
            </div>

          </section>

        </aside>

      </div>

      <!-- SIGNATURES -->
      <section class="signatures">

        <div class="signature">
          <% if (result.classTeacherSignatre || result.classTeacherSignature) { %>
            <img
              src="<%= result.classTeacherSignatre || result.classTeacherSignature %>"
              alt="Class Teacher Signature">
          <% } %>

          <div class="signature-line"></div>
          <p>Class Teacher</p>
        </div>

        <div class="signature">
          <% if (school.headTeachersignature) { %>
            <img
              src="<%= school.headTeachersignature %>"
              alt="Head Teacher Signature">
          <% } %>

          <div class="signature-line"></div>
          <p>Principal / Head Teacher</p>
        </div>

      </section>

      <footer class="result-footer">
        <span><%= school.schoolName %></span>
        <span>Student Academic Report</span>
      </footer>

    </main>

  <% }) %>

  <!-- Scale the A4 sheet down to fit small screens (same layout as laptop) -->
  <script>
    (function () {
      var PAGE_WIDTH = 794; // A4 width (210mm) in CSS px

      function fit() {
        var available = document.documentElement.clientWidth - 16;
        var scale = available < PAGE_WIDTH ? available / PAGE_WIDTH : 1;
        document.querySelectorAll('.result-page').forEach(function (page) {
          page.style.zoom = scale === 1 ? '' : scale;
        });
      }

      fit();
      window.addEventListener('resize', fit);
      window.addEventListener('orientationchange', fit);
      window.addEventListener('beforeprint', function () {
        document.querySelectorAll('.result-page').forEach(function (p) { p.style.zoom = ''; });
      });
      window.addEventListener('afterprint', fit);
    })();
  </script>

</body>
</html>