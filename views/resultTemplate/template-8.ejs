<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= school.fullname %> - Result</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/styles/results/template-8.css">
</head>

<body>
<div class="no-print flex justify-center gap-2 p-4 print:hidden">

    <a
        href="/result/<%= result._id %>/pdf"
        class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700"
    >
        Download PDF
    </a>

    <a
        href="/result/<%= result._id %>/image"
        class="rounded-lg bg-teal-600 px-4 py-2 text-sm font-semibold text-white hover:bg-teal-700"
    >
        Download Image
    </a>

    <button
        onclick="window.print()"
        class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
    >
        Print
    </button>

</div>

<div class="report-sheet">

    <!-- ================================
         SCHOOL HEADER
    ================================= -->

    <header class="school-header">

        <div class="header-line"></div>

        <div class="school-header-content">

            <div class="school-logo">
                <img
                    src="<%= school.image.logo %>"
                    alt="School Logo"
                >
            </div>

            <div class="school-info">

                <div class="official-text">
                    <span>EDUCATIONAL INSTITUTION</span>
                    <span>OFFICIAL REPORT CARD</span>
                </div>

                <h1>
                    <%= school.schoolName %>
                </h1>

                <p>
                    <%= school.address %>
                </p>

                <p>
                    Tel: <%= school.phone %>
                    <% if (school.email) { %>
                        · <%= school.email %>
                    <% } %>
                </p>

                <div class="motto">
                    "<%= school.motto %>"
                </div>

            </div>

            <div class="report-stamp">

                <div class="stamp-inner">

                    <span>ACADEMIC</span>

                    <strong>REPORT</strong>

                    <span>CARD</span>

                </div>

            </div>

        </div>

        <div class="header-bottom"></div>

    </header>


    <!-- ================================
         SESSION INFORMATION
    ================================= -->

    <section class="session-information">

        <div class="session-item">

            <span>ACADEMIC SESSION</span>

            <strong>
                <%= result.section %>
            </strong>

        </div>

        <div class="session-item">

            <span>TERM</span>

            <strong>
                <%= result.term %>
            </strong>

        </div>

        <div class="session-item">

            <span>CLASS</span>

            <strong>
                <%= result.studentClass %>
            </strong>

        </div>

        <div class="session-item">

            <span>DATE ISSUED</span>

            <strong>
                <%= new Date(result.createdAt).toLocaleDateString('en-GB') %>
            </strong>

        </div>

    </section>


    <!-- ================================
         STUDENT INFORMATION
    ================================= -->

    <section class="student-card">

        <div class="student-photo">

            <img
                src="<%= student.passport %>"
                alt="Student Photo"
            >

        </div>


        <div class="student-main">

            <div class="student-label">
                STUDENT PARTICULARS
            </div>

            <h2>
                <%= result.fullname %>
            </h2>

            <div class="student-details">

                <div>
                    <span>STUDENT ID</span>
                    <strong><%= result.studentId %></strong>
                </div>

                <div>
                    <span>GENDER</span>
                    <strong><%= student.gender %></strong>
                </div>

                <div>
                    <span>CLASS</span>
                    <strong><%= result.studentClass %></strong>
                </div>

                <div>
                    <span>TERM</span>
                    <strong><%= result.term %></strong>
                </div>

            </div>

        </div>


        <div class="position-card">

            <span>CLASS POSITION</span>

            <% if (result.average >= 80) { %>
                    <strong>A</strong>
                    <small>EXCELLENT</small>
                <% } else if (result.average >= 70) { %>
                    <strong>B</strong>
                    <small>VERY GOOD</small>
                <% } else if (result.average >= 60) { %>
                    <strong>C</strong>
                    <small>GOOD</small>
                <% } else if (result.average >= 50) { %>
                    <strong>D</strong>
                    <small>FAIR</small>
                <% } else if (result.average >= 40) { %>
                    <strong>E</strong>
                    <small>PASS</small>
                <% } else { %>
                    <strong>F</strong>
                    <small>FAILED</small>
                <% } %>

        </div>

    </section>


    <!-- ================================
         RESULT TITLE
    ================================= -->

    <div class="result-title">

        <div class="title-number">
            I
        </div>

        <div>

            <span>ACADEMIC RECORD</span>

            <h3>
                PERFORMANCE IN SUBJECTS
            </h3>

        </div>

    </div>


    <!-- ================================
         RESULTS TABLE
    ================================= -->

    <section class="results-container">

        <table class="result-table">

            <thead>

                <tr>

                    <th class="number-column">
                        #
                    </th>

                    <th class="subject-column">
                        SUBJECT
                    </th>

                    <th>
                       FIRST TEST
                    </th>
                    <th>
                       SECOND TEST
                    </th>
                    <th>
                       C.A
                    </th>

                    <th>
                        EXAM
                        <small>60</small>
                    </th>

                    <th>
                        TOTAL
                        <small>100</small>
                    </th>

                    <th>
                        GRADE
                    </th>

                    <th>
                        REMARK
                    </th>

                </tr>

            </thead>

            <tbody>

               <% result.subjects.forEach((subject, i)=>{  %>
                    <tr>

                    <td><%= i + 1 %></td>

                    <td class="subject-name">
                        <%= subject.subjectName %>
                    </td>
                    <td> <%= subject.firstTest %></td>
                    <td> <%= subject.secondTest %></td>
                    <td> <%= subject.cca %></td>
                    <td> <%= subject.exam %></td>

                    <td class="total-score"> <%= subject.total %></td>

                    <td>
                        <span class="grade grade-a"> <%= subject.grade %></span>
                    </td>

                    <td> <%= subject.remark %></td>

                </tr>
                <% }) %>

            </tbody>

        </table>

    </section>


    <!-- ================================
         SUMMARY
    ================================= -->

    <section class="result-summary">

        <div class="summary-heading">
            PERFORMANCE SUMMARY
        </div>

        <div class="summary-items">

            <div class="summary-item">

                <span>TOTAL SCORE</span>

                <strong>
                  <strong> <%= result.score_obtain %></strong>
                </strong>

            </div>
            <div class="summary-item">

                <span>SCORE OBTAINED</span>

                <strong>
                  <strong> <%= result.score_obtainable %></strong>
                </strong>

            </div>

            <div class="summary-item">

                <span>AVERAGE</span>

                <strong>
                    <%= result.average %>
                </strong>

                <small>%</small>

            </div>


            <div class="summary-item">

                <span>SUBJECTS</span>

                <strong>
                    <%= result.subjects.length %>
                </strong>

            </div>

        </div>

    </section>


    <!-- ================================
         ATTENDANCE
    ================================= -->

    <section class="attendance-section">

        <div class="section-bar">

            <span>II</span>

            <strong>
                ATTENDANCE RECORD
            </strong>

        </div>

        <div class="attendance-grid">

            <div>
                <span>SCHOOL DAYS</span>
                <strong><%= result.present + result.absent %></strong>
            </div>

            <div>
                <span>DAYS PRESENT</span>
                <strong><%= result.present %></strong>
            </div>

            <div>
                <span>DAYS ABSENT</span>
                <strong><%= result.absent %></strong>
            </div>

            <div>
                <span>ATTENDANCE</span>
                <strong>
                  <%= (result.present + result.absent) > 0
                            ? ((result.present / (result.present + result.absent)) * 100).toFixed(1)
                            : 0
                </strong>
            </div>

        </div>

    </section>


    <!-- ================================
         CHARACTER / DEVELOPMENT
    ================================= -->

    <section class="development-section">

        <div class="section-bar">

            <span>III</span>

            <strong>
                CHARACTER & DEVELOPMENT
            </strong>

        </div>

        <div class="development-grid">

            <div class="development-item">

                <span>Punctuality</span>

                <strong>
                    <%= result.punctuality %>
                </strong>

            </div>

            <div class="development-item">

                <span>Neatness</span>

                <strong>
                    <%= result.neatness %>
                </strong>

            </div>

            <div class="development-item">

                <span>Participation</span>

                <strong>
                    <%= result.participation %>
                </strong>

            </div>

            <div class="development-item">

                <span>Cooperation</span>

                <strong>
                    <%= result.cooperation %>
                </strong>

            </div>

            <div class="development-item">

                <span>Respect</span>

                <strong>
                    <%= result.respect %>
                </strong>

            </div>

            <div class="development-item">

                <span>Responsibility</span>

                <strong>
                    <%= result.responsibility %>
                </strong>

            </div>

        </div>

    </section>


    <!-- ================================
         COMMENTS
    ================================= -->

    <section class="comments-section">

        <div class="comment-box">

            <div class="comment-title">

                <span>IV</span>

                <strong>
                    CLASS TEACHER'S COMMENT
                </strong>

            </div>

            <p>
                <%= result.tReport %>
            </p>

        </div>


        <div class="comment-box">

            <div class="comment-title">

                <span>V</span>

                <strong>
                    HEAD TEACHER'S COMMENT
                </strong>

            </div>

            <p>
                <%= result.Treport %>
            </p>

        </div>

    </section>


    <!-- ================================
         GRADING SYSTEM
    ================================= -->

    <section class="grading-section">

        <div class="grading-title">
            GRADING SYSTEM
        </div>

        <div class="grading-grid">

            <div>
                <strong>A</strong>
                <span>80 – 100</span>
                <small>Excellent</small>
            </div>

            <div>
                <strong>B</strong>
                <span>70 – 79</span>
                <small>Very Good</small>
            </div>

            <div>
                <strong>C</strong>
                <span>60 – 69</span>
                <small>Good</small>
            </div>

            <div>
                <strong>D</strong>
                <span>50 – 59</span>
                <small>Fair</small>
            </div>

            <div>
                <strong>E</strong>
                <span>40 – 49</span>
                <small>Pass</small>
            </div>

            <div>
                <strong>F</strong>
                <span>0 – 39</span>
                <small>Fail</small>
            </div>

        </div>

    </section>


    <!-- ================================
         SIGNATURES
    ================================= -->

    <section class="signature-section">

        <div class="signature">

            <div class="signature-space">

                <% if (result.teacherSignature) { %>

                    <img
                        src="<%= result.teacherSignature %>"
                        alt="Teacher Signature"
                    >

                <% } %>

            </div>

            <div class="signature-line"></div>

            <strong>
                CLASS TEACHER
            </strong>

            <span>
                Signature & Date
            </span>

        </div>


        <div class="signature">

            <div class="signature-space">

                <% if (result.principalSignature) { %>

                    <img
                        src="<%= result.principalSignature %>"
                        alt="Head Teacher Signature"
                    >

                <% } %>

            </div>

            <div class="signature-line"></div>

            <strong>
                HEAD TEACHER
            </strong>

            <span>
                Signature & Date
            </span>

        </div>


        <div class="signature">

            <div class="signature-space"></div>

            <div class="signature-line"></div>

            <strong>
                PARENT / GUARDIAN
            </strong>

            <span>
                Signature & Date
            </span>

        </div>

    </section>


    <!-- ================================
         FOOTER
    ================================= -->

    <footer class="report-footer">

        <div class="footer-left">

            <strong>
                <%= school.name %>
            </strong>

            <span>
                Official Academic Report
            </span>

        </div>

        <div class="footer-center">

            Powered by
            <strong>MySchoolResult</strong>

        </div>

        <div class="footer-right">

            <span>
                <%= result.session %>
            </span>

        </div>

    </footer>

</div>


</body>
</html>