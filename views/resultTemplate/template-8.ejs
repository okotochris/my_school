<%
  const resultList = Array.isArray(results)
    ? results
    : (results ? [results] : []);
  const isBulk = resultList.length > 1;
  const firstResult = resultList[0];

  const session = firstResult?.section || '';
  const term = firstResult?.term || '';
  const schoolName = firstResult?.schoolName || '';

  const params = new URLSearchParams({
    session,
    term,
    schoolName,
    sclass: sclass 
  }).toString();

  const pdfUrl = `/results/pdf?${params}`;
  const imageUrl = `/results/image?${params}`;

  const safe = (value, fallback = '—') =>
    value !== undefined && value !== null && value !== ''
      ? value
      : fallback;

  const overall = (avg) => {
    avg = Number(avg) || 0;
    if (avg >= 80) return ['A', 'EXCELLENT'];
    if (avg >= 70) return ['B', 'VERY GOOD'];
    if (avg >= 60) return ['C', 'GOOD'];
    if (avg >= 50) return ['D', 'FAIR'];
    if (avg >= 40) return ['E', 'PASS'];
    return ['F', 'FAILED'];
  };
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= school.schoolName %> - Result</title>
    <link rel="stylesheet" href="/styles/results/template-8.css">
</head>

<body>

  <!-- DOWNLOAD CONTROLS -->
  <% if (resultList.length > 0) { %>
    <div class="no-print download-toolbar">
      <div class="download-info">
        <strong><%= isBulk ? 'Class Results' : 'Student Result' %></strong>
        <span>
          <%= isBulk ? `${resultList.length} student results` : safe(firstResult.fullname) %>
        </span>
      </div>

      <div class="download-actions">
        <a href="<%= pdfUrl %>" class="download-btn pdf-btn">
          <span>↓</span> Download PDF
        </a>

        <% if (!isBulk) { %>
          <a href="<%= imageUrl %>" class="download-btn image-btn">
            <span>↓</span> Download Image
          </a>
        <% } %>

        <button onclick="window.print()" class="download-btn print-btn">
          Print Result
        </button>
      </div>
    </div>
  <% } %>

  <% if (resultList.length === 0) { %>
    <div class="empty-state">
      <h2>No result available</h2>
      <p>There are no results to display.</p>
    </div>
  <% } %>

<% resultList.forEach((result) => {
     const [gradeLetter, gradeWord] = overall(result.average);
     const days = (Number(result.present) || 0) + (Number(result.absent) || 0);
     const schoolEmail = school.schoolEmail || school.email;
%>

<div class="report-sheet">

    <!-- SCHOOL HEADER -->
    <header class="school-header">

        <div class="header-line"></div>

        <div class="school-header-content">

            <div class="school-logo">
                <% if (school.image?.logo) { %>
                    <img src="<%= school.image.logo %>" alt="School Logo">
                <% } %>
            </div>

            <div class="school-info">

                <div class="official-text">
                    <span>EDUCATIONAL INSTITUTION</span>
                    <span>OFFICIAL REPORT CARD</span>
                </div>

                <h1><%= school.schoolName %></h1>

                <% if (school.address) { %>
                    <p class="address"><%= school.address %></p>
                <% } %>

                <p class="contact">
                    <% if (school.phone) { %>Tel: <%= school.phone %><% } %>
                    <% if (school.phone && schoolEmail) { %> &middot; <% } %>
                    <% if (schoolEmail) { %><%= schoolEmail %><% } %>
                </p>

                <% if (school.motto) { %>
                    <div class="motto">&ldquo;<%= school.motto %>&rdquo;</div>
                <% } %>

            </div>

            <div class="report-stamp">
                <div class="stamp-inner">
                    <span>ACADEMIC</span>
                    <strong>REPORT</strong>
                    <span>CARD</span>
                </div>
            </div>

        </div>

        <div class="header-bottom"></div>

    </header>

    <!-- STUDENT INFORMATION -->
    <section class="student-card">

        <div class="student-photo">
            <% if (result.passport) { %>
                <img src="<%= result.passport %>" alt="Student Photo">
            <% } %>
        </div>

        <div class="student-main">

            <div class="student-label">STUDENT PARTICULARS</div>

            <h2><%= safe(result.fullname) %></h2>

            <div class="student-details">
                <div>
                    <span>STUDENT ID</span>
                    <strong><%= safe(result.studentId) %></strong>
                </div>
                <div>
                    <span>GENDER</span>
                    <strong><%= safe(result.gender) %></strong>
                </div>
                <div>
                    <span>CLASS</span>
                    <strong><%= safe(result.studentClass) %></strong>
                </div>
                <div>
                    <span>TERM</span>
                    <strong><%= safe(result.term) %></strong>
                </div>
            </div>

        </div>

        <div class="position-card">
            <span>OVERALL GRADE</span>
            <strong><%= gradeLetter %></strong>
            <small><%= gradeWord %></small>
        </div>

    </section>

    <!-- MAIN CONTENT: TABLE ON THE LEFT, DETAILS ON THE RIGHT -->
    <div class="main-content">

        <!-- LEFT: RESULTS TABLE -->
        <section class="results-container">

            <div class="result-title">
                <div class="title-number">I</div>
                <div>
                    <span>ACADEMIC RECORD</span>
                    <h3>SUBJECT PERFORMANCE</h3>
                </div>
            </div>

            <table class="result-table">

                <thead>
                    <tr>
                        <th class="number-column">#</th>
                        <th class="subject-column">SUBJECT</th>
                        <th>1ST</th>
                        <th>2ND</th>
                        <th>C.A</th>
                        <th>EXAM</th>
                        <th>TOTAL</th>
                        <th>GRADE</th>
                        <th class="remark-column">REMARK</th>
                    </tr>
                </thead>

                <tbody>
                    <% (result.subjects || []).forEach((subject, i) => { %>
                        <tr>
                            <td><%= i + 1 %></td>
                            <td class="subject-name"><%= safe(subject.subjectName) %></td>
                            <td><%= safe(subject.firstTest, 0) %></td>
                            <td><%= safe(subject.secondTest, 0) %></td>
                            <td><%= safe(subject.cca, 0) %></td>
                            <td><%= safe(subject.exam, 0) %></td>
                            <td class="total-score"><%= safe(subject.total, 0) %></td>
                            <td>
                                <span class="grade grade-<%= String(subject.grade || '').toLowerCase().charAt(0) %>">
                                    <%= safe(subject.grade) %>
                                </span>
                            </td>
                            <td class="remark"><%= safe(subject.remark) %></td>
                        </tr>
                    <% }) %>

                    <% if (!result.subjects || result.subjects.length === 0) { %>
                        <tr>
                            <td colspan="9" class="empty-table">No subjects available.</td>
                        </tr>
                    <% } %>
                </tbody>

            </table>

        </section>

        <!-- RIGHT: SUMMARY, ATTENDANCE, DEVELOPMENT, COMMENTS -->
        <aside class="result-sidebar">

            <!-- SUMMARY -->
            <section class="result-summary">

                <div class="summary-heading">PERFORMANCE SUMMARY</div>

                <div class="summary-items">

                    <div class="summary-item">
                        <span>SCORE OBTAINABLE</span>
                        <strong><%= safe(result.score_obtainable, 0) %></strong>
                    </div>

                    <div class="summary-item">
                        <span>SCORE OBTAINED</span>
                        <strong><%= safe(result.score_obtain, 0) %></strong>
                    </div>

                    <div class="summary-item">
                        <span>AVERAGE</span>
                        <strong><%= safe(result.average, 0) %></strong><small>%</small>
                    </div>

                    <div class="summary-item">
                        <span>SUBJECTS</span>
                        <strong><%= (result.subjects || []).length %></strong>
                    </div>

                </div>

            </section>

            <!-- ATTENDANCE -->
            <section class="attendance-section">

                <div class="section-bar">
                    <span>II</span>
                    <strong>ATTENDANCE RECORD</strong>
                </div>

                <div class="attendance-grid">
                    <div>
                        <span>SCHOOL DAYS</span>
                        <strong><%= days %></strong>
                    </div>
                    <div>
                        <span>DAYS PRESENT</span>
                        <strong><%= safe(result.present, 0) %></strong>
                    </div>
                    <div>
                        <span>DAYS ABSENT</span>
                        <strong><%= safe(result.absent, 0) %></strong>
                    </div>
                    <div>
                        <span>ATTENDANCE</span>
                        <strong><%= days > 0 ? (((Number(result.present) || 0) / days) * 100).toFixed(1) : 0 %>%</strong>
                    </div>
                </div>

            </section>

            <!-- CHARACTER / DEVELOPMENT -->
            <section class="development-section">

                <div class="section-bar">
                    <span>III</span>
                    <strong>CHARACTER &amp; DEVELOPMENT</strong>
                </div>

                <div class="development-grid">
                    <div class="development-item">
                        <span>Punctuality</span>
                        <strong><%= safe(result.punctuality) %></strong>
                    </div>
                    <div class="development-item">
                        <span>Neatness</span>
                        <strong><%= safe(result.neatness) %></strong>
                    </div>
                    <div class="development-item">
                        <span>Participation</span>
                        <strong><%= safe(result.participation) %></strong>
                    </div>
                    <div class="development-item">
                        <span>Cooperation</span>
                        <strong><%= safe(result.cooperation) %></strong>
                    </div>
                    <div class="development-item">
                        <span>Respect</span>
                        <strong><%= safe(result.respect) %></strong>
                    </div>
                    <div class="development-item">
                        <span>Responsibility</span>
                        <strong><%= safe(result.responsibility) %></strong>
                    </div>
                </div>

            </section>

            <!-- COMMENTS -->
            <div class="comment-box">
                <div class="comment-title">
                    <span>IV</span>
                    <strong>CLASS TEACHER'S COMMENT</strong>
                </div>
                <p><%= safe(result.tReport, 'No comment available.') %></p>
            </div>

            <div class="comment-box">
                <div class="comment-title">
                    <span>V</span>
                    <strong>HEAD TEACHER'S COMMENT</strong>
                </div>
                <p><%= safe(result.Treport, 'No comment available.') %></p>
            </div>

        </aside>

    </div>

    <!-- GRADING SYSTEM -->
    <section class="grading-section">

        <div class="grading-title">GRADING SYSTEM</div>

        <div class="grading-grid">
            <div><strong>A</strong><span>80 – 100</span><small>Excellent</small></div>
            <div><strong>B</strong><span>70 – 79</span><small>Very Good</small></div>
            <div><strong>C</strong><span>60 – 69</span><small>Good</small></div>
            <div><strong>D</strong><span>50 – 59</span><small>Fair</small></div>
            <div><strong>E</strong><span>40 – 49</span><small>Pass</small></div>
            <div><strong>F</strong><span>0 – 39</span><small>Fail</small></div>
        </div>

    </section>

    <!-- SIGNATURES -->
    <section class="signature-section">

        <div class="signature">
            <div class="signature-space">
                <% if (result.teacherSignature) { %>
                    <img src="<%= result.teacherSignature %>" alt="Teacher Signature">
                <% } %>
            </div>
            <div class="signature-line"></div>
            <strong>CLASS TEACHER</strong>
            <span>Signature &amp; Date</span>
        </div>

        <div class="signature">
            <div class="signature-space">
                <% if (result.principalSignature) { %>
                    <img src="<%= result.principalSignature %>" alt="Head Teacher Signature">
                <% } %>
            </div>
            <div class="signature-line"></div>
            <strong>HEAD TEACHER</strong>
            <span>Signature &amp; Date</span>
        </div>

        <div class="signature">
            <div class="signature-space"></div>
            <div class="signature-line"></div>
            <strong>PARENT / GUARDIAN</strong>
            <span>Signature &amp; Date</span>
        </div>

    </section>

</div>

<% }) %>

<!-- Scale the A4 sheet down on small screens (same layout as laptop) -->
<script>
  (function () {
    var PAGE_WIDTH = 794; // A4 width (210mm) in CSS px

    function fit() {
      var available = document.documentElement.clientWidth - 16;
      var scale = available < PAGE_WIDTH ? available / PAGE_WIDTH : 1;
      document.querySelectorAll('.report-sheet').forEach(function (page) {
        page.style.zoom = scale === 1 ? '' : scale;
      });
    }

    fit();
    window.addEventListener('resize', fit);
    window.addEventListener('orientationchange', fit);
    window.addEventListener('beforeprint', function () {
      document.querySelectorAll('.report-sheet').forEach(function (p) { p.style.zoom = ''; });
    });
    window.addEventListener('afterprint', fit);
  })();
</script>

</body>
</html>