<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Result - Heritage Model College</title>
    
    <link rel="stylesheet" href="/styles/results/template-5.css">
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        :root {
            --primary: #0f172a;
            --secondary: #0e7490;
            --accent: #f59e0b;
            --light: #f8fafc;
            --border: #dbe3ea;
            --text: #1e293b;
            --muted: #64748b;
            --success: #15803d;
        }
    </style>
</head>

<body>
<div class="no-print flex justify-center gap-2 p-4 print:hidden">

    <a
        href="/result/<%= result._id %>/pdf"
        class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700"
    >
        Download PDF
    </a>

    <a
        href="/result/<%= result._id %>/image"
        class="rounded-lg bg-teal-600 px-4 py-2 text-sm font-semibold text-white hover:bg-teal-700"
    >
        Download Image
    </a>

    <button
        onclick="window.print()"
        class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
    >
        Print
    </button>

</div>
<div class="result-page">

    <!-- =====================================================
         TOP HEADER
    ====================================================== -->

    <header class="top-header">

        <div class="header-accent"></div>

        <div class="school-logo">

            <img
                src="<%= school.image.logo %>"
                alt="School Logo"
            >

        </div>


        <div class="school-details">

            <h1><%= school.schoolName %></h1>

            <p class="motto">
                <%= school.motto %>
            </p>

            <p class="address">
                <%= school.address %>
            </p>

            <p class="contact">
                Tel: <%= school.phone %>
                • <%= school.email %>
            </p>

        </div>


        <div class="report-tag">

            <span>STUDENT</span>

            <strong>REPORT</strong>

            <small><%= result.section %></small>

        </div>

    </header>


    <!-- =====================================================
         SESSION INFORMATION
    ====================================================== -->

    <section class="session-bar">

        <div>
            <span>ACADEMIC SESSION</span>
            <strong><%= result.section %></strong>
        </div>

        <div>
            <span>TERM</span>
            <strong><%= result.term %></strong>
        </div>

        <div>
            <span>CLASS</span>
            <strong><%= result.class %></strong>
        </div>

        <div>
            <span>REPORT DATE</span>
            <strong><%= new Date(result.createdAt).toLocaleDateString('en-GB') %></strong>
        </div>

    </section>


    <!-- =====================================================
         STUDENT PROFILE
    ====================================================== -->

    <section class="student-profile">

        <div class="photo-container">

            <img
                src="<%= student.passport %>"
                alt="Student Photo"
            >

        </div>


        <div class="profile-details">

            <span class="profile-label">
                STUDENT INFORMATION
            </span>

            <h2>
                <%=student.fullname?.toUpperCase() %>
            </h2>


            <div class="profile-grid">

                <div>
                    <span>STUDENT ID</span>
                    <strong><%= student.studentId %></strong>
                </div>

                <div>
                    <span>CLASS</span>
                    <strong><%= result.studentClass %></strong>
                </div>

                <div>
                    <span>GENDER</span>
                    <strong><%= student.gender %></strong>
                </div>

                <div>
                    <span>HOUSE</span>
                    <strong><%= student.house %></strong>
                </div>

            </div>

        </div>


        <div class="academic-score">

                <% if (result.average >= 80) { %>
                    <strong>A</strong>
                    <small>EXCELLENT</small>
                <% } else if (result.average >= 70) { %>
                    <strong>B</strong>
                    <small>VERY GOOD</small>
                <% } else if (result.average >= 60) { %>
                    <strong>C</strong>
                    <small>GOOD</small>
                <% } else if (result.average >= 50) { %>
                    <strong>D</strong>
                    <small>FAIR</small>
                <% } else if (result.average >= 40) { %>
                    <strong>E</strong>
                    <small>PASS</small>
                <% } else { %>
                    <strong>F</strong>
                    <small>FAILED</small>
                <% } %>

        </div>

    </section>


    <!-- =====================================================
         ACADEMIC RESULT
    ====================================================== -->

    <section class="academic-section">

        <div class="section-header">

            <div class="section-number">
                01
            </div>

            <div>
                <span>ACADEMIC RECORD</span>
                <h2>SUBJECT PERFORMANCE</h2>
            </div>

        </div>


        <table class="result-table">

            <thead>

                <tr>

                    <th class="number">#</th>

                    <th class="subject">
                        SUBJECT
                    </th>

                    <th>1st TEST</th>

                    <th>2nd TEST</th>
                    <th>CA</th>

                    <th>EXAM</th>

                    <th>TOTAL</th>

                    <th>GRADE</th>

                    <th>REMARK</th>

                </tr>

            </thead>


            <tbody>

              <% result.subjects.forEach((subject, i)=>{  %>
                    <tr>

                    <td><%= i + 1 %></td>

                    <td class="subject-name">
                        <%= subject.subjectName %>
                    </td>
                    <td> <%= subject.firstTest %></td>
                    <td> <%= subject.secondTest %></td>
                    <td> <%= subject.cca %></td>
                    <td> <%= subject.exam %></td>

                    <td class="total-score"> <%= subject.total %></td>

                    <td>
                        <span class="grade grade-a"> <%= subject.grade %></span>
                    </td>

                    <td> <%= subject.remark %></td>

                </tr>
                <% }) %>
            </tbody>

        </table>

    </section>


    <!-- =====================================================
         PERFORMANCE CARDS
    ====================================================== -->

    <section class="performance-cards">

        <div class="performance-card">

            <div class="card-icon">
                ✓
            </div>

            <div>
                <span>SUBJECTS OFFERED</span>

                <strong><%= result.subjects.length %></strong>

                <small><%= (result.present + result.absent) > 0
                            ? ((result.present / (result.present + result.absent)) * 100).toFixed(1)
                            : 0
                        %>% PASS RATE</small>
            </div>

        </div>


        <div class="performance-card">

            <div class="card-icon">
                ★
            </div>

            <div>
                <span>OVERALL GRADE</span>

                <% if (result.average >= 80) { %>
                    <strong>A</strong>
                    <small>EXCELLENT</small>
                <% } else if (result.average >= 70) { %>
                    <strong>B</strong>
                    <small>VERY GOOD</small>
                <% } else if (result.average >= 60) { %>
                    <strong>C</strong>
                    <small>GOOD</small>
                <% } else if (result.average >= 50) { %>
                    <strong>D</strong>
                    <small>FAIR</small>
                <% } else if (result.average >= 40) { %>
                    <strong>E</strong>
                    <small>PASS</small>
                <% } else { %>
                    <strong>F</strong>
                    <small>FAILED</small>
                <% } %>

            </div>

        </div>


        <div class="performance-card">

            <div class="card-icon">
                %
            </div>

            <div>
                <span>AVERAGE</span>
                <strong><%= result.average %>%</strong>
            </div>

        </div>


        <div class="performance-card">

            <div class="card-icon">
                +
            </div>

            <div>
                <span>TOTAL SCORE</span>

                 <strong> <%= result.score_obtain %></strong>

            <small>OUT OF <%= result.score_obtainable %></small>
            </div>

        </div>

    </section>


    <!-- =====================================================
         ATTENDANCE
    ====================================================== -->

    <section class="attendance-section">

        <div class="section-header">

            <div class="section-number">
                02
            </div>

            <div>
                <span>STUDENT ATTENDANCE</span>
                <h2>ATTENDANCE RECORD</h2>
            </div>

        </div>


        <div class="attendance-grid">

            <div class="attendance-item">

                <span>SCHOOL DAYS</span>

                <strong><%= result.present + result.absent %></strong>

            </div>


            <div class="attendance-item">

                <span>PRESENT</span>

                <strong><%= result.present %></strong>

            </div>


            <div class="attendance-item">

                <span>ABSENT</span>

                <strong><%= result.absent %></strong>

            </div>


            <div class="attendance-item highlight">

                <span>ATTENDANCE RATE</span>

                <strong><%= (result.present + result.absent) > 0 ? ((result.present / (result.present + result.absent)) * 100).toFixed(1) : 0 %>%</strong>

            </div>

        </div>

    </section>


    <!-- =====================================================
         DEVELOPMENT
    ====================================================== -->

    <section class="development-section">

        <div class="section-header">

            <div class="section-number">
                03
            </div>

            <div>
                <span>PERSONAL DEVELOPMENT</span>
                <h2>STUDENT DEVELOPMENT</h2>
            </div>

        </div>


        <div class="development-grid">

            <div class="development-item">

                <span>Attitude to Learning</span>

                <strong><%= student.attitude %></strong>

            </div>

            <div class="development-item">

                <span>Neatness</span>

                <strong><%= student.neatness %></strong>

            </div>

            <div class="development-item">

                <span>Punctuality</span>

                <strong><%= student.punctuality %></strong>

            </div>

            <div class="development-item">

                <span>Teamwork</span>

                <strong><%= student.teamwork %></strong>

            </div>

            <div class="development-item">

                <span>Responsibility</span>

                <strong><%= student.responsibility %></strong>

            </div>

            <div class="development-item">

                <span>Leadership</span>

                <strong><%= student.leadership %></strong>

            </div>

        </div>

    </section>


    <!-- =====================================================
         COMMENTS
    ====================================================== -->

    <section class="comment-section">

        <div class="comment-card">

            <div class="comment-header">

                <span>CLASS TEACHER</span>

                <strong>COMMENT</strong>

            </div>

            <p>
                <%= result.tReport %>
            </p>

        </div>


        <div class="comment-card">

            <div class="comment-header">

                <span>SCHOOL ADMINISTRATION</span>

                <strong>COMMENT</strong>

            </div>

            <p>
                <%= result.Treport %>
            </p>

        </div>

    </section>


    <!-- =====================================================
         GRADING SCALE
    ====================================================== -->

    <section class="grading-section">

        <div class="grading-title">

            <span>GRADING SCALE</span>

        </div>


        <div class="grading-items">

            <div>
                <strong>A</strong>
                <span>80 - 100</span>
                <small>Excellent</small>
            </div>

            <div>
                <strong>B</strong>
                <span>70 - 79</span>
                <small>Very Good</small>
            </div>

            <div>
                <strong>C</strong>
                <span>60 - 69</span>
                <small>Good</small>
            </div>

            <div>
                <strong>D</strong>
                <span>50 - 59</span>
                <small>Fair</small>
            </div>

            <div>
                <strong>E</strong>
                <span>40 - 49</span>
                <small>Pass</small>
            </div>

            <div>
                <strong>F</strong>
                <span>0 - 39</span>
                <small>Fail</small>
            </div>

        </div>

    </section>


    <!-- =====================================================
         SIGNATURES
    ====================================================== -->

    <section class="signatures">

        <div class="signature">

            <div class="signature-space"></div>

            <div class="signature-line"></div>

            <strong>Class Teacher</strong>

            <span>18 December 2025</span>

        </div>


        <div class="signature">

            <div class="signature-space"></div>

            <div class="signature-line"></div>

            <strong>Principal</strong>

            <span>18 December 2025</span>

        </div>


        <div class="signature">

            <div class="signature-space"></div>

            <div class="signature-line"></div>

            <strong>Parent / Guardian</strong>

            <span>________________</span>

        </div>

    </section>


    <!-- =====================================================
         FOOTER
    ====================================================== -->

    <footer class="footer">

        <div>
            HERITAGE MODEL COLLEGE
        </div>

        <div>
            Official Academic Report • 2025 / 2026
        </div>

        <div>
            Powered by MySchoolResult
        </div>

    </footer>

</div>

</body>
</html>

