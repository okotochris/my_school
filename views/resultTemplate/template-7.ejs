
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= student.fullname %> - Result
    </title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        @page {
            size: A4;
            margin: 0;
        }

        @media print {

            body {
                background: white !important;
            }

            .no-print {
                display: none !important;
            }

            .report-sheet {
                margin: 0 !important;
                box-shadow: none !important;
            }
        }

        @media screen and (max-width: 700px) {

            .report-wrapper {
                padding: 0 !important;
            }

            .report-sheet {
                width: 100% !important;
                min-height: auto !important;
            }
        }
    </style>

</head>


<body class="bg-slate-200 text-slate-800">

    <!-- =====================================================
         DOWNLOAD / PRINT BUTTONS
    ====================================================== -->

    <div class="no-print flex justify-center gap-2 p-4 print:hidden">

        <a
            href="/result/<%= result._id %>/pdf"
            class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700"
        >
            Download PDF
        </a>

        <a
            href="/result/<%= result._id %>/image"
            class="rounded-lg bg-teal-600 px-4 py-2 text-sm font-semibold text-white hover:bg-teal-700"
        >
            Download Image
        </a>

        <button
            onclick="window.print()"
            class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
        >
            Print
        </button>

    </div>


    <!-- =====================================================
         A4 REPORT
    ====================================================== -->

    <main class="report-wrapper flex justify-center px-2 pb-10">

        <div
            class="report-sheet w-[210mm] min-h-[297mm] bg-white p-[9mm] shadow-xl"
        >


            <!-- =================================================
                 SCHOOL HEADER
            ================================================== -->

            <header class="border border-slate-300">

                <div class="flex items-center gap-5 px-5 py-4">

                    <!-- SCHOOL LOGO -->

                    <div
                        class="flex h-[72px] w-[72px] shrink-0 items-center justify-center overflow-hidden rounded-full border-2 border-slate-700 p-1"
                    >

                        <img
                            src="<%= school.logo %>"
                            alt="School Logo"
                            class="h-full w-full object-contain"
                        >

                    </div>


                    <!-- SCHOOL INFORMATION -->

                    <div class="flex-1 text-center">

                        <h1
                            class="text-[20px] font-extrabold tracking-wide text-slate-900"
                        >
                            <%= school.schoolName %>
                        </h1>

                        <% if (school.motto) { %>

                            <p
                                class="mt-1 text-[8px] font-bold uppercase tracking-widest text-teal-700"
                            >
                                <%= school.motto %>
                            </p>

                        <% } %>


                        <% if (school.address) { %>

                            <p class="mt-1 text-[7px] text-slate-500">
                                <%= school.address %>
                            </p>

                        <% } %>


                        <div class="mt-1 flex justify-center gap-3 text-[6px] text-slate-500">

                            <% if (school.phone) { %>
                                <span><%= school.phone %></span>
                            <% } %>

                            <% if (school.email) { %>
                                <span><%= school.email %></span>
                            <% } %>

                        </div>

                    </div>

                </div>


                <!-- REPORT TITLE -->

                <div class="bg-slate-900 px-4 py-2.5 text-center">

                    <p
                        class="text-[6px] font-bold uppercase tracking-[3px] text-teal-300"
                    >
                        Academic Performance Report
                    </p>

                    <h2
                        class="mt-1 text-[11px] font-bold uppercase tracking-wide text-white"
                    >
                        <%= result.term %> RESULT
                    </h2>

                    <p class="mt-0.5 text-[6px] text-slate-300">
                        <%= result.section %> Academic Session
                    </p>

                </div>

            </header>


            <!-- =================================================
                 STUDENT INFORMATION
            ================================================== -->

            <section class="mt-3 grid grid-cols-[72px_1fr] gap-3 border border-slate-300 p-2.5">


                <!-- PHOTO -->

                <div
                    class="h-[84px] w-[72px] overflow-hidden border border-slate-300 bg-slate-50 p-1"
                >

                    <img
                        src="<%= student.passport %>"
                        alt="Student Photo"
                        class="h-full w-full object-cover"
                    >

                </div>


                <!-- DETAILS -->

                <div class="flex flex-col justify-center">

                    <div class="border-b border-slate-200 pb-2">

                        <span
                            class="text-[5px] font-bold uppercase tracking-wider text-slate-500"
                        >
                            Student Name
                        </span>

                        <h2
                            class="mt-0.5 text-[13px] font-extrabold uppercase text-slate-900"
                        >
                            <%= student.fullname %>
                        </h2>

                    </div>


                    <div class="mt-2 grid grid-cols-4">

                        <div class="border-r border-slate-200 px-2 first:pl-0">

                            <span class="block text-[5px] font-bold uppercase text-slate-500">
                                Student ID
                            </span>

                            <strong class="text-[7px] text-slate-800">
                                <%= student.studentId %>
                            </strong>

                        </div>


                        <div class="border-r border-slate-200 px-2">

                            <span class="block text-[5px] font-bold uppercase text-slate-500">
                                Class
                            </span>

                            <strong class="text-[7px] text-slate-800">
                                <%= student.class %>
                            </strong>

                        </div>


                        <div class="border-r border-slate-200 px-2">

                            <span class="block text-[5px] font-bold uppercase text-slate-500">
                                Gender
                            </span>

                            <strong class="text-[7px] uppercase text-slate-800">
                                <%= student.gender %>
                            </strong>

                        </div>


                        <div class="px-2">

                            <span class="block text-[5px] font-bold uppercase text-slate-500">
                                D.O.B
                            </span>

                            <strong class="text-[7px] text-slate-800">
                                <%= student.dob %>
                            </strong>

                        </div>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 PERFORMANCE SUMMARY
            ================================================== -->

            <section class="mt-3 grid grid-cols-4 gap-2">


                <!-- AVERAGE -->

                <div class="border border-slate-300 bg-slate-50 px-2 py-2 text-center">

                    <span class="block text-[5px] font-bold uppercase tracking-wide text-slate-500">
                        Average
                    </span>

                    <strong class="mt-1 block text-[15px] font-extrabold text-teal-700">
                        <%= result.average %>%
                    </strong>

                </div>


                <!-- TOTAL -->

                <div class="border border-slate-300 bg-slate-50 px-2 py-2 text-center">

                    <span class="block text-[5px] font-bold uppercase tracking-wide text-slate-500">
                        Total Score
                    </span>

                    <strong class="mt-1 block text-[15px] font-extrabold text-slate-800">
                        <%= result.score_obtainable %>
                    </strong>

                </div>


                <!-- SUBJECTS -->

                <div class="border border-slate-300 bg-slate-50 px-2 py-2 text-center">

                    <span class="block text-[5px] font-bold uppercase tracking-wide text-slate-500">
                        Subjects Offered
                    </span>

                    <strong class="mt-1 block text-[15px] font-extrabold text-slate-800">
                        <%= result.No_subj %>
                    </strong>

                </div>


                <!-- GRADE -->

                <div class="border border-teal-700 bg-teal-700 px-2 py-2 text-center">

                    <span class="block text-[5px] font-bold uppercase tracking-wide text-teal-100">
                        Overall Grade
                    </span>


                    <% if (result.average >= 80) { %>

                        <strong class="mt-0.5 block text-[17px] font-extrabold text-white">
                            A
                        </strong>

                        <small class="text-[5px] font-bold uppercase text-teal-100">
                            Excellent
                        </small>


                    <% } else if (result.average >= 70) { %>

                        <strong class="mt-0.5 block text-[17px] font-extrabold text-white">
                            B
                        </strong>

                        <small class="text-[5px] font-bold uppercase text-teal-100">
                            Very Good
                        </small>


                    <% } else if (result.average >= 60) { %>

                        <strong class="mt-0.5 block text-[17px] font-extrabold text-white">
                            C
                        </strong>

                        <small class="text-[5px] font-bold uppercase text-teal-100">
                            Good
                        </small>


                    <% } else if (result.average >= 50) { %>

                        <strong class="mt-0.5 block text-[17px] font-extrabold text-white">
                            D
                        </strong>

                        <small class="text-[5px] font-bold uppercase text-teal-100">
                            Fair
                        </small>


                    <% } else if (result.average >= 40) { %>

                        <strong class="mt-0.5 block text-[17px] font-extrabold text-white">
                            E
                        </strong>

                        <small class="text-[5px] font-bold uppercase text-teal-100">
                            Pass
                        </small>


                    <% } else { %>

                        <strong class="mt-0.5 block text-[17px] font-extrabold text-white">
                            F
                        </strong>

                        <small class="text-[5px] font-bold uppercase text-teal-100">
                            Fail
                        </small>

                    <% } %>

                </div>

            </section>


            <!-- =================================================
                 ACADEMIC PERFORMANCE
            ================================================== -->

            <section class="mt-3">


                <div class="flex items-center justify-between border-l-4 border-teal-700 bg-slate-100 px-3 py-2">

                    <h3
                        class="text-[9px] font-extrabold uppercase tracking-wide text-slate-900"
                    >
                        Academic Performance
                    </h3>

                    <span
                        class="text-[6px] font-bold uppercase text-slate-500"
                    >
                        <%= result.term %>
                    </span>

                </div>


                <table class="w-full table-fixed border-collapse">

                    <thead>

                        <tr class="bg-slate-800 text-white">

                            <th class="w-[25px] border border-slate-600 px-1 py-1.5 text-[5px]">
                                #
                            </th>

                            <th class="w-[145px] border border-slate-600 px-2 py-1.5 text-left text-[5px]">
                                SUBJECT
                            </th>

                            <th class="border border-slate-600 px-1 py-1.5 text-[5px]">
                                CA 1
                            </th>

                            <th class="border border-slate-600 px-1 py-1.5 text-[5px]">
                                CA 2
                            </th>

                            <th class="border border-slate-600 px-1 py-1.5 text-[5px]">
                                EXAM
                            </th>

                            <th class="border border-slate-600 px-1 py-1.5 text-[5px]">
                                TOTAL
                            </th>

                            <th class="border border-slate-600 px-1 py-1.5 text-[5px]">
                                GRADE
                            </th>

                            <th class="border border-slate-600 px-1 py-1.5 text-[5px]">
                                REMARK
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        <% result.subjects.forEach((subject, index) => { %>

                            <tr class="<%= index % 2 === 0 ? 'bg-white' : 'bg-slate-50' %>">

                                <td class="border border-slate-200 px-1 py-1.5 text-center text-[6px]">
                                    <%= index + 1 %>
                                </td>


                                <td class="border border-slate-200 px-2 py-1.5 text-left text-[6.5px] font-semibold">
                                    <%= subject.subject %>
                                </td>


                                <td class="border border-slate-200 px-1 py-1.5 text-center text-[6px]">
                                    <%= subject.ca1 %>
                                </td>


                                <td class="border border-slate-200 px-1 py-1.5 text-center text-[6px]">
                                    <%= subject.ca2 %>
                                </td>


                                <td class="border border-slate-200 px-1 py-1.5 text-center text-[6px]">
                                    <%= subject.exam %>
                                </td>


                                <td class="border border-slate-200 px-1 py-1.5 text-center text-[6px] font-bold text-teal-700">
                                    <%= subject.total %>
                                </td>


                                <td class="border border-slate-200 px-1 py-1.5 text-center">

                                    <span
                                        class="inline-flex h-[18px] w-[18px] items-center justify-center rounded-full bg-slate-100 text-[6px] font-bold text-slate-800"
                                    >
                                        <%= subject.grade %>
                                    </span>

                                </td>


                                <td class="border border-slate-200 px-1 py-1.5 text-center text-[5.5px]">
                                    <%= subject.remark %>
                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </section>


            <!-- =================================================
                 ATTENDANCE + CONDUCT
            ================================================== -->

            <section class="mt-3 grid grid-cols-2 gap-3">


                <!-- ATTENDANCE -->

                <div class="border border-slate-300">

                    <div class="bg-slate-800 px-3 py-2">

                        <h3 class="text-[6px] font-bold uppercase tracking-wider text-white">
                            Attendance
                        </h3>

                    </div>


                    <div class="grid grid-cols-4">

                        <div class="border-r border-slate-200 px-1 py-2 text-center">

                            <span class="block text-[5px] text-slate-500">
                                School Days
                            </span>

                            <strong class="mt-1 block text-[10px] text-slate-800">
                                <%= result.present + result.absent %>
                            </strong>

                        </div>


                        <div class="border-r border-slate-200 px-1 py-2 text-center">

                            <span class="block text-[5px] text-slate-500">
                                Present
                            </span>

                            <strong class="mt-1 block text-[10px] text-teal-700">
                                <%= result.present %>
                            </strong>

                        </div>


                        <div class="border-r border-slate-200 px-1 py-2 text-center">

                            <span class="block text-[5px] text-slate-500">
                                Absent
                            </span>

                            <strong class="mt-1 block text-[10px] text-red-600">
                                <%= result.absent %>
                            </strong>

                        </div>


                        <div class="px-1 py-2 text-center">

                            <span class="block text-[5px] text-slate-500">
                                Attendance
                            </span>

                            <strong class="mt-1 block text-[10px] text-teal-700">

                                <%= (result.present + result.absent) > 0
                                    ? ((result.present / (result.present + result.absent)) * 100).toFixed(1)
                                    : 0
                                %>%

                            </strong>

                        </div>

                    </div>

                </div>


                <!-- CONDUCT -->

                <div class="border border-slate-300">

                    <div class="bg-slate-800 px-3 py-2">

                        <h3 class="text-[6px] font-bold uppercase tracking-wider text-white">
                            Student Conduct
                        </h3>

                    </div>


                    <div class="divide-y divide-slate-200">

                        <div class="flex justify-between px-3 py-1.5">

                            <span class="text-[5.5px] text-slate-600">
                                Attitude to Work
                            </span>

                            <strong class="text-[5.5px] text-teal-700">
                                Very Good
                            </strong>

                        </div>


                        <div class="flex justify-between px-3 py-1.5">

                            <span class="text-[5.5px] text-slate-600">
                                Neatness
                            </span>

                            <strong class="text-[5.5px] text-teal-700">
                                Excellent
                            </strong>

                        </div>


                        <div class="flex justify-between px-3 py-1.5">

                            <span class="text-[5.5px] text-slate-600">
                                Punctuality
                            </span>

                            <strong class="text-[5.5px] text-teal-700">
                                Good
                            </strong>

                        </div>


                        <div class="flex justify-between px-3 py-1.5">

                            <span class="text-[5.5px] text-slate-600">
                                Relationship with Others
                            </span>

                            <strong class="text-[5.5px] text-teal-700">
                                Excellent
                            </strong>

                        </div>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 COMMENTS
            ================================================== -->

            <section class="mt-3 grid grid-cols-2 gap-3">


                <!-- CLASS TEACHER -->

                <div class="border border-slate-300">

                    <div class="border-l-4 border-teal-700 bg-slate-100 px-3 py-2">

                        <h3 class="text-[6px] font-bold uppercase tracking-wide text-slate-800">
                            Class Teacher's Comment
                        </h3>

                    </div>


                    <p class="min-h-[55px] px-3 py-2 text-[6px] leading-relaxed text-slate-600">

                        <%= result.tReport %>

                    </p>

                </div>


                <!-- PRINCIPAL -->

                <div class="border border-slate-300">

                    <div class="border-l-4 border-teal-700 bg-slate-100 px-3 py-2">

                        <h3 class="text-[6px] font-bold uppercase tracking-wide text-slate-800">
                            Principal's Comment
                        </h3>

                    </div>


                    <p class="min-h-[55px] px-3 py-2 text-[6px] leading-relaxed text-slate-600">

                        <%= result.Treport %>

                    </p>

                </div>

            </section>


            <!-- =================================================
                 GRADING SCALE
            ================================================== -->

            <section class="mt-3 border border-slate-300">

                <div class="bg-teal-700 px-3 py-1.5">

                    <h3 class="text-[6px] font-bold uppercase tracking-wider text-white">
                        Grading Scale
                    </h3>

                </div>


                <div class="grid grid-cols-6">

                    <div class="border-r border-slate-200 py-2 text-center">

                        <strong class="block text-[9px] text-slate-800">
                            A
                        </strong>

                        <span class="block text-[5px]">
                            80 - 100
                        </span>

                        <small class="text-[4.5px] text-slate-500">
                            Excellent
                        </small>

                    </div>


                    <div class="border-r border-slate-200 py-2 text-center">

                        <strong class="block text-[9px] text-slate-800">
                            B
                        </strong>

                        <span class="block text-[5px]">
                            70 - 79
                        </span>

                        <small class="text-[4.5px] text-slate-500">
                            Very Good
                        </small>

                    </div>


                    <div class="border-r border-slate-200 py-2 text-center">

                        <strong class="block text-[9px] text-slate-800">
                            C
                        </strong>

                        <span class="block text-[5px]">
                            60 - 69
                        </span>

                        <small class="text-[4.5px] text-slate-500">
                            Good
                        </small>

                    </div>


                    <div class="border-r border-slate-200 py-2 text-center">

                        <strong class="block text-[9px] text-slate-800">
                            D
                        </strong>

                        <span class="block text-[5px]">
                            50 - 59
                        </span>

                        <small class="text-[4.5px] text-slate-500">
                            Fair
                        </small>

                    </div>


                    <div class="border-r border-slate-200 py-2 text-center">

                        <strong class="block text-[9px] text-slate-800">
                            E
                        </strong>

                        <span class="block text-[5px]">
                            40 - 49
                        </span>

                        <small class="text-[4.5px] text-slate-500">
                            Pass
                        </small>

                    </div>


                    <div class="py-2 text-center">

                        <strong class="block text-[9px] text-slate-800">
                            F
                        </strong>

                        <span class="block text-[5px]">
                            0 - 39
                        </span>

                        <small class="text-[4.5px] text-slate-500">
                            Fail
                        </small>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 SIGNATURES
            ================================================== -->

            <section class="mt-8 grid grid-cols-3 gap-8">


                <!-- CLASS TEACHER -->

                <div class="text-center">

                    <div class="flex h-[30px] items-end justify-center">

                        <% if (result.classTeacherSign) { %>

                            <img
                                src="<%= result.classTeacherSign %>"
                                alt="Class Teacher Signature"
                                class="max-h-[28px] max-w-[80px] object-contain"
                            >

                        <% } %>

                    </div>


                    <div class="border-t border-slate-700"></div>

                    <strong class="mt-1 block text-[6px]">
                        Class Teacher
                    </strong>

                    <span class="mt-0.5 block text-[5px] text-slate-500">

                        Date:
                        <%= new Date(result.createdAt).toLocaleDateString('en-GB') %>

                    </span>

                </div>


                <!-- PRINCIPAL -->

                <div class="text-center">

                    <div class="flex h-[30px] items-end justify-center">

                        <% if (school.headTeacherSign) { %>

                            <img
                                src="<%= school.headTeacherSign %>"
                                alt="Head Teacher Signature"
                                class="max-h-[28px] max-w-[80px] object-contain"
                            >

                        <% } %>

                    </div>


                    <div class="border-t border-slate-700"></div>

                    <strong class="mt-1 block text-[6px]">
                        Principal / Head Teacher
                    </strong>

                    <span class="mt-0.5 block text-[5px] text-slate-500">

                        Date:
                        <%= new Date(result.createdAt).toLocaleDateString('en-GB') %>

                    </span>

                </div>


                <!-- PARENT -->

                <div class="text-center">

                    <div class="h-[30px]"></div>

                    <div class="border-t border-slate-700"></div>

                    <strong class="mt-1 block text-[6px]">
                        Parent / Guardian
                    </strong>

                    <span class="mt-0.5 block text-[5px] text-slate-500">
                        Date: __________________
                    </span>

                </div>

            </section>


            <!-- =================================================
                 FOOTER
            ================================================== -->

            <footer
                class="mt-5 flex justify-between border-t-2 border-slate-800 pt-2 text-[5px] text-slate-500"
            >

                <span class="font-bold text-slate-700">
                    <%= school.schoolName %>
                </span>

                <span>
                    <%= result.term %> • <%= result.section %>
                </span>

                <span>
                    Powered by MySchoolResult
                </span>

            </footer>


        </div>

    </main>

</body>

</html>

