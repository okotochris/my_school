<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= school.fullname %> - Result</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/styles/results/template-7.css">
</head>

<body>
    
<div class="no-print flex justify-center gap-2 p-4 print:hidden">

    <a
        href="/result/<%= result._id %>/pdf"
        class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700"
    >
        Download PDF
    </a>

    <a
        href="/result/<%= result._id %>/image"
        class="rounded-lg bg-teal-600 px-4 py-2 text-sm font-semibold text-white hover:bg-teal-700"
    >
        Download Image
    </a>

    <button
        onclick="window.print()"
        class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
    >
        Print
    </button>

</div>
<div class="report-sheet">

    <!-- =====================================================
         SCHOOL HEADER
    ====================================================== -->

    <header class="school-header">

        <div class="school-brand">

            <div class="logo-container">
                <img
                      src="<%= school.image.logo %>"
                    alt="School Logo"
                >
            </div>

            <div class="school-details">

                <div class="school-label">
                    OFFICIAL ACADEMIC RECORD
                </div>

                <h1>
                    <%= school.name %>
                </h1>

                <p>
                    <%= school.address %>
                </p>

                <p>
                    <%= school.phone %> · <%= school.email %>
                </p>

                <div class="school-motto">
                    <%= school.motto %>
                </div>

            </div>

            <div class="report-badge">

                <span>STUDENT</span>

                <strong>REPORT</strong>

                <small>CARD</small>

            </div>

        </div>

    </header>


    <!-- =====================================================
         ACADEMIC SESSION
    ====================================================== -->

    <div class="academic-bar">

        <div>
            <span>SESSION</span>
            <strong><%= result.session %></strong>
        </div>

        <div>
            <span>TERM</span>
            <strong><%= result.term %></strong>
        </div>

        <div>
            <span>CLASS</span>
             <strong><%= result.studentClass %></strong>
        </div>

        <div>
            <span>STATUS</span>
            <strong>COMPLETED</strong>
        </div>

    </div>


    <!-- =====================================================
         STUDENT PROFILE
    ====================================================== -->

    <section class="student-profile">

        <div class="profile-photo">

            <img
                src="<%= student.passport %>"
                alt="Student Photo"
            >

        </div>


        <div class="student-details">

            <span class="section-label">
                STUDENT INFORMATION
            </span>

            <h2>
                <%= result.studentName %>
            </h2>

            <div class="student-grid">

                <div>
                    <span>STUDENT ID</span>
                    <strong><%= result.studentId %></strong>
                </div>

                <div>
                    <span>CLASS</span>
                    <strong><%= result.className %></strong>
                </div>

                <div>
                    <span>GENDER</span>
                    <strong><%= result.gender %></strong>
                </div>

                <div>
                    <span>TERM</span>
                    <strong><%= result.term %></strong>
                </div>

            </div>

        </div>


        <div class="overall-score">

            <span>AVERAGE SCORE</span>

            <strong>
                <%= result.average %>
            </strong>

            <small>
                OUT OF 100
            </small>

        </div>

    </section>


    <!-- =====================================================
         RESULTS HEADER
    ====================================================== -->

    <div class="section-heading">

        <div class="heading-number">
            01
        </div>

        <div>
            <span>ACADEMIC PERFORMANCE</span>
            <h3>SUBJECT RESULTS</h3>
        </div>

    </div>


    <!-- =====================================================
         RESULT TABLE
    ====================================================== -->

    <section class="result-table-wrapper">

        <table class="result-table">

            <thead>

                <tr>

                    <th class="sn">NO.</th>

                    <th class="subject">
                        SUBJECT
                    </th>

                    <th>
                        FIRST TEST
                       
                    </th>
                    <th>
                        SECONDT TEST
                       
                    </th>
                     <th>
                        C.A TEST
                       
                    </th>

                    <th>
                        EXAM
                        
                    </th>

                    <th>
                        TOTAL
                       
                    </th>

                    <th>
                        GRADE
                    </th>

                    <th>
                        REMARK
                    </th>

                </tr>

            </thead>

            <tbody>

                <% result.subjects.forEach((subject, index) => { %>

                    <tr>

                        <td>
                            <%= String(index + 1).padStart(2, '0') %>
                        </td>

                        <td class="subject">
                            <%= subject.subjectName %>
                        </td>

                        <td>
                            <%= subject.firstTest %>
                        </td>

                        <td>
                            <%= subject.secondTest %>
                        </td>

                        <td>
                            <%= subject.cca %>
                        </td>

                        <td>
                            <%= subject.exam %>
                        </td>

                        <td class="total">
                            <%= subject.total %>
                        </td>

                        <td>

                            <span class="grade <%= subject.gradeClass %>">
                                <%= subject.grade %>
                            </span>

                        </td>

                        <td class="remark">
                            <%= subject.remark %>
                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    </section>


    <!-- =====================================================
         PERFORMANCE SUMMARY
    ====================================================== -->

    <section class="performance-summary">

        <div class="summary-card">

            <span>TOTAL SCORE</span>

            <strong>
               <%= result.score_obtainable %>
            </strong>

            <small>
                CUMULATIVE
            </small>

        </div>
        <div class="summary-card">

            <span>SCORE OBTAINED</span>

            <strong>
               <%= result.score_obtain %>
            </strong>

            <small>
                CUMULATIVE
            </small>

        </div>

        <div class="summary-card">

            <span>AVERAGE</span>

            <strong>
                <%= result.average %>
            </strong>

            <small>
                PERCENT
            </small>

        </div>

        <div class="summary-card">

            <span>SUBJECTS</span>

            <strong>
                <%= result.subjects.length %>
            </strong>

            <small>
                OFFERED
            </small>

        </div>

    </section>


    <!-- =====================================================
         ATTENDANCE + CONDUCT
    ====================================================== -->

    <section class="information-panels">


        <!-- ATTENDANCE -->

        <div class="information-panel">

            <div class="panel-heading">

                <span>02</span>

                <strong>ATTENDANCE RECORD</strong>

            </div>

            <div class="attendance-grid">

                <div>
                    <span>SCHOOL DAYS</span>
                    <strong><%= result.present + result.absent %></strong>
                </div>

                <div>
                    <span>PRESENT</span>
                    <strong><%= result.present %></strong>
                </div>

                <div>
                    <span>ABSENT</span>
                    <strong><%= result.absent %></strong>
                </div>

                <div>
                    <span>PERCENTAGE</span>
                    <strong><%= (result.present + result.absent) > 0
                            ? ((result.present / (result.present + result.absent)) * 100).toFixed(1)
                            : 0
                        %>%</strong>
                </div>

            </div>

        </div>


        <!-- CONDUCT -->

        <div class="information-panel">

            <div class="panel-heading">

                <span>03</span>

                <strong>STUDENT DEVELOPMENT</strong>

            </div>

            <div class="conduct-list">

                <div>
                    <span>Punctuality</span>
                    <strong><%= student.punctuality %></strong>
                </div>

                <div>
                    <span>Neatness</span>
                    <strong><%= student.neatness %></strong>
                </div>

                <div>
                    <span>Class Participation</span>
                    <strong><%= student.participation %></strong>
                </div>

                <div>
                    <span>Relationship With Others</span>
                    <strong><%= student.relationship %></strong>
                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         COMMENTS
    ====================================================== -->

    <section class="comments-section">

        <div class="comment-box">

            <div class="comment-heading">

                <span>04</span>

                <strong>CLASS TEACHER'S COMMENT</strong>

            </div>

            <p>
                <%= result.tReport %>
            </p>

        </div>


        <div class="comment-box">

            <div class="comment-heading">

                <span>05</span>

                <strong>HEAD TEACHER'S COMMENT</strong>

            </div>

            <p>
                <%= result.Treport %>
            </p>

        </div>

    </section>


    <!-- =====================================================
         GRADING SCALE
    ====================================================== -->

    <section class="grading-section">

        <div class="grading-heading">
            GRADING SCALE
        </div>

        <div class="grading-table">

            <div>
                <strong>A</strong>
                <span>Excellent</span>
                <small>80 - 100</small>
            </div>

            <div>
                <strong>B</strong>
                <span>Very Good</span>
                <small>70 - 79</small>
            </div>

            <div>
                <strong>C</strong>
                <span>Good</span>
                <small>60 - 69</small>
            </div>

            <div>
                <strong>D</strong>
                <span>Fair</span>
                <small>50 - 59</small>
            </div>

            <div>
                <strong>E</strong>
                <span>Pass</span>
                <small>40 - 49</small>
            </div>

            <div>
                <strong>F</strong>
                <span>Fail</span>
                <small>0 - 39</small>
            </div>

        </div>

    </section>


    <!-- =====================================================
         SIGNATURES
    ====================================================== -->

    <section class="signature-section">

        <div class="signature">

            <div class="signature-space">
                <% if (result.teacherSignature) { %>
                    <img src="<%= result.teacherSignature %>" alt="Teacher Signature">
                <% } %>
            </div>

            <div class="signature-line"></div>

            <strong>CLASS TEACHER</strong>

            <span>Signature</span>

        </div>


        <div class="signature">

            <div class="signature-space">
                <% if (result.principalSignature) { %>
                    <img src="<%= result.principalSignature %>" alt="Principal Signature">
                <% } %>
            </div>

            <div class="signature-line"></div>

            <strong>HEAD TEACHER</strong>

            <span>Signature</span>

        </div>


        <div class="signature">

            <div class="signature-space"></div>

            <div class="signature-line"></div>

            <strong>PARENT / GUARDIAN</strong>

            <span>Signature</span>

        </div>

    </section>


    <!-- =====================================================
         FOOTER
    ====================================================== -->

    <footer class="report-footer">

        <span>
            OFFICIAL SCHOOL REPORT
        </span>

        <span>
            Generated by MySchoolResult
        </span>

        <span>
            <%= result.session %>
        </span>

    </footer>

</div>

</body>
</html>