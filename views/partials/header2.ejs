 <script src="https://cdn.tailwindcss.com"></script>

<script>
    let deferredPrompt = null;

    const installAppBtn =
        document.getElementById("installAppBtn");

    const installAppBtnMobile =
        document.getElementById("installAppBtnMobile");


    /*
     * Browser provides the installation prompt
     */
    window.addEventListener("beforeinstallprompt", (event) => {

        console.log("MySchoolResult can be installed.");

        // Prevent Chrome from showing its own prompt automatically
        event.preventDefault();

        // Save the installation event
        deferredPrompt = event;

    });


    /*
     * Install function
     */
    async function installMySchoolResult() {

        /*
         * If browser installation prompt is available
         */
        if (deferredPrompt) {

            deferredPrompt.prompt();

            const { outcome } =
                await deferredPrompt.userChoice;

            console.log(
                "Installation result:",
                outcome
            );

            /*
             * The browser prompt can only be used once.
             */
            deferredPrompt = null;

            return;
        }


        /*
         * If the browser doesn't currently
         * provide the native installation prompt
         */
        alert(
            "To install MySchoolResult, open your browser menu and select \"Install app\" or \"Add to Home screen\"."
        );

    }


    /*
     * Desktop button
     */
    if (installAppBtn) {

        installAppBtn.addEventListener(
            "click",
            installMySchoolResult
        );

    }


    /*
     * Mobile button
     */
    if (installAppBtnMobile) {

        installAppBtnMobile.addEventListener(
            "click",
            installMySchoolResult
        );

    }


    /*
     * App successfully installed
     */
    window.addEventListener("appinstalled", () => {

        console.log(
            "MySchoolResult has been installed."
        );

        deferredPrompt = null;

    });
</script>

