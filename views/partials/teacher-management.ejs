<div class="bg-white rounded-3xl shadow-sm p-8">


    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-4xl font-bold text-slate-800">🏫 Class Management</h1>
            <p class="text-slate-500 mt-2">Assign class teachers and manage subjects</p>
        </div>
    </div>

   <form id="formData">
 <div class="grid lg:grid-cols-12 gap-8">

        <!-- Left: Class List & Assignment -->
        <div class="lg:col-span-7">

            <div class="bg-white rounded-3xl shadow-sm p-8 mb-8">
                <h2 class="text-2xl font-bold mb-6">Assign Class Teacher</h2>
                <div class="loading"></div>

                <div class="grid md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium mb-2">Select Class</label>
                        <select id="classSelect" class="w-full rounded-2xl border border-gray-300 px-5 py-4">
                            <option value="">Select Class</option>
                            <option>PRE NURSERY</option>
                            <option>NURSERY 1</option>
                            <option>NURSERY 2</option>
                            <option>NURSERY 3</option>
                            <option>BASIC 1</option>
                            <option>BASIC 2</option>
                            <option>BASIC 3</option>
                            <option>BASIC 4</option>
                            <option>BASIC 5</option>
                            <option>BASIC 6</option>
                            <option>JSS 1</option>
                            <option>JSS 2</option>
                            <option>JSS 3</option>
                            <option>SS 1</option>
                            <option>SS 2</option>
                            <option>SS 3</option>
                        </select>
                    </div>

                      <div>
                        <label class="block text-sm font-medium mb-2">Assign Teacher</label>
                        <select id="teacherSelect" class="w-full rounded-2xl border border-gray-300 px-5 py-4">
                            <option value="">Select Teacher</option>
                            
                        </select>
                    </div>
                </div>

                <!-- Teacher Preview -->
                <div class="mt-8 bg-slate-50 rounded-2xl p-6 flex items-center gap-6" id="teacherPreview">
                    <div class="w-20 h-20 bg-gray-200 rounded-2xl flex items-center justify-center text-3xl">
                        👤</div>
                    <div>
                        <p class="font-semibold text-lg">No teacher assigned yet</p>
                        <p class="text-gray-500">Select a class and teacher above</p>
                    </div>
                </div>
            </div>

            <!-- Subjects Offered -->
            <div class="bg-white rounded-3xl shadow-sm p-8">
                <h2 class="text-2xl font-bold mb-6">Subjects Offered</h2>

                <div class="flex gap-3 mb-6">
                    <input type="text" id="subjectInput" placeholder="Add new subject (e.g. Physics)"
                        class="flex-1 rounded-2xl border border-gray-300 px-5 py-4">
                    <button onclick="addSubject()"
                        class="bg-blue-600 text-white px-8 rounded-2xl font-semibold hover:bg-blue-700">
                        Add Subject
                    </button>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-3 gap-4" id="subjectsList">
                    <!-- Added subjects appear here -->
                </div>
            </div>
        </div>

        <!-- Right Sidebar: Class Teacher Details -->
        <div class="lg:col-span-5">
            <div class="bg-white rounded-3xl shadow-sm p-8 sticky top-6">
                <h2 class="text-2xl font-bold mb-6">Class Teacher Details</h2>

                <div class="space-y-8">
                    <!-- Passport -->
                    <div>
                        <label class="block text-sm font-medium mb-3">Passport
                            Photograph</label>
                        <div class="border-2 border-dashed border-gray-300 rounded-2xl p-8 text-center">
                            <input type="file" id="passport" accept="image/*" class="hidden"
                                onchange="previewImage(this, 'passportPreview')">
                            <div onclick="document.getElementById('passport').click()"
                                class="text-blue-600 hover:text-blue-700 font-medium cursor-pointer">
                                Upload Passport
                        </div>
                            <img id="passportPreview" class="hidden mx-auto mt-4 w-28 h-28 object-cover rounded-2xl">
                        </div>
                    </div>

                    <!-- Signature -->
                    <div>
                        <label class="block text-sm font-medium mb-3">Signature</label>
                        <div class="border-2 border-dashed border-gray-300 rounded-2xl p-8 text-center">
                            <input type="file" id="signature" accept="image/*" class="hidden"
                                onchange="previewImage(this, 'signaturePreview')">
                            <div onclick="document.getElementById('signature').click()"
                                class="text-blue-600 hover:text-blue-700 font-medium cursor-pointer">
                                Upload Signature
                        </div>
                            <img id="signaturePreview" class="hidden mx-auto mt-4 h-20 object-contain">
                        </div>
                    </div>

                    <div class="pt-6 border-t">
                        <button onclick="saveClassTeacher()"
                            class="w-full bg-green-600 hover:bg-green-700 text-white py-5 rounded-2xl font-semibold text-lg">
                            Save Class Teacher Information
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
   </form>
</div>
</div>

<script>
    const loading = document.querySelector('.loading');
    (async ()=>{
        loading.style.display= 'block'
        try{
            const data = await fetch('/api/teachers')
            if(!data.ok){
                console.log("something went wrong")
                return
            }
            const {teachers} =  await data.json()
            document.getElementById('teacherSelect').innerHTML = teachers.map(teacher => 
            `<option value="${teacher.id}">${teacher.user_name}</option>`).join('') 

        }catch(err){
            console.log(err)
        }finally{
            loading.style.display = 'none'
        }
    })()
    function previewImage(input, previewId) {
    const file = input.files[0];

    if (file) {
        const preview = document.getElementById(previewId);

        preview.src = URL.createObjectURL(file);
        preview.style.display = "block";
    }
}

async function saveClassTeacher() {
     e.preventDefault();

  const data = new FormData(form);

  try {
    const response = await fetch("/api/assign-class-teacher", {
      method: "PATCH",
      body: data,
    });

    const result = await response.json();

    console.log(result);
  } catch (error) {
    console.error(error);
  }
}   
</script>