<!-- Flutterwave -->
<script src="https://checkout.flutterwave.com/v3.js"></script>

<script>
  lucide.createIcons();

  function toggleUpdate() {
    const menu = document.getElementById("updateMenu");
    const arrow = document.getElementById("updateArrow");

    menu.classList.toggle("hidden");
    arrow.classList.toggle("rotate-180");
  }

  const buttonId = document.getElementById('button');

  async function makePayment() {
    buttonId.innerText = "Loading..";
    buttonId.disabled = true;

    try {
      const res = await fetch('/payment/schoolinfo');

      if (!res.ok) throw new Error("Unable to retrieve school payment details");

      const schoolDetails = await res.json();
      const { schoolEmail, schoolName, headTeacher, fees } = schoolDetails;

      if (Number(fees) < 70) {
        alert("No payment is currently required.");
        return;
      }

      const amountInNumber = Number(fees);

      const meta = {
        schoolName,
        amount: amountInNumber,
        staffName: headTeacher?.name || "School Admin",
        refId: `${schoolName || "School Admin"}${Date.now()}`
      };

      FlutterwaveCheckout({
        public_key: "FLWPUBK-f8514622db2e398152c1a94f24a478a5-X",
        tx_ref: "SCHL-" + Date.now(),
        amount: amountInNumber,
        currency: "NGN",
        payment_options: "card,ussd,banktransfer",

        customer: {
          email: schoolEmail,
          name: headTeacher?.name || "School Admin"
        },

        callback: async function () {
          try {
            schoolDetails.meta = meta;

            const response = await fetch("/api/payment-callback", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(schoolDetails)
            });

            if (!response.ok) throw new Error("Unable to update payment status");

            await response.json();

            document.getElementById('fee').innerText = "0";
            alert("Payment successful!");

          } catch (err) {
            console.error(err);
            alert("Payment was received, but we could not update the dashboard.");
          } finally {
            buttonId.disabled = false;
            buttonId.innerText = "Make Payment";
          }
        },

        onclose: function () {
          buttonId.disabled = false;
          buttonId.innerText = "Make Payment";
        }
      });

    } catch (err) {
      console.error(err);
      alert("Unable to process payment. Please try again.");
      buttonId.disabled = false;
      buttonId.innerText = "Make Payment";
    }
  }
</script>
