<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Student Profile</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <link rel="stylesheet" href="/styles/global.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#0b2a4a',
                        secondary: '#17619a'
                    }
                }
            }
        }
    </script>
</head>

<body class="bg-slate-50 text-slate-800">
    <%- include("./partials/header.ejs") %>
        <div class="admin-container">
            <%- include("./partials/navigation.ejs") %>
                <div class="w-full mx-5 px-4 py-6">

                    <!-- =========================================
                        PROFILE HEADER
                    ========================================== -->

                    <div
                        class="bg-gradient-to-r from-primary to-secondary rounded-2xl p-5 sm:p-7 text-white shadow-lg mb-5">

                        <div class="flex flex-col sm:flex-row items-center sm:items-center justify-between gap-6">

                            <!-- STUDENT -->
                            <div class="flex flex-col sm:flex-row items-center gap-5 text-center sm:text-left">

                                <img class="w-28 h-28 rounded-2xl object-cover border-4 border-white/80 bg-white"
                                    src="<%= student.passport || 'https://via.placeholder.com/150' %>"
                                    alt="Student Passport">

                                <div>
                                    <h1 class="text-2xl sm:text-3xl font-bold">
                                        <%= student.fullname %>
                                    </h1>

                                    <p class="text-white/80 text-sm mt-1">
                                        Student ID: <%= student.studentId %>
                                    </p>

                                    <div class="flex flex-wrap justify-center sm:justify-start gap-2 mt-3">

                                        <span class="px-3 py-1 rounded-full bg-white/15 text-xs">
                                            <%= student.class || 'Class not set' %>
                                        </span>

                                        <span class="px-3 py-1 rounded-full bg-white/15 text-xs">
                                            <%= student.schoolsession || 'Session not set' %>
                                        </span>

                                    </div>
                                </div>

                            </div>


                            <!-- SCHOOL -->
                            <div class="text-center sm:text-right">

                               

                            </div>

                        </div>

                    </div>


                    <!-- =========================================
         QUICK INFORMATION
    ========================================== -->

                    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-5">

                        <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm">
                            <p class="text-xs text-slate-500">Admission Number</p>
                            <p class="font-semibold text-primary mt-1">
                                <%= student.addmissionNo || 'N/A' %>
                            </p>
                        </div>

                        <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm">
                            <p class="text-xs text-slate-500">Class</p>
                            <p class="font-semibold text-primary mt-1">
                                <%= student.class || 'N/A' %>
                            </p>
                        </div>

                        <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm">
                            <p class="text-xs text-slate-500">Gender</p>
                            <p class="font-semibold text-primary mt-1">
                                <%= student.gender || 'N/A' %>
                            </p>
                        </div>

                        <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm">
                            <p class="text-xs text-slate-500">Date of Birth</p>
                            <p class="font-semibold text-primary mt-1">
                                <%= student.dob || 'N/A' %>
                            </p>
                        </div>

                    </div>


                    <!-- =========================================
         PERSONAL INFORMATION
    ========================================== -->

                    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm mb-5">

                        <div class="flex items-center gap-3 mb-5">

                            <div class="w-1 h-6 bg-secondary rounded-full"></div>

                            <h2 class="font-bold text-lg text-primary">
                                Personal Information
                            </h2>

                        </div>


                        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">

                            <!-- Fullname -->
                            <div class="bg-slate-50 rounded-xl p-4">
                                <p class="text-xs uppercase tracking-wide text-slate-500">
                                    Full Name
                                </p>
                                <p class="font-semibold mt-1">
                                    <%= student.fullname || 'N/A' %>
                                </p>
                            </div>


                            <!-- Student ID -->
                            <div class="bg-slate-50 rounded-xl p-4">
                                <p class="text-xs uppercase tracking-wide text-slate-500">
                                    Student ID
                                </p>
                                <p class="font-semibold mt-1">
                                    <%= student.studentId || 'N/A' %>
                                </p>
                            </div>


                            <!-- Admission -->
                            <div class="bg-slate-50 rounded-xl p-4">
                                <p class="text-xs uppercase tracking-wide text-slate-500">
                                    Admission Number
                                </p>
                                <p class="font-semibold mt-1">
                                    <%= student.addmissionNo || 'N/A' %>
                                </p>
                            </div>


                            <!-- DOB -->
                            <div class="bg-slate-50 rounded-xl p-4">
                                <p class="text-xs uppercase tracking-wide text-slate-500">
                                    Date of Birth
                                </p>
                                <p class="font-semibold mt-1">
                                    <%= student.dob || 'N/A' %>
                                </p>
                            </div>


                            <!-- Gender -->
                            <div class="bg-slate-50 rounded-xl p-4">
                                <p class="text-xs uppercase tracking-wide text-slate-500">
                                    Gender
                                </p>
                                <p class="font-semibold mt-1">
                                    <%= student.gender || 'N/A' %>
                                </p>
                            </div>


                            <!-- School Session -->
                            <div class="bg-slate-50 rounded-xl p-4">
                                <p class="text-xs uppercase tracking-wide text-slate-500">
                                    School Session
                                </p>
                                <p class="font-semibold mt-1">
                                    <%= student.schoolsession || 'N/A' %>
                                </p>
                            </div>

                        </div>

                    </div>


                    <!-- =========================================
         CONTACT INFORMATION
    ========================================== -->

                    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm mb-5">

                        <div class="flex items-center gap-3 mb-5">

                            <div class="w-1 h-6 bg-secondary rounded-full"></div>

                            <h2 class="font-bold text-lg text-primary">
                                Contact & Address
                            </h2>

                        </div>


                        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">

                            <div class="bg-slate-50 rounded-xl p-4">
                                <p class="text-xs uppercase tracking-wide text-slate-500">
                                    Email
                                </p>
                                <p class="font-semibold mt-1 break-words">
                                    <%= student.email || 'N/A' %>
                                </p>
                            </div>


                            <div class="bg-slate-50 rounded-xl p-4">
                                <p class="text-xs uppercase tracking-wide text-slate-500">
                                    Country
                                </p>
                                <p class="font-semibold mt-1">
                                    <%= student.country || 'N/A' %>
                                </p>
                            </div>


                            <div class="bg-slate-50 rounded-xl p-4">
                                <p class="text-xs uppercase tracking-wide text-slate-500">
                                    State
                                </p>
                                <p class="font-semibold mt-1">
                                    <%= student.state || 'N/A' %>
                                </p>
                            </div>


                            <div class="bg-slate-50 rounded-xl p-4 sm:col-span-2">
                                <p class="text-xs uppercase tracking-wide text-slate-500">
                                    Address
                                </p>
                                <p class="font-semibold mt-1">
                                    <%= student.address || 'N/A' %>
                                </p>
                            </div>


                            <div class="bg-slate-50 rounded-xl p-4">
                                <p class="text-xs uppercase tracking-wide text-slate-500">
                                    House
                                </p>
                                <p class="font-semibold mt-1">
                                    <%= student.house || 'N/A' %>
                                </p>
                            </div>

                        </div>

                    </div>


                    <!-- =========================================
         GUARDIAN INFORMATION
    ========================================== -->

                    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm mb-5">

                        <div class="flex items-center gap-3 mb-5">

                            <div class="w-1 h-6 bg-secondary rounded-full"></div>

                            <h2 class="font-bold text-lg text-primary">
                                Guardian Information
                            </h2>

                        </div>


                        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">

                            <div class="bg-slate-50 rounded-xl p-4">
                                <p class="text-xs text-slate-500 uppercase">
                                    Name
                                </p>
                                <p class="font-semibold mt-1">
                                    <%= student.guardian?.name || 'N/A' %>
                                </p>
                            </div>


                            <div class="bg-slate-50 rounded-xl p-4">
                                <p class="text-xs text-slate-500 uppercase">
                                    Relationship
                                </p>
                                <p class="font-semibold mt-1">
                                    <%= student.guardian?.relationship || 'N/A' %>
                                </p>
                            </div>


                            <div class="bg-slate-50 rounded-xl p-4">
                                <p class="text-xs text-slate-500 uppercase">
                                    Phone
                                </p>
                                <p class="font-semibold mt-1">
                                    <%= student.guardian?.phone || 'N/A' %>
                                </p>
                            </div>


                            <div class="bg-slate-50 rounded-xl p-4">
                                <p class="text-xs text-slate-500 uppercase">
                                    Email
                                </p>
                                <p class="font-semibold mt-1 break-words">
                                    <%= student.guardian?.email || 'N/A' %>
                                </p>
                            </div>


                            <div class="bg-slate-50 rounded-xl p-4">
                                <p class="text-xs text-slate-500 uppercase">
                                    State
                                </p>
                                <p class="font-semibold mt-1">
                                    <%= student.guardian?.state || 'N/A' %>
                                </p>
                            </div>


                            <div class="bg-slate-50 rounded-xl p-4">
                                <p class="text-xs text-slate-500 uppercase">
                                    LGA
                                </p>
                                <p class="font-semibold mt-1">
                                    <%= student.guardian?.lga || 'N/A' %>
                                </p>
                            </div>


                            <div class="bg-slate-50 rounded-xl p-4 sm:col-span-2 lg:col-span-3">
                                <p class="text-xs text-slate-500 uppercase">
                                    Address
                                </p>
                                <p class="font-semibold mt-1">
                                    <%= student.guardian?.address || 'N/A' %>
                                </p>
                            </div>

                        </div>

                    </div>


                    <!-- =========================================
         EMERGENCY CONTACT
    ========================================== -->

                    <div class="bg-white border border-red-100 rounded-2xl p-5 shadow-sm mb-5">

                        <div class="flex items-center gap-3 mb-5">

                            <div class="w-1 h-6 bg-red-500 rounded-full"></div>

                            <h2 class="font-bold text-lg text-red-700">
                                Emergency Contact
                            </h2>

                        </div>


                        <div class="grid sm:grid-cols-2 gap-4">

                            <div class="bg-red-50 rounded-xl p-4">
                                <p class="text-xs uppercase tracking-wide text-red-500">
                                    Name
                                </p>

                                <p class="font-semibold mt-1">
                                    <%= student.emergencyContact?.name || 'N/A' %>
                                </p>
                            </div>


                            <div class="bg-red-50 rounded-xl p-4">
                                <p class="text-xs uppercase tracking-wide text-red-500">
                                    Phone
                                </p>

                                <p class="font-semibold mt-1">
                                    <%= student.emergencyContact?.phone || 'N/A' %>
                                </p>
                            </div>

                        </div>

                    </div>


                    <!-- =========================================
         PERFORMANCE
    ========================================== -->

                    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm mb-5">

                        <div class="flex items-center justify-between mb-5">

                            <div class="flex items-center gap-3">

                                <div class="w-1 h-6 bg-secondary rounded-full"></div>

                                <h2 class="font-bold text-lg text-primary">
                                    Academic Performance
                                </h2>

                            </div>

                        </div>

                        <div class="h-[320px]">
                            <canvas id="performanceChart"></canvas>
                        </div>

                    </div>


                    <!-- =========================================
         RESULTS
    ========================================== -->

                    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">

                        <div class="flex items-center gap-3 mb-5">

                            <div class="w-1 h-6 bg-secondary rounded-full"></div>

                            <h2 class="font-bold text-lg text-primary">
                                Student Results
                            </h2>

                        </div>


                        <div class="results-list grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        </div>

                    </div>

                </div>


                <!-- =========================================
     DELETE MODAL
========================================== -->

                <div
                    class="cover-del-model fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden items-center justify-center px-4">

                    <div class="bg-white rounded-2xl p-6 w-full max-w-md shadow-2xl">

                        <h2 class="text-xl font-bold text-slate-800">
                            Delete Result
                        </h2>

                        <p class="text-sm text-slate-500 mt-2">
                            This will permanently delete the selected result.
                        </p>

                        <div class="flex gap-3 mt-6">

                            <button onclick="document.querySelector('.cover-del-model').style.display='none'"
                                class="flex-1 px-4 py-3 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50">
                                Cancel
                            </button>

                            <button onclick="detResult()"
                                class="flex-1 px-4 py-3 rounded-xl bg-red-600 text-white hover:bg-red-700">
                                Delete
                            </button>

                        </div>

                    </div>

                </div>


                <!-- =========================================
     LOADING
========================================== -->

                <div
                    class="cover fixed inset-0 bg-white/60 backdrop-blur-sm z-[100] hidden items-center justify-center">

                    <div class="w-12 h-12 border-4 border-slate-200 border-t-secondary rounded-full animate-spin">
                    </div>

                </div>
        </div>


        <script>

            /* =========================================
               LOAD RESULTS
            ========================================== */

            document.addEventListener('DOMContentLoaded', () => {

                getResult('<%= student.studentId %>');

            });


            async function getResult(studentId) {

                document.querySelector('.cover').style.display = 'flex';

                try {

                    const response =
                        await fetch(`/api/get_result?studentId=${studentId}`);

                    const data = await response.json();

                    resultAnalysisA(data);

                } catch (err) {

                    console.error("Error fetching result:", err);

                } finally {

                    document.querySelector('.cover').style.display = 'none';

                }

            }


            /* =========================================
               RESULT ANALYSIS
            ========================================== */

            let resultDetails = null;

            function resultAnalysisA(data) {

                const labels = [];
                const scores = [];

                data.forEach(res => {

                    labels.push(res.term);
                    scores.push(res.average);

                });


                const ctx =
                    document.getElementById('performanceChart').getContext('2d');


                new Chart(ctx, {

                    type: 'line',

                    data: {

                        labels,

                        datasets: [{

                            label: 'Average Score',

                            data: scores,

                            borderColor: '#17619a',

                            backgroundColor: 'rgba(23, 97, 154, .10)',

                            fill: true,

                            tension: .4

                        }]

                    },

                    options: {

                        responsive: true,

                        maintainAspectRatio: false,

                        plugins: {

                            legend: {
                                labels: {
                                    color: '#334155'
                                }
                            }

                        },

                        scales: {

                            x: {
                                ticks: {
                                    color: '#64748b'
                                }
                            },

                            y: {

                                beginAtZero: true,

                                ticks: {
                                    color: '#64748b'
                                }

                            }

                        }

                    }

                });


                renderResults(data);

            }


            /* =========================================
               RENDER RESULTS
            ========================================== */

            function renderResults(data) {

                const container =
                    document.querySelector('.results-list');

                let html = '';


                if (!data || data.length === 0) {

                    container.innerHTML = `
                <div class="col-span-full text-center py-10">

                    <p class="text-slate-500">
                        No results available yet.
                    </p>

                </div>
            `;

                    return;

                }


                data.forEach(item => {

                    const status =
                        item.average >= 50 ? 'pass' : 'fail';


                    html += `

                <div class="relative bg-white border border-slate-200 rounded-2xl p-5 shadow-sm hover:shadow-md transition overflow-hidden">

                    <div class="absolute top-0 left-0 right-0 h-1
                        bg-gradient-to-r from-primary to-secondary">
                    </div>


                    <div class="flex justify-between gap-4 mb-5">

                        <div>

                            <p class="font-bold text-primary">
                                ${item.term}
                            </p>

                            <p class="text-xs text-slate-500 mt-1">
                                ${item.studentClass || ''}
                            </p>

                            <p class="text-xs text-slate-500 mt-1">
                                ${item.section || ''}
                            </p>

                        </div>


                        <div class="text-right">

                            <p class="text-2xl font-bold text-secondary">
                                ${item.average}
                            </p>

                            <span class="
                                inline-block
                                mt-1
                                px-2 py-1
                                rounded-full
                                text-[10px]
                                font-bold
                                ${status === 'pass'
                            ? 'bg-green-100 text-green-700'
                            : 'bg-red-100 text-red-700'}
                            ">
                                ${status.toUpperCase()}
                            </span>

                        </div>

                    </div>


                    <div class="flex gap-2">

                        <button
                            class="
                                flex-1
                                px-3 py-2.5
                                rounded-xl
                                bg-primary
                                text-white
                                text-sm
                                font-medium
                                hover:bg-secondary
                                transition
                            "
                            onclick="viewResult(
                                '${item.studentId}',
                                '${item.term}',
                                '${item.studentClass}',
                                '${item.schoolName}'
                            )"
                        >
                            View Result
                        </button>


                        <button
                            class="
                                px-3 py-2.5
                                rounded-xl
                                bg-red-50
                                text-red-600
                                text-sm
                                font-medium
                                hover:bg-red-100
                                transition
                            "
                            onclick="delAction(
                                '${item._id}',
                                '${item.studentClass}'
                            )"
                        >
                            Delete
                        </button>

                    </div>

                </div>

            `;

                });


                container.innerHTML = html;

            }


            /* =========================================
               VIEW RESULT
            ========================================== */

            function viewResult(studentId, term, sclass, school) {

                window.location.href =
                    `/view-student-result?studentId=${studentId}&term=${term}&sclass=${sclass}&school=${school}`;

            }


            /* =========================================
               DELETE ACTION
            ========================================== */

            function delAction(dataId, sclass) {

                resultDetails = {
                    dataId,
                    sclass
                };

                const modal =
                    document.querySelector('.cover-del-model');

                modal.style.display = 'flex';

            }


            /* =========================================
               DELETE RESULT
            ========================================== */

            async function detResult() {

                if (!resultDetails) return;


                try {

                    const res =
                        await fetch('/api/delete_result', {

                            method: "DELETE",

                            headers: {
                                'Content-Type': 'application/json'
                            },

                            body: JSON.stringify(resultDetails)

                        });


                    const data = await res.json();


                    if (res.ok) {

                        window.location.reload();

                        return;

                    }


                    if (typeof showMessagePopup === 'function') {

                        showMessagePopup(data.msg);

                    } else {

                        alert(data.msg);

                    }


                } catch (error) {

                    console.error(error);

                    if (typeof showMessagePopup === 'function') {

                        showMessagePopup('Server error');

                    } else {

                        alert('Server error');

                    }

                }

            }

        </script>

</body>

</html>