<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Demon</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

        :root {
            --primary: #096CCE;
            --light: #C1D8F3;
        }

        body {
            font-family: 'Inter', system-ui, sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e0f0ff 100%);
        }

        .header {
            background: var(--primary);
            box-shadow: 0 4px 12px rgba(9, 108, 206, 0.3);
        }

        .option {
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .option:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(9, 108, 206, 0.2);
        }

        .option.selected {
            background-color: var(--primary);
            color: white;
            border-color: var(--primary);
        }

        .timer {
            font-variant-numeric: tabular-nums;
        }
    </style>
</head>
<body class="min-h-screen">
    <div class="max-w-3xl mx-auto bg-white min-h-screen shadow-xl overflow-hidden">

        <!-- Header -->
        <header class="header text-white">
            <div class="flex items-center justify-between px-6 py-4">
                <!-- Left: Profile -->
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center text-xl font-bold text-blue-600">
                        J
                    </div>
                    <!-- <div>
                        <p class="font-semibold">James11</p>
                        <p class="text-xs opacity-75">JAMB 2026</p>
                    </div> -->
                </div>

                <!-- Center: Subject -->
                <!-- <div class="text-center">
                    <h1 class="text-2xl font-bold">English</h1>
                    <p class="text-sm opacity-75">Use of English • JAMB</p>
                </div> -->

                <!-- Right: Timer & Controls -->
                <div class="flex items-center gap-4">
                    <div onclick="showQuestion()" 
                         class="timer bg-white/20 hover:bg-white/30 px-4 py-2 rounded-xl font-mono text-lg font-semibold cursor-pointer flex items-center gap-2">
                        <i class="fas fa-clock"></i>
                        <span id="time">59:60</span>
                    </div>
                    
                    <button onclick="endExam()" 
                            class="bg-white/20 hover:bg-red-500 hover:text-white px-5 py-2 rounded-xl text-sm font-medium transition-all">
                        End Exam
                    </button>
                </div>
            </div>
        </header>

        <!-- Question Area -->
        <div class="p-6">
            <div class="flex justify-between items-center mb-6">
                <div class="flex items-center gap-2">
                    <span class="px-4 py-1 bg-blue-100 text-blue-700 rounded-full text-sm font-semibold">Question <span id="q-number">6</span><span id="totalQues">/40</span></span>
                </div>
                <div class="text-sm text-gray-500 font-medium">
                    <i class="fas fa-flag"></i> <span id="flagged">0 flagged</span>
                </div>
            </div>

            <!-- Question -->
            <div id="question" class="bg-gray-50 border border-gray-200 p-8 rounded-2xl mb-8 text-lg leading-relaxed min-h-[180px]">
                In each of the following sentences, there is one underlined word and one gap. From the list of words lettered A - D, choose the one that is most nearly opposite in meaning to the underlined word and that will, at the same time, correctly fill the gap in the sentence.
            </div>

            <!-- Options -->
            <div class="space-y-3" id="options">
                <!-- Populated by JS -->
            </div>
        </div>

        <!-- Footer Navigation -->
        <footer class="border-t sticky bottom-0 bg-white">
            <div class="flex items-center justify-between px-6 py-5">
                <button onclick="previous()" 
                    id="prevBtn"
                        class="flex items-center gap-2 px-6 py-3 rounded-xl border border-gray-300 hover:bg-gray-100 transition-all font-medium">
                    <i class="fas fa-arrow-left"></i>
                    Previous
                </button>

                <!-- <div class="flex gap-2">
                    <button onclick="flagQuestion()" 
                            class="flex items-center gap-2 px-6 py-3 rounded-xl border border-amber-400 text-amber-600 hover:bg-amber-50 transition-all">
                        <i class="fas fa-flag"></i>
                        Flag
                    </button>
                </div> -->

                <button onclick="next()" id="next-btn"
                       
                        class="flex items-center gap-2 px-8 py-3 bg-blue-600 text-white rounded-xl hover:bg-blue-700 transition-all font-semibold">
                    Next
                    <i class="fas fa-arrow-right"></i>
                </button>
            </div>
        </footer>
    </div>

    <script src="/js/questionFrame.js"></script>
</body>
</html>