
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Loan Eligibility - MySchoolResult</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        body {
            font-family: Arial, sans-serif;
        }
    </style>
</head>

<body class="min-h-screen bg-slate-50">

    <!-- Main -->
    <main class="min-h-screen flex items-center justify-center px-4 py-10 sm:px-6 lg:px-10">

        <div class="w-full max-w-5xl">

            <!-- Main Card -->
            <div class="bg-white rounded-3xl shadow-xl overflow-hidden">

                <!-- Top Header -->
                <div class="bg-blue-600 px-6 py-10 sm:px-10 lg:px-12">

                    <div class="flex flex-col sm:flex-row sm:items-center gap-5">

                        <!-- Icon -->
                        <div class="w-16 h-16 shrink-0 rounded-2xl bg-white/15 flex items-center justify-center text-3xl">
                            🚫
                        </div>

                        <div>
                            <p class="text-blue-100 text-sm font-medium mb-1">
                                MySchoolResult School Loan
                            </p>

                            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white">
                                Not Eligible Yet
                            </h1>

                            <p class="mt-2 text-blue-100 text-sm sm:text-base">
                                Your eligibility journey is already in progress.
                            </p>
                        </div>

                    </div>

                </div>


                <!-- Content -->
                <div class="p-6 sm:p-8 lg:p-12">

                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">

                        <!-- LEFT -->
                        <div>

                            <h2 class="text-xl sm:text-2xl font-bold text-slate-800">
                                Loan Eligibility
                            </h2>

                            <p class="mt-4 text-slate-600 leading-7">
                                Your school is not yet eligible for the
                                <strong class="text-blue-600">
                                    0% Interest School Loan.
                                </strong>
                            </p>

                            <p class="mt-3 text-slate-600 leading-7">
                                To qualify, your school must be registered and
                                actively using MySchoolResult for at least
                                <strong>1 year</strong> or
                                <strong>one full academic session.</strong>
                            </p>


                            <!-- Requirement Box -->
                            <div class="mt-7 rounded-2xl border border-blue-100 bg-blue-50 p-5 sm:p-6">

                                <h3 class="font-bold text-blue-800">
                                    Eligibility Requirement
                                </h3>

                                <div class="mt-5 space-y-4">

                                    <!-- Requirement 1 -->
                                    <div class="flex items-start gap-4">

                                        <div class="w-9 h-9 shrink-0 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-sm">
                                            1
                                        </div>

                                        <div>
                                            <p class="font-semibold text-slate-800">
                                                One Year
                                            </p>

                                            <p class="text-sm text-slate-500 mt-1">
                                                Your school must have used
                                                MySchoolResult for at least one year.
                                            </p>
                                        </div>

                                    </div>


                                    <!-- Requirement 2 -->
                                    <div class="flex items-start gap-4">

                                        <div class="w-9 h-9 shrink-0 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-sm">
                                            2
                                        </div>

                                        <div>
                                            <p class="font-semibold text-slate-800">
                                                One Full Academic Session
                                            </p>

                                            <p class="text-sm text-slate-500 mt-1">
                                                Your school may also qualify after
                                                completing one full academic session.
                                            </p>
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- RIGHT -->
                        <div class="flex flex-col justify-center">

                            <!-- Journey Card -->
                            <div class="rounded-2xl bg-blue-600 p-6 sm:p-8 text-white">

                                <div class="w-14 h-14 rounded-xl bg-white/15 flex items-center justify-center text-2xl">
                                    ✓
                                </div>

                                <h2 class="mt-5 text-xl sm:text-2xl font-bold">
                                    Keep Growing With Us
                                </h2>

                                <p class="mt-3 text-blue-100 leading-7">
                                    Your school has already started its journey
                                    towards loan eligibility.
                                </p>

                                <div class="mt-6 space-y-4">

                                    <div class="flex items-center gap-3">
                                        <div class="w-2 h-2 rounded-full bg-white"></div>
                                        <span class="text-sm text-blue-50">
                                            Continue using MySchoolResult
                                        </span>
                                    </div>

                                    <div class="flex items-center gap-3">
                                        <div class="w-2 h-2 rounded-full bg-white"></div>
                                        <span class="text-sm text-blue-50">
                                            Complete one year or one academic session
                                        </span>
                                    </div>

                                    <div class="flex items-center gap-3">
                                        <div class="w-2 h-2 rounded-full bg-white"></div>
                                        <span class="text-sm text-blue-50">
                                            Become eligible to apply
                                        </span>
                                    </div>

                                </div>

                            </div>


                            <!-- Encouragement -->
                            <div class="mt-6 rounded-2xl border border-slate-200 p-5 sm:p-6">

                                <div class="flex items-start gap-4">

                                    <div class="w-10 h-10 shrink-0 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold">
                                        ✓
                                    </div>

                                    <div>
                                        <h3 class="font-semibold text-slate-800">
                                            You're on the right track
                                        </h3>

                                        <p class="mt-1 text-sm text-slate-500 leading-6">
                                            Keep using MySchoolResult to manage
                                            your school and build your eligibility.
                                        </p>
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- Button -->
                    <div class="mt-10 pt-7 border-t border-slate-100">

                        <button
                            onclick="history.back()"
                            class="w-full sm:w-auto px-8 py-3.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition duration-200">
                            Back to Dashboard
                        </button>

                    </div>

                </div>

            </div>


            <!-- Footer -->
            <div class="text-center mt-6">

                <p class="text-sm text-slate-400">
                    MySchoolResult
                </p>

                <p class="text-xs text-slate-400 mt-1">
                    Helping Schools Go Digital
                </p>

            </div>

        </div>

    </main>

</body>
</html>

