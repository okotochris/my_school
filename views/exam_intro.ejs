<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Exam Instructions</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gradient-to-br from-indigo-900 via-blue-900 to-sky-900 min-h-screen text-white">

    <div class="max-w-3xl mx-auto pt-20 px-6">

        <div class="bg-white/10 backdrop-blur-xl border border-white/20 rounded-3xl shadow-2xl p-12">

            <!-- Header -->
            <div class="text-center mb-12">
                <div class="inline-flex items-center justify-center w-24 h-24 bg-white/10 rounded-3xl mb-6 text-6xl backdrop-blur-md">
                    📋
                </div>
                <h1 class="text-5xl font-bold mb-3">Ready for the Exam?</h1>
                <p class="text-blue-200 text-xl">Please read the instructions carefully</p>
            </div>

            <div class="grid md:grid-cols-2 gap-10">
                
                <!-- Left Column -->
                <div class="space-y-8">
                    <div>
                        <h2 class="text-2xl font-semibold mb-5 flex items-center gap-3">
                            <span class="text-3xl">📌</span> Exam Overview
                        </h2>
                        <div class="space-y-4">
                            <div class="flex justify-between items-center bg-white/10 p-5 rounded-2xl">
                                <span>Questions</span>
                                <span class="font-bold text-2xl">20</span>
                            </div>
                            <div class="flex justify-between items-center bg-white/10 p-5 rounded-2xl">
                                <span>Time Allowed</span>
                                <span class="font-bold text-2xl">30 Minutes</span>
                            </div>
                            <div class="flex justify-between items-center bg-white/10 p-5 rounded-2xl">
                                <span>Marks</span>
                                <span class="font-bold text-2xl">20</span>
                            </div>
                        </div>
                    </div>

                    <div>
                        <h2 class="text-2xl font-semibold mb-4">Navigation</h2>
                        <div class="space-y-3 text-lg">
                            <div class="flex items-center gap-4 bg-white/5 p-4 rounded-2xl">
                                <div class="w-10 h-10 bg-blue-500 rounded-xl flex items-center justify-center text-xl">→</div>
                                <div><strong>Next</strong> — Go to next question</div>
                            </div>
                            <div class="flex items-center gap-4 bg-white/5 p-4 rounded-2xl">
                                <div class="w-10 h-10 bg-blue-500 rounded-xl flex items-center justify-center text-xl">←</div>
                                <div><strong>Previous</strong> — Go back</div>
                            </div>
                            <div class="flex items-center gap-4 bg-white/5 p-4 rounded-2xl">
                                <div class="w-10 h-10 bg-amber-500 rounded-xl flex items-center justify-center text-xl">⏰</div>
                                <div>Timer at top right • Auto-submits when time ends</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column -->
                <div>
                    <h2 class="text-2xl font-semibold mb-5 flex items-center gap-3">
                        <span class="text-3xl">📋</span> Key Rules
                    </h2>
                    <ul class="space-y-5 text-lg">
                        <li class="flex gap-4">
                            <span class="text-emerald-400 text-2xl">•</span>
                            <span>You have <strong>4 options</strong> to choose from per question</span>
                        </li>
                        <li class="flex gap-4">
                            <span class="text-emerald-400 text-2xl">•</span>
                            <span>Click <strong>End Exam</strong> when you are finished</span>
                        </li>
                        <li class="flex gap-4">
                            <span class="text-emerald-400 text-2xl">•</span>
                            <span>You can review and change answers anytime</span>
                        </li>
                        <li class="flex gap-4">
                            <span class="text-emerald-400 text-2xl">•</span>
                            <span>No negative marking</span>
                        </li>
                        <li class="flex gap-4">
                            <span class="text-emerald-400 text-2xl">•</span>
                            <span>Do not refresh the page</span>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Start Button -->
            <div class="mt-12 text-center">
                <button onclick="startExam()" 
                        class="group bg-white text-indigo-700 hover:bg-yellow-300 hover:text-indigo-800 transition-all duration-300 font-bold text-2xl px-16 py-6 rounded-3xl flex items-center gap-4 mx-auto shadow-xl">
                    <span>Start the Exam</span>
                    <i class="fas fa-arrow-right group-active:translate-x-2 transition"></i>
                </button>
                <p class="text-blue-200 mt-6 text-sm">Timer starts immediately after clicking</p>
            </div>
        </div>

        <p class="text-center text-white/60 text-sm mt-8">
            Good Luck!
        </p>
    </div>

<script>
    function startExam() {
      window.location.href = "/myschool/quiz"; // Change to your quiz page
    }
</script>

</body>
</html>