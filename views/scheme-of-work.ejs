
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Add Scheme of Work | MySchoolResult</title>
      <link rel="stylesheet" href="/styles/global.css">
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#096CCE'
                    }
                }
            }
        }
    </script>
</head>


<body class="bg-slate-50 text-slate-800">
    <%- include('./partials/header.ejs') %>
    <div class="admin-container">
        <%- include('./partials/navigation.ejs') %>
        <div class="min-h-screen">

            <!-- ==========================================
                HEADER
            =========================================== -->

            <header class="sticky top-0 z-40 border-b border-slate-200 bg-white">

                <div
                    class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8"
                >

                    <div>

                        <h1 class="text-lg font-bold text-slate-900">
                            Scheme of Work
                        </h1>

                        <p class="mt-0.5 text-xs text-slate-500">
                            Create a structured scheme of work for your class
                        </p>

                    </div>


                    <div class="flex items-center gap-2">

                        <button
                            type="button"
                            id="saveDraftBtn"
                            class="hidden rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-xs font-semibold text-slate-600 transition hover:bg-slate-50 sm:block"
                        >
                            Save Draft
                        </button>

                        <button
                            type="submit"
                            form="schemeForm"
                            class="rounded-lg bg-[#096CCE] px-4 py-2.5 text-xs font-semibold text-white shadow-sm transition hover:bg-blue-700"
                        >
                            Save Scheme
                        </button>

                    </div>

                </div>

            </header>



            <!-- ==========================================
                MAIN
            =========================================== -->

            <main class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">

                <form id="schemeForm">

                    <div class="grid gap-6 lg:grid-cols-3">


                        <!-- ==========================================
                            MAIN CONTENT
                        =========================================== -->

                        <div class="space-y-6 lg:col-span-2">


                            <!-- BASIC INFORMATION -->

                            <section class="rounded-xl border border-slate-200 bg-white shadow-sm">

                                <div class="border-b border-slate-100 px-5 py-5 sm:px-6">

                                    <div class="flex items-start gap-3">

                                        <div
                                            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-[#096CCE]"
                                        >
                                            📚
                                        </div>

                                        <div>

                                            <h2 class="text-sm font-bold text-slate-900">
                                                Scheme Information
                                            </h2>

                                            <p class="mt-1 text-xs text-slate-500">
                                                Select the class, subject and academic session
                                                for this scheme.
                                            </p>

                                        </div>

                                    </div>

                                </div>


                                <div class="p-5 sm:p-6">

                                    <div class="grid gap-5 sm:grid-cols-2">


                                        <!-- SESSION -->

                                        <div>

                                            <label
                                                for="session"
                                                class="mb-1.5 block text-xs font-medium text-slate-600"
                                            >
                                                Academic Session
                                            </label>

                                            <select
                                                id="session"
                                                name="session"
                                                required
                                                class="w-full rounded-lg border border-slate-200 bg-white px-3 py-3 text-sm text-slate-700 outline-none transition focus:border-[#096CCE] focus:ring-2 focus:ring-blue-100"
                                            >

                                                <option value="" selected disabled>
                                                    Select session
                                                </option>

                                                <option value="2026/2027">
                                                    2026/2027
                                                </option>

                                                <option value="2027/2028">
                                                    2027/2028
                                                </option>

                                            </select>

                                        </div>


                                        <!-- TERM -->

                                        <div>

                                            <label
                                                for="term"
                                                class="mb-1.5 block text-xs font-medium text-slate-600"
                                            >
                                                Term
                                            </label>

                                            <select
                                                id="term"
                                                name="term"
                                                required
                                                class="w-full rounded-lg border border-slate-200 bg-white px-3 py-3 text-sm text-slate-700 outline-none transition focus:border-[#096CCE] focus:ring-2 focus:ring-blue-100"
                                            >

                                                <option value="" selected disabled>
                                                    Select term
                                                </option>

                                                <option value="FIRST TERM">
                                                    First Term
                                                </option>

                                                <option value="SECOND TERM">
                                                    Second Term
                                                </option>

                                                <option value="THIRD TERM">
                                                    Third Term
                                                </option>

                                            </select>

                                        </div>


                                        <!-- CLASS -->

                                        <div>

                                            <label
                                                for="class"
                                                class="mb-1.5 block text-xs font-medium text-slate-600"
                                            >
                                                Class
                                            </label>

                                            <select
                                                id="class"
                                                name="class"
                                                required
                                                class="w-full rounded-lg border border-slate-200 bg-white px-3 py-3 text-sm text-slate-700 outline-none transition focus:border-[#096CCE] focus:ring-2 focus:ring-blue-100"
                                            >

                                                <option value="" selected disabled>
                                                    Select class
                                                </option>

                                                <option>JSS 1</option>
                                                <option>JSS 2</option>
                                                <option>JSS 3</option>

                                                <option>SS 1</option>
                                                <option>SS 2</option>
                                                <option>SS 3</option>

                                            </select>

                                        </div>


                                        <!-- SUBJECT -->

                                        <div>

                                            <label
                                                for="subject"
                                                class="mb-1.5 block text-xs font-medium text-slate-600"
                                            >
                                                Subject
                                            </label>

                                            <select
                                                id="subject"
                                                name="subject"
                                                required
                                                class="w-full rounded-lg border border-slate-200 bg-white px-3 py-3 text-sm text-slate-700 outline-none transition focus:border-[#096CCE] focus:ring-2 focus:ring-blue-100"
                                            >

                                                <option value="" selected disabled>
                                                    Select subject
                                                </option>

                                                <option>Mathematics</option>
                                                <option>English Language</option>
                                                <option>Basic Science</option>
                                                <option>Basic Technology</option>
                                                <option>Computer Studies</option>
                                                <option>Physics</option>
                                                <option>Chemistry</option>
                                                <option>Biology</option>

                                            </select>

                                        </div>

                                    </div>

                                </div>

                            </section>



                            <!-- WEEKLY SCHEME -->

                            <section class="rounded-xl border border-slate-200 bg-white shadow-sm">

                                <div class="border-b border-slate-100 px-5 py-5 sm:px-6">

                                    <div class="flex items-center justify-between gap-4">

                                        <div>

                                            <h2 class="text-sm font-bold text-slate-900">
                                                Weekly Scheme
                                            </h2>

                                            <p class="mt-1 text-xs text-slate-500">
                                                Add the topics and learning objectives for each week.
                                            </p>

                                        </div>


                                        <button
                                            type="button"
                                            id="addWeekBtn"
                                            class="inline-flex items-center gap-1.5 rounded-lg bg-blue-50 px-3 py-2 text-xs font-semibold text-[#096CCE] transition hover:bg-blue-100"
                                        >
                                            <span class="text-base">+</span>
                                            Add Week
                                        </button>

                                    </div>

                                </div>


                                <div
                                    id="weeksContainer"
                                    class="divide-y divide-slate-100"
                                >


                                    <!-- WEEK 1 -->

                                    <div
                                        class="week-item p-5 sm:p-6"
                                        data-week="1"
                                    >

                                        <div class="mb-5 flex items-center justify-between">

                                            <div class="flex items-center gap-3">

                                                <span
                                                    class="flex h-8 w-8 items-center justify-center rounded-lg bg-[#096CCE] text-xs font-bold text-white"
                                                >
                                                    1
                                                </span>

                                                <div>

                                                    <h3 class="text-sm font-bold text-slate-900">
                                                        Week 1
                                                    </h3>

                                                    <p class="text-[11px] text-slate-400">
                                                        First week
                                                    </p>

                                                </div>

                                            </div>

                                        </div>


                                        <div class="space-y-5">


                                            <!-- TOPIC -->

                                            <div>

                                                <label
                                                    class="mb-1.5 block text-xs font-medium text-slate-600"
                                                >
                                                    Topic
                                                </label>

                                                <input
                                                    type="text"
                                                    name="weeks[0][topic]"
                                                    placeholder="Enter topic for this week"
                                                    required
                                                    class="w-full rounded-lg border border-slate-200 px-3 py-3 text-sm outline-none transition focus:border-[#096CCE] focus:ring-2 focus:ring-blue-100"
                                                >

                                            </div>


                                            <!-- SUBTOPICS -->

                                            <div>

                                                <label
                                                    class="mb-1.5 block text-xs font-medium text-slate-600"
                                                >
                                                    Sub-topics / Content
                                                </label>

                                                <textarea
                                                    name="weeks[0][subtopics]"
                                                    rows="4"
                                                    placeholder="Enter the sub-topics or content to be covered..."
                                                    class="w-full resize-y rounded-lg border border-slate-200 px-3 py-3 text-sm outline-none transition focus:border-[#096CCE] focus:ring-2 focus:ring-blue-100"
                                                ></textarea>

                                            </div>


                                            <!-- OBJECTIVES -->

                                            <div>

                                                <label
                                                    class="mb-1.5 block text-xs font-medium text-slate-600"
                                                >
                                                    Learning Objectives
                                                </label>

                                                <textarea
                                                    name="weeks[0][objectives]"
                                                    rows="4"
                                                    placeholder="What should students be able to do after this week's lessons?"
                                                    class="w-full resize-y rounded-lg border border-slate-200 px-3 py-3 text-sm outline-none transition focus:border-[#096CCE] focus:ring-2 focus:ring-blue-100"
                                                ></textarea>

                                            </div>


                                            <!-- ACTIVITIES -->

                                            <div>

                                                <label
                                                    class="mb-1.5 block text-xs font-medium text-slate-600"
                                                >
                                                    Activities / Teaching Methods
                                                </label>

                                                <textarea
                                                    name="weeks[0][activities]"
                                                    rows="3"
                                                    placeholder="Practical activities, discussions, demonstrations..."
                                                    class="w-full resize-y rounded-lg border border-slate-200 px-3 py-3 text-sm outline-none transition focus:border-[#096CCE] focus:ring-2 focus:ring-blue-100"
                                                ></textarea>

                                            </div>


                                            <!-- RESOURCES -->

                                            <div>

                                                <label
                                                    class="mb-1.5 block text-xs font-medium text-slate-600"
                                                >
                                                    Teaching Resources
                                                </label>

                                                <input
                                                    type="text"
                                                    name="weeks[0][resources]"
                                                    placeholder="e.g. Textbook, chart, computer, laboratory equipment"
                                                    class="w-full rounded-lg border border-slate-200 px-3 py-3 text-sm outline-none transition focus:border-[#096CCE] focus:ring-2 focus:ring-blue-100"
                                                >

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </section>



                            <!-- GENERAL NOTES -->

                            <section class="rounded-xl border border-slate-200 bg-white shadow-sm">

                                <div class="border-b border-slate-100 px-5 py-5 sm:px-6">

                                    <h2 class="text-sm font-bold text-slate-900">
                                        Additional Information
                                    </h2>

                                    <p class="mt-1 text-xs text-slate-500">
                                        Add any general notes or instructions for the scheme.
                                    </p>

                                </div>


                                <div class="p-5 sm:p-6">

                                    <textarea
                                        name="notes"
                                        id="notes"
                                        rows="5"
                                        placeholder="Additional notes..."
                                        class="w-full resize-y rounded-lg border border-slate-200 px-3 py-3 text-sm outline-none transition focus:border-[#096CCE] focus:ring-2 focus:ring-blue-100"
                                    ></textarea>

                                </div>

                            </section>


                        </div>



                        <!-- ==========================================
                            SIDEBAR
                        =========================================== -->

                        <aside class="space-y-6">


                            <!-- SCHEME SUMMARY -->

                            <div class="rounded-xl border border-slate-200 bg-white shadow-sm">

                                <div class="border-b border-slate-100 px-5 py-5">

                                    <h2 class="text-sm font-bold text-slate-900">
                                        Scheme Summary
                                    </h2>

                                    <p class="mt-1 text-xs text-slate-500">
                                        Overview of this scheme
                                    </p>

                                </div>


                                <div class="space-y-4 p-5">


                                    <div>

                                        <p class="text-[10px] font-medium uppercase tracking-wide text-slate-400">
                                            Session
                                        </p>

                                        <p
                                            id="previewSession"
                                            class="mt-1 text-sm font-semibold text-slate-800"
                                        >
                                            Not selected
                                        </p>

                                    </div>


                                    <div>

                                        <p class="text-[10px] font-medium uppercase tracking-wide text-slate-400">
                                            Term
                                        </p>

                                        <p
                                            id="previewTerm"
                                            class="mt-1 text-sm font-semibold text-slate-800"
                                        >
                                            Not selected
                                        </p>

                                    </div>


                                    <div>

                                        <p class="text-[10px] font-medium uppercase tracking-wide text-slate-400">
                                            Class
                                        </p>

                                        <p
                                            id="previewClass"
                                            class="mt-1 text-sm font-semibold text-slate-800"
                                        >
                                            Not selected
                                        </p>

                                    </div>


                                    <div>

                                        <p class="text-[10px] font-medium uppercase tracking-wide text-slate-400">
                                            Subject
                                        </p>

                                        <p
                                            id="previewSubject"
                                            class="mt-1 text-sm font-semibold text-slate-800"
                                        >
                                            Not selected
                                        </p>

                                    </div>


                                    <div class="border-t border-slate-100 pt-4">

                                        <p class="text-[10px] font-medium uppercase tracking-wide text-slate-400">
                                            Weeks Added
                                        </p>

                                        <p
                                            id="weekCount"
                                            class="mt-1 text-sm font-semibold text-[#096CCE]"
                                        >
                                            1 Week
                                        </p>

                                    </div>

                                </div>

                            </div>



                            <!-- QUICK ACTIONS -->

                            <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">

                                <h2 class="text-sm font-bold text-slate-900">
                                    Quick Actions
                                </h2>


                                <div class="mt-4 space-y-2">

                                    <button
                                        type="button"
                                        id="addWeekSidebar"
                                        class="flex w-full items-center gap-3 rounded-lg border border-slate-200 px-3 py-3 text-left transition hover:border-blue-200 hover:bg-blue-50"
                                    >

                                        <span class="text-lg">➕</span>

                                        <span>
                                            <span class="block text-xs font-semibold text-slate-700">
                                                Add another week
                                            </span>

                                            <span class="block text-[10px] text-slate-400">
                                                Continue building your scheme
                                            </span>
                                        </span>

                                    </button>


                                    <button
                                        type="button"
                                        class="flex w-full items-center gap-3 rounded-lg border border-slate-200 px-3 py-3 text-left transition hover:border-blue-200 hover:bg-blue-50"
                                    >

                                        <span class="text-lg">📋</span>

                                        <span>
                                            <span class="block text-xs font-semibold text-slate-700">
                                                View existing schemes
                                            </span>

                                            <span class="block text-[10px] text-slate-400">
                                                Manage saved schemes
                                            </span>
                                        </span>

                                    </button>

                                </div>

                            </div>



                            <!-- TIP -->

                            <div class="rounded-xl border border-blue-100 bg-blue-50 p-5">

                                <div class="flex gap-3">

                                    <div class="text-lg">
                                        💡
                                    </div>

                                    <div>

                                        <h3 class="text-xs font-bold text-[#096CCE]">
                                            Scheme Tip
                                        </h3>

                                        <p class="mt-1 text-[11px] leading-5 text-blue-700">
                                            Organize topics in a logical order so each week's
                                            lesson builds naturally on what students learned
                                            previously.
                                        </p>

                                    </div>

                                </div>

                            </div>

                        </aside>

                    </div>

                </form>

            </main>

        </div>
    </div>



    <!-- ==========================================
         JAVASCRIPT
    =========================================== -->

    <script>

        const weeksContainer =
            document.getElementById('weeksContainer');

        const addWeekBtn =
            document.getElementById('addWeekBtn');

        const addWeekSidebar =
            document.getElementById('addWeekSidebar');


        let weekNumber = 1;


        // ==========================================
        // ADD WEEK
        // ==========================================

        function addWeek() {

            weekNumber++;

            const week = document.createElement('div');

            week.className = 'week-item p-5 sm:p-6';

            week.dataset.week = weekNumber;


            week.innerHTML = `

                <div class="mb-5 flex items-center justify-between">

                    <div class="flex items-center gap-3">

                        <span
                            class="flex h-8 w-8 items-center justify-center rounded-lg bg-[#096CCE] text-xs font-bold text-white"
                        >
                            ${weekNumber}
                        </span>

                        <div>

                            <h3 class="text-sm font-bold text-slate-900">
                                Week ${weekNumber}
                            </h3>

                            <p class="text-[11px] text-slate-400">
                                Week ${weekNumber} of the scheme
                            </p>

                        </div>

                    </div>


                    <button
                        type="button"
                        class="remove-week rounded-lg px-3 py-2 text-xs font-medium text-red-500 transition hover:bg-red-50"
                    >
                        Remove
                    </button>

                </div>


                <div class="space-y-5">


                    <div>

                        <label
                            class="mb-1.5 block text-xs font-medium text-slate-600"
                        >
                            Topic
                        </label>

                        <input
                            type="text"
                            name="weeks[${weekNumber - 1}][topic]"
                            placeholder="Enter topic for this week"
                            required
                            class="w-full rounded-lg border border-slate-200 px-3 py-3 text-sm outline-none transition focus:border-[#096CCE] focus:ring-2 focus:ring-blue-100"
                        >

                    </div>


                    <div>

                        <label
                            class="mb-1.5 block text-xs font-medium text-slate-600"
                        >
                            Sub-topics / Content
                        </label>

                        <textarea
                            name="weeks[${weekNumber - 1}][subtopics]"
                            rows="4"
                            placeholder="Enter the sub-topics or content to be covered..."
                            class="w-full resize-y rounded-lg border border-slate-200 px-3 py-3 text-sm outline-none transition focus:border-[#096CCE] focus:ring-2 focus:ring-blue-100"
                        ></textarea>

                    </div>


                    <div>

                        <label
                            class="mb-1.5 block text-xs font-medium text-slate-600"
                        >
                            Learning Objectives
                        </label>

                        <textarea
                            name="weeks[${weekNumber - 1}][objectives]"
                            rows="4"
                            placeholder="What should students be able to do after this week's lessons?"
                            class="w-full resize-y rounded-lg border border-slate-200 px-3 py-3 text-sm outline-none transition focus:border-[#096CCE] focus:ring-2 focus:ring-blue-100"
                        ></textarea>

                    </div>


                    <div>

                        <label
                            class="mb-1.5 block text-xs font-medium text-slate-600"
                        >
                            Activities / Teaching Methods
                        </label>

                        <textarea
                            name="weeks[${weekNumber - 1}][activities]"
                            rows="3"
                            placeholder="Practical activities, discussions, demonstrations..."
                            class="w-full resize-y rounded-lg border border-slate-200 px-3 py-3 text-sm outline-none focus:border-[#096CCE] focus:ring-2 focus:ring-blue-100"
                        ></textarea>

                    </div>


                    <div>

                        <label
                            class="mb-1.5 block text-xs font-medium text-slate-600"
                        >
                            Teaching Resources
                        </label>

                        <input
                            type="text"
                            name="weeks[${weekNumber - 1}][resources]"
                            placeholder="e.g. Textbook, chart, computer, laboratory equipment"
                            class="w-full rounded-lg border border-slate-200 px-3 py-3 text-sm outline-none transition focus:border-[#096CCE] focus:ring-2 focus:ring-blue-100"
                        >

                    </div>

                </div>
            `;


            weeksContainer.appendChild(week);

            updateWeekCount();

            week.scrollIntoView({
                behavior: 'smooth',
                block: 'center'
            });
        }


        addWeekBtn.addEventListener('click', addWeek);

        addWeekSidebar.addEventListener('click', addWeek);


        // ==========================================
        // REMOVE WEEK
        // ==========================================

        weeksContainer.addEventListener('click', (event) => {

            if (!event.target.classList.contains('remove-week')) {
                return;
            }

            const week = event.target.closest('.week-item');

            if (!week) {
                return;
            }

            week.remove();

            renumberWeeks();

        });


        // ==========================================
        // RENUMBER WEEKS
        // ==========================================

        function renumberWeeks() {

            const weeks =
                document.querySelectorAll('.week-item');

            weeks.forEach((week, index) => {

                const number = index + 1;

                week.dataset.week = number;

                const numberBadge =
                    week.querySelector('span');

                if (numberBadge) {
                    numberBadge.textContent = number;
                }

                const heading =
                    week.querySelector('h3');

                if (heading) {
                    heading.textContent = `Week ${number}`;
                }


                const inputs =
                    week.querySelectorAll('input, textarea');

                inputs.forEach(input => {

                    const name = input.getAttribute('name');

                    if (!name) return;

                    input.setAttribute(
                        'name',
                        name.replace(
                            /weeks\[\d+\]/,
                            `weeks[${index}]`
                        )
                    );

                });

            });


            weekNumber = weeks.length;

            updateWeekCount();

        }


        // ==========================================
        // WEEK COUNT
        // ==========================================

        function updateWeekCount() {

            const count =
                document.querySelectorAll('.week-item').length;

            document.getElementById('weekCount').textContent =
                `${count} ${count === 1 ? 'Week' : 'Weeks'}`;

        }


        // ==========================================
        // SUMMARY
        // ==========================================

        function updatePreview(inputId, previewId) {

            const input =
                document.getElementById(inputId);

            const preview =
                document.getElementById(previewId);

            input.addEventListener('change', () => {

                preview.textContent =
                    input.options[input.selectedIndex]?.text ||
                    'Not selected';

            });

        }


        updatePreview('session', 'previewSession');
        updatePreview('term', 'previewTerm');
        updatePreview('class', 'previewClass');
        updatePreview('subject', 'previewSubject');


        // ==========================================
        // SUBMIT
        // ==========================================

        document
            .getElementById('schemeForm')
            .addEventListener('submit', (event) => {

                event.preventDefault();

                const formData =
                    new FormData(event.target);

                const data =
                    Object.fromEntries(formData.entries());

                console.log('Scheme:', data);

                alert('Scheme of work ready to save.');

            });


        // ==========================================
        // SAVE DRAFT
        // ==========================================

        document
            .getElementById('saveDraftBtn')
            .addEventListener('click', () => {

                const formData =
                    new FormData(
                        document.getElementById('schemeForm')
                    );

                const data =
                    Object.fromEntries(formData.entries());

                console.log('Draft:', data);

                alert('Scheme saved as draft.');

            });

    </script>

</body>

</html>

