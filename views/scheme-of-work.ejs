    <!-- ==========================================
         JAVASCRIPT
    =========================================== -->

    <script>

        const weeksContainer =
            document.getElementById('weeksContainer');

        const addWeekBtn =
            document.getElementById('addWeekBtn');

        const addWeekSidebar =
            document.getElementById('addWeekSidebar');


        let weekNumber = 1;


        // ==========================================
        // ADD WEEK
        // ==========================================

        function addWeek() {

            weekNumber++;

            const week = document.createElement('div');

            week.className = 'week-item p-5 sm:p-6';

            week.dataset.week = weekNumber;


            week.innerHTML = `

                <div class="mb-5 flex items-center justify-between">

                    <div class="flex items-center gap-3">

                        <span
                            class="flex h-8 w-8 items-center justify-center rounded-lg bg-[#096CCE] text-xs font-bold text-white"
                        >
                            ${weekNumber}
                        </span>

                        <div>

                            <h3 class="text-sm font-bold text-slate-900">
                                Week ${weekNumber}
                            </h3>

                            <p class="text-[11px] text-slate-400">
                                Week ${weekNumber} of the scheme
                            </p>

                        </div>

                    </div>


                    <button
                        type="button"
                        class="remove-week rounded-lg px-3 py-2 text-xs font-medium text-red-500 transition hover:bg-red-50"
                    >
                        Remove
                    </button>

                </div>


                <div class="space-y-5">


                    <div>

                        <label
                            class="mb-1.5 block text-xs font-medium text-slate-600"
                        >
                            Topic
                        </label>

                        <input
                            type="text"
                            name="weeks[${weekNumber - 1}][topic]"
                            placeholder="Enter topic for this week"
                            required
                            class="w-full rounded-lg border border-slate-200 px-3 py-3 text-sm outline-none transition focus:border-[#096CCE] focus:ring-2 focus:ring-blue-100"
                        >

                    </div>


                    <div>

                        <label
                            class="mb-1.5 block text-xs font-medium text-slate-600"
                        >
                            Sub-topics / Content
                        </label>

                        <textarea
                            name="weeks[${weekNumber - 1}][subtopics]"
                            rows="4"
                            placeholder="Enter the sub-topics or content to be covered..."
                            class="w-full resize-y rounded-lg border border-slate-200 px-3 py-3 text-sm outline-none transition focus:border-[#096CCE] focus:ring-2 focus:ring-blue-100"
                        ></textarea>

                    </div>


                    <div>

                        <label
                            class="mb-1.5 block text-xs font-medium text-slate-600"
                        >
                            Learning Objectives
                        </label>

                        <textarea
                            name="weeks[${weekNumber - 1}][objectives]"
                            rows="4"
                            placeholder="What should students be able to do after this week's lessons?"
                            class="w-full resize-y rounded-lg border border-slate-200 px-3 py-3 text-sm outline-none transition focus:border-[#096CCE] focus:ring-2 focus:ring-blue-100"
                        ></textarea>

                    </div>


                    <div>

                        <label
                            class="mb-1.5 block text-xs font-medium text-slate-600"
                        >
                            Activities / Teaching Methods
                        </label>

                        <textarea
                            name="weeks[${weekNumber - 1}][activities]"
                            rows="3"
                            placeholder="Practical activities, discussions, demonstrations..."
                            class="w-full resize-y rounded-lg border border-slate-200 px-3 py-3 text-sm outline-none focus:border-[#096CCE] focus:ring-2 focus:ring-blue-100"
                        ></textarea>

                    </div>


                    <div>

                        <label
                            class="mb-1.5 block text-xs font-medium text-slate-600"
                        >
                            Teaching Resources
                        </label>

                        <input
                            type="text"
                            name="weeks[${weekNumber - 1}][resources]"
                            placeholder="e.g. Textbook, chart, computer, laboratory equipment"
                            class="w-full rounded-lg border border-slate-200 px-3 py-3 text-sm outline-none transition focus:border-[#096CCE] focus:ring-2 focus:ring-blue-100"
                        >

                    </div>

                </div>
            `;


            weeksContainer.appendChild(week);

            updateWeekCount();

            week.scrollIntoView({
                behavior: 'smooth',
                block: 'center'
            });
        }


        addWeekBtn.addEventListener('click', addWeek);

        addWeekSidebar.addEventListener('click', addWeek);


        // ==========================================
        // REMOVE WEEK
        // ==========================================

        weeksContainer.addEventListener('click', (event) => {

            if (!event.target.classList.contains('remove-week')) {
                return;
            }

            const week = event.target.closest('.week-item');

            if (!week) {
                return;
            }

            week.remove();

            renumberWeeks();

        });


        // ==========================================
        // RENUMBER WEEKS
        // ==========================================

        function renumberWeeks() {

            const weeks =
                document.querySelectorAll('.week-item');

            weeks.forEach((week, index) => {

                const number = index + 1;

                week.dataset.week = number;

                const numberBadge =
                    week.querySelector('span');

                if (numberBadge) {
                    numberBadge.textContent = number;
                }

                const heading =
                    week.querySelector('h3');

                if (heading) {
                    heading.textContent = `Week ${number}`;
                }


                const inputs =
                    week.querySelectorAll('input, textarea');

                inputs.forEach(input => {

                    const name = input.getAttribute('name');

                    if (!name) return;

                    input.setAttribute(
                        'name',
                        name.replace(
                            /weeks\[\d+\]/,
                            `weeks[${index}]`
                        )
                    );

                });

            });


            weekNumber = weeks.length;

            updateWeekCount();

        }


        // ==========================================
        // WEEK COUNT
        // ==========================================

        function updateWeekCount() {

            const count =
                document.querySelectorAll('.week-item').length;

            document.getElementById('weekCount').textContent =
                `${count} ${count === 1 ? 'Week' : 'Weeks'}`;

        }


        // ==========================================
        // SUMMARY
        // ==========================================

        function updatePreview(inputId, previewId) {

            const input =
                document.getElementById(inputId);

            const preview =
                document.getElementById(previewId);

            input.addEventListener('change', () => {

                preview.textContent =
                    input.options[input.selectedIndex]?.text ||
                    'Not selected';

            });

        }


        updatePreview('session', 'previewSession');
        updatePreview('term', 'previewTerm');
        updatePreview('class', 'previewClass');
        updatePreview('subject', 'previewSubject');


        // ==========================================
        // SUBMIT
        // ==========================================

        document
            .getElementById('schemeForm')
            .addEventListener('submit', async(event) => {

                event.preventDefault();
                document.getElementById('saveSchemeBtn').disabled = true;
                document.getElementById('saveSchemeBtn').textContent = 'Submitting...';
                try {
                    const formData =
                        new FormData(event.target);

                    const data =
                        Object.fromEntries(formData.entries());
                    const response = await fetch(
                        '/admin/scheme-of-work',
                        {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify(data)
                        }
                    );

                    if (!response.ok) {
                        throw new Error('Failed to submit scheme.');
                    }

                    showMessagePopup('Scheme submitted successfully.');
                    form.reset();

                } catch (error) {
                    console.error(error);
                    showMessagePopup('An error occurred while submitting the scheme.');

                }finally {
                    document.getElementById('saveSchemeBtn').disabled = false;
                    document.getElementById('saveSchemeBtn').textContent = 'Submit Scheme';
                }

            });
    </script>
  <script>
            async function getSubject(studentClass) {
                let subjectClass = studentClass.replace(/[0-9]/g, '').trim();

                if (subjectClass === 'SS') {
                    subjectClass = 'Senior';
                } else if (subjectClass === 'JS') {
                    subjectClass = 'Junior';
                } else if (subjectClass === 'BASIC') {
                    subjectClass = 'Basic';
                } else {
                    subjectClass = 'Nursery';
                }

                try {
                    const result = await fetch(`/admin/get-subject/${subjectClass}`);

                    if (!result.ok) {
                        console.log('Something went wrong:', result.status);
                        return;
                    }
                    const { subject } = await result.json()
                    renderSubject(subject)
                } catch (err) {
                    console.log(err);
                }
            }


            function renderSubject(data) {
                const subject = document.getElementById('subject');
                subject.innerHTML = `<option value="">Select subject</option>`
                data.subjects.forEach(element => {
                    subject.innerHTML += `
                    <option value="${element.subjectName}">
                        ${element.subjectName}
                    </option>
                `;
                });
            }

         
             
        </script>
        <script>

    const SCHEMES_PER_PAGE = 5;

    let currentSchemePage = 1;


    function getTotalSchemePages() {

        return Math.max(
            1,
            Math.ceil(
                schemeOfWorkData.length /
                SCHEMES_PER_PAGE
            )
        );

    }


    function renderSchemes() {

        const list =
            document.getElementById('schemeList');

        const empty =
            document.getElementById('schemeEmpty');

        const pagination =
            document.getElementById('schemePagination');

        const previous =
            document.getElementById('schemePrevious');

        const next =
            document.getElementById('schemeNext');

        const pageInfo =
            document.getElementById('schemePageInfo');


        // Empty state
        if (!schemeOfWorkData.length) {

            list.innerHTML = '';

            empty.classList.remove('hidden');

            pagination.classList.add('hidden');

            return;

        }


        empty.classList.add('hidden');

        pagination.classList.remove('hidden');


        const totalPages =
            getTotalSchemePages();


        // Make sure page is valid
        if (currentSchemePage > totalPages) {
            currentSchemePage = totalPages;
        }


        const start =
            (currentSchemePage - 1) *
            SCHEMES_PER_PAGE;


        const end =
            start + SCHEMES_PER_PAGE;


        const currentSchemes =
            schemeOfWorkData.slice(
                start,
                end
            );


        list.innerHTML =
            currentSchemes
                .map(scheme => createSchemeCard(scheme))
                .join('');


        // Buttons
        previous.disabled =
            currentSchemePage === 1;

        next.disabled =
            currentSchemePage === totalPages;


        pageInfo.textContent =
            `Page ${currentSchemePage} of ${totalPages}`;

    }


    function createSchemeCard(scheme) {

        const weeks =
            Array.isArray(scheme.weeks)
                ? scheme.weeks
                : [];


        const firstTopics =
            weeks
                .slice(0, 2)
                .map(week => week.topic)
                .filter(Boolean);


        const moreTopics =
            Math.max(
                0,
                weeks.length - 2
            );


        const statusClass =
            scheme.status === 'published'
                ? 'bg-green-50 text-green-700'
                : 'bg-amber-50 text-amber-700';


        const statusText =
            scheme.status === 'published'
                ? 'Published'
                : 'Draft';


        return `

            <div
                class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md"
            >

                <!-- TOP -->
                <div class="flex items-start justify-between gap-4">

                    <div class="min-w-0 flex-1">

                        <div class="mb-2 flex flex-wrap items-center gap-2">

                            <span
                                class="rounded-full bg-blue-50 px-2.5 py-1 text-[11px] font-semibold text-blue-700"
                            >
                                ${escapeHtml(scheme.studentClass || '')}
                            </span>


                            <span
                                class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-semibold text-slate-600"
                            >
                                ${escapeHtml(scheme.subject || '')}
                            </span>


                            <span
                                class="rounded-full px-2.5 py-1 text-[11px] font-semibold ${statusClass}"
                            >
                                ${statusText}
                            </span>

                        </div>


                        <h3 class="truncate text-base font-bold text-slate-900">
                            ${escapeHtml(
                                firstTopics[0] ||
                                'Untitled Scheme'
                            )}
                        </h3>


                        <p class="mt-1 text-xs text-slate-500">
                            ${escapeHtml(scheme.session || '')}
                            ${scheme.term ? ' • ' + escapeHtml(scheme.term) : ''}
                        </p>

                    </div>


                    <!-- NUMBER OF WEEKS -->
                    <div
                        class="flex h-11 min-w-[52px] flex-col items-center justify-center rounded-xl bg-slate-50 px-2"
                    >

                        <span class="text-sm font-bold text-slate-800">
                            ${weeks.length}
                        </span>

                        <span class="text-[9px] font-medium uppercase text-slate-400">
                            Weeks
                        </span>

                    </div>

                </div>


                <!-- TOPICS -->
                ${
                    weeks.length
                        ? `

                            <div class="mt-4 border-t border-slate-100 pt-4">

                                <p class="mb-2 text-[11px] font-semibold uppercase tracking-wide text-slate-400">
                                    Topics
                                </p>


                                <div class="space-y-1.5">

                                    ${
                                        firstTopics
                                            .map(topic => `
                                                <div class="flex items-start gap-2">

                                                    <span
                                                        class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-secondary"
                                                    ></span>

                                                    <p class="line-clamp-1 text-xs text-slate-600">
                                                        ${escapeHtml(topic)}
                                                    </p>

                                                </div>
                                            `)
                                            .join('')
                                    }


                                    ${
                                        moreTopics > 0
                                            ? `
                                                <p class="pt-1 text-[11px] font-medium text-secondary">
                                                    + ${moreTopics} more topics
                                                </p>
                                            `
                                            : ''
                                    }

                                </div>

                            </div>

                        `
                        : ''
                }


                <!-- ACTIONS -->
                <div
                    class="mt-5 flex items-center gap-2 border-t border-slate-100 pt-4"
                >

                    <!-- VIEW -->
                    <button
                        type="button"
                        onclick='viewSchemeOfWork(${JSON.stringify(scheme).replace(/'/g, '&#39;')})'
                        class="flex flex-1 items-center justify-center gap-2 rounded-xl bg-primary px-4 py-2.5 text-xs font-semibold text-white transition hover:bg-secondary"
                    >

                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-4 w-4"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                            />

                            <circle
                                cx="12"
                                cy="12"
                                r="3"
                            />

                        </svg>

                        View

                    </button>


                    <!-- DELETE -->
                    <form
                        action="/admin/scheme-of-work/${scheme._id}"
                        method="POST"
                    >

                        <input
                            type="hidden"
                            name="_method"
                            value="DELETE"
                        >


                        <button
                            type="submit"
                            onclick="return confirm('Are you sure you want to delete this scheme of work?')"
                            class="flex items-center justify-center rounded-xl border border-red-200 bg-red-50 px-4 py-2.5 text-xs font-semibold text-red-600 transition hover:bg-red-100"
                        >

                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-4 w-4"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-3a1 1 0 00-1 1v3M4 7h16"
                                />
                            </svg>

                        </button>

                    </form>

                </div>

            </div>

        `;

    }


    function nextSchemePage() {

        const totalPages =
            getTotalSchemePages();


        if (currentSchemePage < totalPages) {

            currentSchemePage++;

            renderSchemes();

        }

    }


    function previousSchemePage() {

        if (currentSchemePage > 1) {

            currentSchemePage--;

            renderSchemes();

        }

    }


    function escapeHtml(value) {

        const div =
            document.createElement('div');

        div.textContent =
            value ?? '';

        return div.innerHTML;

    }


    // Initial render
    renderSchemes();

</script>
</body>

</html>

