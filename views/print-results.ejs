
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/styles/global.css">
  <title>Bulk Result Printing</title>
</head>

<body class="bg-slate-50 text-slate-800">

  <%- include('./partials/header.ejs') %>

  <div class="admin-container">
    <%- include('./partials/navigation.ejs') %>

    <main class="section">
      <div class="w-full">
        <div class="max-w-5xl mx-auto space-y-6">

          <!-- PAGE HEADER -->
          <div>
            <div class="flex items-center gap-2 text-sm text-slate-500 mb-2">
              <span>Administration</span>
              <span>•</span>
              <span>Results</span>
            </div>

            <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900">
              Bulk Result Printing
            </h1>

            <p class="mt-2 text-slate-500 max-w-2xl">
              Select an academic session, class and term to view and print all student results together.
            </p>
          </div>

          <!-- FILTER PANEL -->
          <section class="bg-white border border-slate-200 rounded-3xl shadow-sm overflow-hidden">

            <div class="px-6 md:px-8 py-6 border-b border-slate-100">
              <div class="flex items-start gap-4">

                <div class="w-11 h-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg"
                    class="w-6 h-6" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round"
                      d="M4 5h16M7 12h10m-7 7h4"/>
                  </svg>
                </div>

                <div>
                  <h2 class="text-xl font-bold text-slate-900">
                    Choose result criteria
                  </h2>
                  <p class="text-sm text-slate-500 mt-1">
                    Select the class, academic session and term you want to print.
                  </p>
                </div>

              </div>
            </div>

            <form action="/view-student-result" method="GET" class="p-6 md:p-8">

              <div class="grid grid-cols-1 md:grid-cols-3 gap-5">

                <!-- ACADEMIC SESSION -->
                <div>
                  <label for="session"
                    class="block text-sm font-semibold text-slate-700 mb-2">
                    Academic Session
                  </label>

                  <select id="session" name="session" required
                    class="w-full h-12 rounded-xl border border-slate-200 bg-slate-50 px-4 text-slate-800 outline-none transition focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10">

                    <option value="">Select academic session</option>

                    <% (academicSessions || []).forEach(item => { %>
                      <option value="<%= item %>">
                        <%= item %>
                      </option>
                    <% }) %>

                  </select>
                </div>

                <!-- CLASS -->
                <div>
                  <label for="studentClass"
                    class="block text-sm font-semibold text-slate-700 mb-2">
                    Class
                  </label>

                  <select id="studentClass" name="sclass" required
                    class="w-full h-12 rounded-xl border border-slate-200 bg-slate-50 px-4 text-slate-800 outline-none transition focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10">

                    <option value="">Select class</option>
                    <option value="">All</option>
                    <% schoolClasses.forEach(item => { %>
                      <option value="<%= item %>">
                        <%= item %>
                      </option>
                    <% }) %>

                  </select>
                </div>

                <!-- TERM -->
                <div>
                  <label for="term"
                    class="block text-sm font-semibold text-slate-700 mb-2">
                    Term
                  </label>

                  <select id="term" name="term" required
                    class="w-full h-12 rounded-xl border border-slate-200 bg-slate-50 px-4 text-slate-800 outline-none transition focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10">

                    <option value="">Select term</option>

                    <% (terms || ['First Term', 'Second Term', 'Third Term']).forEach(item => { %>
                      <option value="<%= item %>">
                        <%= item %>
                      </option>
                    <% }) %>

                  </select>
                </div>

              </div>

              <!-- SUBMIT -->
              <div class="mt-7 pt-6 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">

                <p class="text-xs text-slate-500">
                  All available student results matching your selection will be loaded.
                </p>

                <button type="submit"
                  class="inline-flex items-center justify-center gap-2 h-12 px-7 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold shadow-sm hover:shadow-md transition-all duration-200">

                  <svg xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor" stroke-width="1.8">
                    <circle cx="10.8" cy="10.8" r="6.8"/>
                    <path stroke-linecap="round" d="m16 16 5 5"/>
                  </svg>

                  View Results
                </button>

              </div>

            </form>
          </section>

          <!-- INFORMATION -->
          <div class="flex items-start gap-3 bg-blue-50 border border-blue-100 rounded-2xl p-5">
            <svg xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5 text-blue-600 shrink-0 mt-0.5"
              fill="none" viewBox="0 0 24 24"
              stroke="currentColor" stroke-width="1.8">
              <circle cx="12" cy="12" r="9"/>
              <path stroke-linecap="round" d="M12 11v5m0-8h.01"/>
            </svg>

            <div>
              <p class="text-sm font-semibold text-blue-900">
                How bulk printing works
              </p>
              <p class="text-sm text-blue-800 mt-1">
                After selecting your criteria, the system will retrieve all matching student results and display them in the result template. You can then print or download them together.
              </p>
            </div>
          </div>

        </div>
      </div>
    </main>
  </div>

</body>
</html>
