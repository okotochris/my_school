
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Login | MySchoolResult</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/styles/index.css" />
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >
</head>

<body class="min-h-screen bg-slate-50">
    <!-- Main -->
    <main class="min-h-[calc(100vh-80px)] flex items-center justify-center px-5 py-12">

        <div class="w-full max-w-4xl">

            <!-- Heading -->
            <div class="text-center mb-10">

                <div class="inline-flex items-center justify-center
                            w-14 h-14 rounded-2xl
                            bg-emerald-100 text-emerald-700 mb-5">

                    <i class="fa-solid fa-right-to-bracket text-2xl"></i>

                </div>

                <h2 class="text-3xl sm:text-4xl font-bold text-slate-800">
                    Welcome Back
                </h2>

                <p class="mt-3 text-slate-500">
                    Choose your account type to continue
                </p>

            </div>


            <!-- Login Options -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl mx-auto">

                <!-- Admin Login -->
                <a
                    href="/admin"
                    class="group bg-white rounded-2xl border border-slate-200
                           p-7 sm:p-8
                           shadow-sm
                           hover:shadow-xl
                           hover:-translate-y-1
                           hover:border-emerald-300
                           transition-all duration-300"
                >

                    <div class="flex items-start justify-between">

                        <div class="w-14 h-14 rounded-xl
                                    bg-emerald-100
                                    text-emerald-700
                                    flex items-center justify-center">

                            <i class="fa-solid fa-user-tie text-2xl"></i>

                        </div>

                        <i class="fa-solid fa-arrow-right text-slate-300
                                  group-hover:text-emerald-600
                                  group-hover:translate-x-1
                                  transition-all">
                        </i>

                    </div>


                    <h3 class="mt-7 text-xl font-bold text-slate-800">
                        Admin Login
                    </h3>

                    <p class="mt-2 text-slate-500 leading-relaxed">
                        Login to manage your school, students, results,
                        teachers and other school activities.
                    </p>


                    <div class="mt-6 flex items-center gap-2
                                text-emerald-700 font-semibold text-sm">

                        <span>Continue as Admin</span>

                        <i class="fa-solid fa-arrow-right text-xs"></i>

                    </div>

                </a>


                <!-- Student Login -->
                <a
                    href="/student/dashboard"
                    class="group bg-white rounded-2xl border border-slate-200
                           p-7 sm:p-8
                           shadow-sm
                           hover:shadow-xl
                           hover:-translate-y-1
                           hover:border-blue-300
                           transition-all duration-300"
                >

                    <div class="flex items-start justify-between">

                        <div class="w-14 h-14 rounded-xl
                                    bg-blue-100
                                    text-blue-600
                                    flex items-center justify-center">

                            <i class="fa-solid fa-graduation-cap text-2xl"></i>

                        </div>

                        <i class="fa-solid fa-arrow-right text-slate-300
                                  group-hover:text-blue-600
                                  group-hover:translate-x-1
                                  transition-all">
                        </i>

                    </div>


                    <h3 class="mt-7 text-xl font-bold text-slate-800">
                        Student Login
                    </h3>

                    <p class="mt-2 text-slate-500 leading-relaxed">
                        Login to access your result, timetable, assignments,
                        announcements and school information.
                    </p>


                    <div class="mt-6 flex items-center gap-2
                                text-blue-600 font-semibold text-sm">

                        <span>Continue as Student</span>

                        <i class="fa-solid fa-arrow-right text-xs"></i>

                    </div>

                </a>

            </div>


            <!-- Back -->
            <div class="text-center mt-10">

                <a
                    href="/"
                    class="inline-flex items-center gap-2
                           text-sm text-slate-500
                           hover:text-emerald-700
                           transition"
                >

                    <i class="fa-solid fa-arrow-left text-xs"></i>

                    Back to Home

                </a>

            </div>

        </div>

    </main>

</body>
</html>
