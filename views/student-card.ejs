<%
    /* ---------- Optional locals (safe when not passed) ---------- */
    const printMode = !!locals.printMode;           // true when rendered for Puppeteer
    const baseUrl   = locals.baseUrl || '';
    const hex6      = /^#[0-9a-fA-F]{6}$/;
    const cPrimary   = hex6.test(locals.primary)   ? locals.primary   : '#0b2a4a';
    const cSecondary = hex6.test(locals.secondary) ? locals.secondary : '#17619a';

    // Tints calculated here so every browser (and Puppeteer) gets plain rgb values
    const n = parseInt(cSecondary.slice(1), 16);
    const [sr, sg, sb] = [(n >> 16) & 255, (n >> 8) & 255, n & 255];
    const mixWhite = (c) => Math.round(c + (255 - c) * 0.91);
    const cTint = `rgb(${mixWhite(sr)}, ${mixWhite(sg)}, ${mixWhite(sb)})`;
    const cWash = `rgba(${sr}, ${sg}, ${sb}, .05)`;

    /* ---------- Data ---------- */
    const FALLBACK_AVATAR = "data:image/svg+xml;utf8," + encodeURIComponent(
        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 96"><rect width="80" height="96" fill="#e2e8f0"/><circle cx="40" cy="36" r="16" fill="#94a3b8"/><path d="M8 96c2-22 18-32 32-32s30 10 32 32z" fill="#94a3b8"/></svg>'
    );
    const FALLBACK_LOGO = "data:image/svg+xml;utf8," + encodeURIComponent(
        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48"><rect width="48" height="48" rx="8" fill="#e2e8f0"/><path d="M24 11 7 19l17 8 17-8zM14 25v8c0 3 5 6 10 6s10-3 10-6v-8l-10 5z" fill="#94a3b8"/></svg>'
    );

    const school    = locals.schoolInfo || {};
    const logo      = (school.image && school.image.logo) || FALLBACK_LOGO;
    const phone     = school.phone || '';
    const address   = school.address || 'School address not provided';
    const signature = (school.headTeacher && school.headTeacher.signature) || '';

    const students  = Array.isArray(locals.student) ? locals.student : [];
    const cls       = locals.selectedClass || '';
    const classLabel = cls === 'ALL' ? 'All classes' : cls;
    const schoolName = school.schoolName || (students[0] && students[0].schoolName) || '';

    // Section label shown on the front of the card
    const sectionOf = (c) => {
        const k = String(c || '').replace(/[0-9]/g, '').trim();
        if (k === 'JSS') return 'Junior';
        if (k === 'SS') return 'Senior';
        if (k === 'BASIC') return 'Basic';
        return 'Nursery';
    };
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student ID Cards</title>
    <% if (baseUrl) { %><base href="<%= baseUrl %>/"><% } %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jsbarcode/3.11.6/JsBarcode.all.min.js"></script>

    <style>
        :root {
            --card-primary: <%= cPrimary %>;
            --card-secondary: <%= cSecondary %>;
            --card-tint: <%- cTint %>;
            --card-wash: <%- cWash %>;
        }

        body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; }

        .c-primary-text { color: var(--card-primary); }
        .c-secondary-bg { background: var(--card-secondary); }
        .c-primary-bg   { background: var(--card-primary); }
        .c-border       { border-color: var(--card-secondary); }
        .c-tint         { background: var(--card-tint); }

        /* Header with a curved lower edge */
        .c-header {
            background:
                radial-gradient(circle at 88% 8%, rgba(255,255,255,.20) 0 34px, transparent 35px),
                radial-gradient(circle at 6% 92%, rgba(255,255,255,.12) 0 44px, transparent 45px),
                linear-gradient(160deg, var(--card-primary), var(--card-secondary));
            border-radius: 0 0 50% 50% / 0 0 28px 28px;
        }

        .c-watermark::before {
            content: "";
            position: absolute; inset: 0;
            background: repeating-linear-gradient(-45deg, var(--card-wash) 0 1px, transparent 1px 7px);
            pointer-events: none;
        }

        /* Portrait CR80-style card */
        .id-card { width: 220px; height: 350px; }

        .swatch:focus-visible,
        .btn:focus-visible { outline: 2px solid var(--card-secondary); outline-offset: 2px; }

        html, body {
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        @page { size: A4; margin: 10mm; }

        @media print {
            html, body { background: #fff !important; }
            .no-print { display: none !important; }
            .cards-grid { gap: 6mm !important; justify-content: flex-start !important; }
            .student-card-wrapper { break-inside: avoid; page-break-inside: avoid; }
            .id-card { box-shadow: none !important; border-color: #cbd5e1 !important; }
        }
    </style>
</head>

<body class="<%= printMode ? 'bg-white' : 'bg-slate-100' %> text-slate-800 antialiased">

<% if (!printMode) { %>
<!-- ===================== TOOLBAR (screen only) ===================== -->
<header class="no-print sticky top-0 z-10 bg-white/90 backdrop-blur border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-4">

        <div>
            <h1 class="text-base font-bold text-slate-900"><%= classLabel || 'Student ID cards' %></h1>
            <p class="text-xs text-slate-500">
                <% if (cls) { %>
                    <%= students.length %> student<%= students.length === 1 ? '' : 's' %> &middot; one front each, one shared back
                <% } else { %>
                    Select a class to generate cards
                <% } %>
            </p>
        </div>

        <div class="flex items-center gap-4 flex-wrap">

            <div class="flex items-center gap-2" role="group" aria-label="Card colour">
                <span class="text-xs text-slate-500 mr-1">Colour</span>

                <button type="button" class="swatch card-color w-7 h-7 rounded-full border-2 border-white shadow ring-1 ring-slate-300"
                    data-primary="#0b2a4a" data-secondary="#17619a" aria-label="Blue" title="Blue"
                    style="background:linear-gradient(135deg,#0b2a4a,#17619a)"></button>
                <button type="button" class="swatch card-color w-7 h-7 rounded-full border-2 border-white shadow ring-1 ring-slate-300"
                    data-primary="#14532d" data-secondary="#16a34a" aria-label="Green" title="Green"
                    style="background:linear-gradient(135deg,#14532d,#16a34a)"></button>
                <button type="button" class="swatch card-color w-7 h-7 rounded-full border-2 border-white shadow ring-1 ring-slate-300"
                    data-primary="#4c1d95" data-secondary="#7c3aed" aria-label="Purple" title="Purple"
                    style="background:linear-gradient(135deg,#4c1d95,#7c3aed)"></button>
                <button type="button" class="swatch card-color w-7 h-7 rounded-full border-2 border-white shadow ring-1 ring-slate-300"
                    data-primary="#7f1d1d" data-secondary="#dc2626" aria-label="Red" title="Red"
                    style="background:linear-gradient(135deg,#7f1d1d,#dc2626)"></button>
                <button type="button" class="swatch card-color w-7 h-7 rounded-full border-2 border-white shadow ring-1 ring-slate-300"
                    data-primary="#7c2d12" data-secondary="#ea580c" aria-label="Orange" title="Orange"
                    style="background:linear-gradient(135deg,#7c2d12,#ea580c)"></button>
                <button type="button" class="swatch card-color w-7 h-7 rounded-full border-2 border-white shadow ring-1 ring-slate-300"
                    data-primary="#134e4a" data-secondary="#0d9488" aria-label="Teal" title="Teal"
                    style="background:linear-gradient(135deg,#134e4a,#0d9488)"></button>
                <button type="button" class="swatch card-color w-7 h-7 rounded-full border-2 border-white shadow ring-1 ring-slate-300"
                    data-primary="#FFD700" data-secondary="#685902" aria-label="Teal" title="Teal"
                    style="background:linear-gradient(135deg,#FFD700,#594c00)"></button>
                <button type="button" class="swatch card-color w-7 h-7 rounded-full border-2 border-white shadow ring-1 ring-slate-300"
                    data-primary="#131312" data-secondary="#363838" aria-label="Grey" title="Grey"
                    style="background:linear-gradient(135deg,#131312,#363838)"></button>
            </div>

            <% if (students.length > 0) { %>
                <button type="button" id="downloadPdf" data-class="<%= cls || 'ALL' %>"
                    class="btn dl-btn c-secondary-bg text-white text-sm font-semibold rounded-lg px-4 py-2 hover:opacity-90 transition-opacity disabled:opacity-60 disabled:cursor-wait">
                    Download PDF
                </button>
                <button type="button" id="downloadPng" data-class="<%= cls || 'ALL' %>"
                    class="btn dl-btn bg-white text-slate-700 text-sm font-semibold rounded-lg px-4 py-2 border border-slate-300 hover:bg-slate-50 transition-colors disabled:opacity-60 disabled:cursor-wait">
                    Download PNG
                </button>
                <button type="button" onclick="window.print()"
                    class="btn bg-white text-slate-700 text-sm font-semibold rounded-lg px-4 py-2 border border-slate-300 hover:bg-slate-50 transition-colors">
                    Print
                </button>
            <% } %>
        </div>
    </div>

    <!-- Download progress (hidden until a download starts) -->
    <div id="dlProgress" class="hidden border-t border-slate-200" role="status" aria-live="polite">
        <div class="max-w-7xl mx-auto px-4 py-2 flex items-center gap-3">
            <span id="dlStage" class="text-xs text-slate-600 w-52 truncate">Preparing…</span>
            <div class="flex-1 h-2 rounded-full bg-slate-200 overflow-hidden">
                <div id="dlBar" class="c-secondary-bg h-full rounded-full transition-all duration-300" style="width:0%"></div>
            </div>
            <span id="dlPct" class="text-xs font-semibold text-slate-700 w-10 text-right">0%</span>
        </div>
    </div>
</header>
<% } %>


<main class="<%= printMode ? '' : 'max-w-7xl mx-auto px-4 py-8' %>">

    <div class="cards-grid flex flex-wrap justify-center gap-x-10 gap-y-8">

    <% if (students.length > 0) { %>
        <% students.forEach((item) => { %>

        <!-- ============ FRONT (one per student) ============ -->
        <div class="id-card c-watermark relative flex flex-col bg-white  overflow-hidden border border-slate-200 shadow-lg">

            <!-- Header: lanyard slot, logo, school name -->
            <div class="c-header relative h-[112px] shrink-0 px-4 pt-2 flex flex-col items-center text-center">
               
                <img src="<%= logo %>" alt="" class="w-9 h-9 rounded-lg bg-white p-1 object-contain shrink-0">
                <h3 class="text-white font-bold text-[10.5px] leading-tight mt-1.5 line-clamp-2 uppercase"><%= item.schoolName %></h3>
                <p class="text-white/75 text-[8px] mt-0.5">Student identification card</p>
            </div>

            <!-- Photo overlaps the curved header -->
            <div class="relative -mt-4 flex justify-center shrink-0">
                <img src="<%= item.passport || FALLBACK_AVATAR %>" alt="Photo of <%= item.fullname %>"
                    class="c-border w-[84px] h-[100px] rounded-xl object-cover border-[3px] bg-slate-100 shadow-md ring-4 ring-white">
            </div>

            <!-- Name and section -->
            <div class="relative px-4 mt-2.5 text-center shrink-0">
                <h2 class="c-primary-text text-[14px] font-extrabold leading-tight line-clamp-2"><%= item.fullname %></h2>
                <span class="c-secondary-bg inline-block mt-1.5 text-white text-[9px] font-semibold rounded-full px-3 py-0.5">
                    <%= sectionOf(item.class) %> section
                </span>
            </div>

            <!-- Details -->
            <dl class="relative px-5 mt-2.5 text-[9.5px] leading-tight">
                <div class="flex justify-between gap-2 py-1 border-b border-slate-200">
                    <dt class="text-slate-700">Student ID</dt>
                    <dd class="font-semibold text-slate-800 truncate"><%= item.studentId %></dd>
                </div>
                <div class="flex justify-between gap-2 py-1 border-b border-slate-200">
                    <dt class="text-slate-700">Admission no.</dt>
                    <dd class="font-semibold text-slate-800 truncate"><%= item.addmissionNo || 'N/A' %></dd>
                </div>
                <div class="flex justify-between gap-2 py-1">
                    <dt class="text-slate-700">Session</dt>
                    <dd class="font-semibold text-slate-800 truncate"><%= item.schoolsession || 'N/A' %></dd>
                </div>
            </dl>

            <!-- Footer -->
            <div class="c-tint relative h-8 px-3 flex items-center justify-center text-center">
                <span class="text-[7.5px] text-slate-900 leading-tight">Visit <b>www.myschoolresult.com</b> to download your result</span>
            </div>
        </div>

        <% }) %>

        <!-- ============ BACK (one shared card, no student details) ============ -->
        <div data-file="school-back" class="id-card c-watermark relative flex flex-col bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-lg">

            <div class="c-header relative h-[64px] shrink-0 px-4 pt-4 flex items-start justify-center gap-2">
              
                <img src="<%= logo %>" alt="" class="w-6 h-6 rounded-md bg-white p-0.5 object-contain shrink-0 mt-1.5">
                <p class="text-white text-[9.5px] font-semibold uppercase leading-tight line-clamp-2 mt-1.5"><%= schoolName %></p>
            </div>

            <div class="relative px-5 pt-2 text-center">
                <p class="text-[9px] text-slate-500 leading-tight">This card is the property of</p>
                <p class="c-primary-text text-[12.5px] font-extrabold uppercase leading-tight line-clamp-2"><%= schoolName %></p>
                <p class="text-[9px] text-slate-600  leading-snug">
                    The holder is a bona fide student of this school.
                </p>
            </div>

            <div class="c-tint c-border border-l-4 rounded-lg mx-4 mt-1 px-3 py-2 relative">
                <p class="c-primary-text text-[9.5px] font-bold leading-tight">If found, please return to</p>
                <p class="text-[9px] font-semibold text-slate-800 mt-0.5 line-clamp-3 leading-snug"><%= address %></p>
                <% if (phone) { %>
                    <p class="text-[9px] text-slate-600 leading-snug mt-0.5">Call <span class="font-semibold"><%= phone %></span></p>
                <% } %>
            </div>

            <p class="relative px-5 text-slate-700 text-[8px] mt-3 text-center leading-snug">Visit <b>www.myschoolresult.com/login</b> to view your profile</p>

            <div class="relative mt-auto px-5 pb-5 flex flex-col items-center">
                <div class="barcode-slot w-[150px] h-10 flex items-center justify-center">
                        <img src='https://myschoolresult.com/images/barcode.png' alt="" class="max-w-full max-h-full object-contain">
                    </div>
                <div class="w-[130px]">
                    <div class="border-b border-slate-400 h-8 flex items-end justify-center">
                        <% if (signature) { %>
                            <img src="<%= signature %>" alt="" class="max-w-full max-h-full object-contain">
                        <% } %>
                    </div>
                    <p class="text-[8px] text-slate-500 mt-1 text-center">Authorised signature</p>
                </div>
            </div>
        </div>


    <% } else if (cls) { %>

        <div class="no-print w-full text-center py-20">
            <div class="w-16 h-16 mx-auto rounded-full bg-white shadow-sm flex items-center justify-center text-2xl mb-4">🪪</div>
            <h3 class="font-bold text-lg text-slate-900">No students in <%= classLabel %></h3>
            <p class="text-sm text-slate-500 mt-1">Register students in this class, then come back to generate their cards.</p>
        </div>

    <% } else { %>

        <div class="no-print w-full text-center py-20">
            <div class="w-16 h-16 mx-auto rounded-full bg-white shadow-sm flex items-center justify-center text-2xl mb-4">🪪</div>
            <h3 class="font-bold text-lg text-slate-900">Select a class</h3>
            <p class="text-sm text-slate-500 mt-1">Choose a class to generate its student ID cards.</p>
        </div>

    <% } %>

    </div>
</main>


<script>
/* ================= BARCODES (screen and PDF) ================= */
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('canvas[data-barcode]').forEach(canvas => {
        try {
            JsBarcode(canvas, canvas.dataset.barcode, {
                format: 'CODE128',
                width: 2,
                height: 56,
                margin: 0,
                displayValue: true,
                fontSize: 18,
                textMargin: 2,
                lineColor: '#0f172a',
                background: '#ffffff'
            });
        } catch (e) {
            canvas.replaceWith(Object.assign(document.createElement('span'), {
                textContent: canvas.dataset.barcode,
                className: 'text-[10px] font-bold text-slate-700'
            }));
        }
    });
});
</script>

<% if (!printMode) { %>
<script>
/* ================= COLOUR PICKER (screen only) ================= */
document.addEventListener('DOMContentLoaded', () => {
    const KEY = 'studentCardColor';
    const DEFAULT = { primary: '#0b2a4a', secondary: '#17619a' };
    const buttons = [...document.querySelectorAll('.card-color')];
    const root = document.documentElement.style;

    function readSaved() {
        try { return JSON.parse(localStorage.getItem(KEY)) || DEFAULT; }
        catch { return DEFAULT; }
    }

    function applyColor({ primary, secondary }) {
        root.setProperty('--card-primary', primary);
        root.setProperty('--card-secondary', secondary);

        const n = parseInt(secondary.slice(1), 16);
        const [r, g, b] = [(n >> 16) & 255, (n >> 8) & 255, n & 255];
        const tint = c => Math.round(c + (255 - c) * 0.91);
        root.setProperty('--card-tint', `rgb(${tint(r)}, ${tint(g)}, ${tint(b)})`);
        root.setProperty('--card-wash', `rgba(${r}, ${g}, ${b}, .05)`);

        try { localStorage.setItem(KEY, JSON.stringify({ primary, secondary })); } catch {}

        buttons.forEach(btn => {
            const active = btn.dataset.primary === primary && btn.dataset.secondary === secondary;
            btn.setAttribute('aria-pressed', active);
            btn.classList.toggle('ring-2', active);
            btn.classList.toggle('ring-offset-2', active);
            btn.classList.toggle('ring-slate-700', active);
            btn.classList.toggle('ring-1', !active);
            btn.classList.toggle('ring-slate-300', !active);
        });
    }

    buttons.forEach(btn => btn.addEventListener('click', () =>
        applyColor({ primary: btn.dataset.primary, secondary: btn.dataset.secondary })));

    applyColor(readSaved());
});

/* ================= DOWNLOADS WITH PROGRESS ================= */
function cardParams(className, extra = {}) {
    const css = getComputedStyle(document.documentElement);
    return new URLSearchParams({
        class: className,
        primary: css.getPropertyValue('--card-primary').trim(),
        secondary: css.getPropertyValue('--card-secondary').trim(),
        ...extra
    });
}

function fileBase(className) {
    return className === 'ALL' ? 'all-students' : className.replace(/[^a-z0-9_-]/gi, '-');
}

async function saveResponse(res, filename) {
    if (!res.ok) throw new Error((await res.text()) || 'Request failed');
    const blob = await res.blob();
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 10000);
}

const ui = {
    wrap:  () => document.getElementById('dlProgress'),
    bar:   () => document.getElementById('dlBar'),
    pct:   () => document.getElementById('dlPct'),
    stage: () => document.getElementById('dlStage')
};

function showProgress(percent, stage) {
    ui.wrap().classList.remove('hidden');
    ui.bar().style.width = percent + '%';
    ui.pct().textContent = percent + '%';
    if (stage) ui.stage().textContent = stage;
}

function newJobId() {
    return (window.crypto && crypto.randomUUID)
        ? crypto.randomUUID()
        : Date.now() + '-' + Math.random().toString(16).slice(2);
}

async function runDownload(btn, { endpoint, filename, label }) {
    const className = btn.dataset.class;
    if (!className) return;

    const jobId = newJobId();
    const buttons = [...document.querySelectorAll('.dl-btn')];
    const original = btn.textContent;

    buttons.forEach(b => { b.disabled = true; });
    btn.textContent = 'Working…';
    showProgress(0, 'Preparing…');

    // Ask the server how far along it is
    let lastPercent = 0;
    const timer = setInterval(async () => {
        try {
            const r = await fetch(`/admin/student-card/download/progress/${encodeURIComponent(jobId)}`,
                { credentials: 'same-origin', cache: 'no-store' });
            if (!r.ok) return;                       // job not created yet
            const job = await r.json();
            if (job.status === 'failed') return;
            // Hold at 99% until the browser has actually received the file
            lastPercent = Math.max(lastPercent, Math.min(job.percent || 0, 99));
            showProgress(lastPercent, job.stage || label);
        } catch {}
    }, 500);

    try {
        const res = await fetch(`${endpoint}?${cardParams(className, { jobId })}`, { credentials: 'same-origin' });
        await saveResponse(res, filename(className));
        showProgress(100, 'Done');
        setTimeout(() => ui.wrap().classList.add('hidden'), 1500);
    } catch (err) {
        console.error('Download failed:', err);
        ui.wrap().classList.add('hidden');
        alert(`Could not ${label.toLowerCase()}. ${err.message || 'Please try again.'}`);
    } finally {
        clearInterval(timer);
        buttons.forEach(b => { b.disabled = false; });
        btn.textContent = original;
    }
}

document.getElementById('downloadPdf')?.addEventListener('click', e =>
    runDownload(e.currentTarget, {
        endpoint: '/admin/student-card/download/pdf',
        filename: c => `${fileBase(c)}-student-id-cards.pdf`,
        label: 'Create the PDF'
    })
);

document.getElementById('downloadPng')?.addEventListener('click', e =>
    runDownload(e.currentTarget, {
        endpoint: '/admin/student-card/download/png',
        filename: c => `${fileBase(c)}-student-cards-png.zip`,
        label: 'Export the PNG images'
    })
);
</script>
<% } %>

</body>
</html>
