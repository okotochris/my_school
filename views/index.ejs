  <body>
    <%-include('partials/header2')%>

    <section class="hero">
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <h1>Check Results Anytime, Anywhere</h1>
        <p>
          Empowering students and schools with instant online result access.
        </p>
        <a href="#result-checker" class="hero-cta">Check Result Now</a>
      </div>
    </section>

 <section
  id="result-checker"
  class="flex min-h-[calc(100vh-80px)] items-center justify-center bg-slate-50 px-4 py-12"
>
  <div class="w-full max-w-lg">

    <!-- Card -->
    <div
      class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xl shadow-slate-200/50 sm:p-8"
    >

      <!-- Header -->
      <div class="mb-8 text-center">

        <div
          class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-600 text-white shadow-lg shadow-blue-600/20"
        >
          <i data-lucide="graduation-cap" class="h-7 w-7"></i>
        </div>

        <h2 class="text-2xl font-bold tracking-tight text-slate-900">
          Check Your Results
        </h2>

        <p class="mt-2 text-sm text-slate-500">
          Enter your student details to view your academic result.
        </p>

      </div>


      <!-- Form -->
      <form
        action="/result"
        method="post"
        onsubmit="return check()"
        class="space-y-5"
      >

        <!-- Student ID -->
        <div>

          <label
            for="student-id"
            class="mb-2 block text-sm font-semibold text-slate-700"
          >
            Student ID
          </label>

          <div class="relative">

            <div
              class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400"
            >
              <i data-lucide="id-card" class="h-5 w-5"></i>
            </div>

            <input
              type="text"
              id="student-id"
              name="studentId"
              placeholder="Enter Student ID"
              required
              aria-label="Student ID"
              class="w-full rounded-xl border border-slate-200 bg-slate-50 py-3 pl-11 pr-4 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10"
            />

          </div>

        </div>


        <!-- Class -->
        <div>

          <label
            for="Sclass"
            class="mb-2 block text-sm font-semibold text-slate-700"
          >
            Class
          </label>

          <div class="relative">

            <div
              class="pointer-events-none absolute inset-y-0 left-0 z-10 flex items-center pl-3.5 text-slate-400"
            >
              <i data-lucide="school" class="h-5 w-5"></i>
            </div>

            <select
              id="Sclass"
              name="class"
              class="w-full appearance-none rounded-xl border border-slate-200 bg-slate-50 py-3 pl-11 pr-10 text-sm text-slate-700 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10"
            >
              <option value="">SELECT CLASS</option>

              <option value="SS 1">SS1</option>
              <option value="SS 2">SS2</option>
              <option value="SS 3">SS3</option>

              <option value="JSS 1">JSS1</option>
              <option value="JSS 2">JSS2</option>
              <option value="JSS 3">JSS3</option>

              <option value="BASIC 1">BASIC 1</option>
              <option value="BASIC 2">BASIC 2</option>
              <option value="BASIC 3">BASIC 3</option>
              <option value="BASIC 4">BASIC 4</option>
              <option value="BASIC 5">BASIC 5</option>
              <option value="BASIC 6">BASIC 6</option>

              <option value="NURSERY 1">NURSERY 1</option>
              <option value="NURSERY 2">NURSERY 2</option>
              <option value="NURSERY 3">NURSERY 3</option>

              <option value="PRE NURSERY">PRE-NURSERY</option>
            </select>

            <div
              class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400"
            >
              <i data-lucide="chevron-down" class="h-4 w-4"></i>
            </div>

          </div>

        </div>


        <!-- Term -->
        <div>

          <label
            for="term"
            class="mb-2 block text-sm font-semibold text-slate-700"
          >
            Term
          </label>

          <div class="relative">

            <div
              class="pointer-events-none absolute inset-y-0 left-0 z-10 flex items-center pl-3.5 text-slate-400"
            >
              <i data-lucide="calendar-days" class="h-5 w-5"></i>
            </div>

            <select
              id="term"
              name="term"
              required
              aria-label="Select Term"
              class="w-full appearance-none rounded-xl border border-slate-200 bg-slate-50 py-3 pl-11 pr-10 text-sm text-slate-700 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10"
            >
              <option value="">SELECT TERM</option>
              <option value="FIRST TERM">FIRST TERM</option>
              <option value="SECOND TERM">SECOND TERM</option>
              <option value="THIRD TERM">THIRD TERM</option>
            </select>

            <div
              class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400"
            >
              <i data-lucide="chevron-down" class="h-4 w-4"></i>
            </div>

          </div>

        </div>


        <!-- Submit -->
        <button
          type="submit"
          class="mt-2 flex w-full items-center justify-center gap-2 rounded-xl bg-blue-600 px-4 py-3 text-sm font-semibold text-white shadow-lg shadow-blue-600/20 transition hover:bg-blue-700 hover:shadow-blue-600/30 active:scale-[0.98]"
        >
          <i data-lucide="file-search" class="h-5 w-5"></i>
          <span>View Result</span>
        </button>

      </form>


      <!-- Footer -->
      <div
        class="mt-6 flex items-center justify-center gap-2 border-t border-slate-100 pt-5 text-xs text-slate-400"
      >
        <i data-lucide="shield-check" class="h-4 w-4"></i>
        <span>Your result information is secure</span>
      </div>

    </div>

  </div>
</section>


   <section id="news" class="news">
  <div class="container">
    <h2>Latest School News & Updates</h2>

    <!-- Dynamic news will be inserted here by JS -->
    <div class="news-grid">
      <p>Loading latest news...</p>
    </div>

    <div class="ad-banner" aria-hidden="true">
      <a href="/news" class="hero-cta">view more</a>
    </div>
  </div>
</section>

    <section class="features">
      <div class="container">
        <h2>Why Choose My School Result?</h2>
        <div class="features-grid">
          <article class="feature-card">
            <i class="fas fa-check-circle feature-icon"></i>
            <h3>Instant Result Access</h3>
            <p>
              Check your academic results in seconds with our user-friendly
              platform.
            </p>
          </article>
          <article class="feature-card">
            <i class="fas fa-shield-alt feature-icon"></i>
            <h3>Secure and Reliable</h3>
            <p>Your data is protected with top-tier security and encryption.</p>
          </article>
          <article class="feature-card">
            <i class="fas fa-school feature-icon"></i>
            <h3>Multi-School Support</h3>
            <p>Seamlessly manage results for multiple schools in one place.</p>
          </article>
          <article class="feature-card">
            <i class="fas fa-user-friends feature-icon"></i>
            <h3>Parent-Student Dashboard</h3>
            <p>Access personalized dashboards for students and parents.</p>
          </article>
        </div>
      </div>
    </section>
    <section class="testimonials">
      <div class="container">
        <h2>What Our Users Say</h2>
        <div class="testimonials-grid">
          <article class="testimonial-card">
            <img
              src="https://ui-avatars.com/api/?name=Student+Name&background=0D8ABC&color=fff" alt="Avatar"
              alt="Student"
              class="testimonial-image"
            />
            <p>"Checking my results was so easy and fast! Highly recommend."</p>
            <h4>Adeola, Student</h4>
          </article>
          <article class="testimonial-card">
            <img
            src="https://ui-avatars.com/api/?name=Parent+Name&background=0D8ABC&color=fff" alt="Avatar"
              alt="Parent"
              class="testimonial-image"
            />
            <p>
              "I love the parent dashboard. It keeps me updated on my child's
              progress."
            </p>
            <h4>Mrs. Okonkwo, Parent</h4>
          </article>
          <article class="testimonial-card">
            <img
             src="https://ui-avatars.com/api/?name=Admin+Name&background=0D8ABC&color=fff" alt="Avatar"
              alt="School Admin"
              class="testimonial-image"
            />
            <p>"This platform streamlined our result management process."</p>
            <h4>Principal Adebayo, School Admin</h4>
          </article>
        </div>
      </div>
    </section>

    <%-include('partials/footer') %>
    <script src="js/fetchNews.js"></script>
    <script>
      const hamburger = document.querySelector(".hamburger");
      const mobileMenu = document.querySelector(".mobile-menu");
      const closeMenu = document.querySelector(".close-menu");

      // Toggle mobile menu
      hamburger.addEventListener("click", () => {
        mobileMenu.style.display = "block";
        setTimeout(() => mobileMenu.classList.add("active"), 10);
      });

      closeMenu.addEventListener("click", () => {
        mobileMenu.classList.remove("active");
        setTimeout(() => (mobileMenu.style.display = "none"), 300);
      });

      // Hide mobile menu on resize to desktop
      window.addEventListener("resize", () => {
        if (window.innerWidth > 768) {
          mobileMenu.classList.remove("active");
          mobileMenu.style.display = "none";
        }
      });

      // Ensure mobile menu is hidden on page load for desktop
      document.addEventListener("DOMContentLoaded", () => {
        if (window.innerWidth > 768) {
          mobileMenu.style.display = "none";
        }
      });
    </script>

    <script>
    if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
            navigator.serviceWorker.register("/service-worker.js")
                .then(registration => {
                    console.log(
                        "Service Worker registered:",
                        registration.scope
                    );
                })
                .catch(error => {
                    console.error(
                        "Service Worker registration failed:",
                        error
                    );
                });
        });
    }
</script>
  </body>
</html>
