<%
    /* ---------- Optional locals (safe when not passed) ---------- */
    const printMode = !!locals.printMode;           // true when rendered for Puppeteer
    const baseUrl   = locals.baseUrl || '';
    const hex6      = /^#[0-9a-fA-F]{6}$/;
    const cPrimary   = hex6.test(locals.primary)   ? locals.primary   : '#0b2a4a';
    const cSecondary = hex6.test(locals.secondary) ? locals.secondary : '#17619a';

    // Tints calculated here so every browser (and Puppeteer) gets plain rgb values
    const n = parseInt(cSecondary.slice(1), 16);
    const [sr, sg, sb] = [(n >> 16) & 255, (n >> 8) & 255, n & 255];
    const mixWhite = (c) => Math.round(c + (255 - c) * 0.91);
    const cTint = `rgb(${mixWhite(sr)}, ${mixWhite(sg)}, ${mixWhite(sb)})`;
    const cWash = `rgba(${sr}, ${sg}, ${sb}, .04)`;

    /* ---------- Data ---------- */
    const FALLBACK_AVATAR = "data:image/svg+xml;utf8," + encodeURIComponent(
        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 96"><rect width="80" height="96" fill="#e2e8f0"/><circle cx="40" cy="36" r="16" fill="#94a3b8"/><path d="M8 96c2-22 18-32 32-32s30 10 32 32z" fill="#94a3b8"/></svg>'
    );
    const FALLBACK_LOGO = "data:image/svg+xml;utf8," + encodeURIComponent(
        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48"><rect width="48" height="48" rx="8" fill="#e2e8f0"/><path d="M24 11 7 19l17 8 17-8zM14 25v8c0 3 5 6 10 6s10-3 10-6v-8l-10 5z" fill="#94a3b8"/></svg>'
    );

    const school    = locals.schoolInfo || {};
    const logo      = (school.image && school.image.logo) || FALLBACK_LOGO;
    const phone     = school.phone || '';
    const address   = school.address || 'School address not provided';
    const signature = (school.headTeacher && school.headTeacher.signature) || '';

    const student   = Array.isArray(locals.student) ? locals.student : [];
    const cls       = locals.selectedClass || '';
    const classLabel = cls === 'ALL' ? 'All classes' : cls;
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student ID Cards</title>
    <% if (baseUrl) { %><base href="<%= baseUrl %>/"><% } %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jsbarcode/3.11.6/JsBarcode.all.min.js"></script>

    <style>
          :root {
        --card-primary: <%= primary %>;
        --card-secondary: <%= secondary %>;
    }

        body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; }

        .c-primary-text { color: var(--card-primary); }
        .c-secondary-bg { background: var(--card-secondary); }
        .c-border       { border-color: var(--card-secondary); }
        .c-tint         { background: var(--card-tint); }

        .c-header {
            background:
                radial-gradient(circle at 92% -20%, rgba(255,255,255,.22) 0 38px, transparent 39px),
                radial-gradient(circle at 80% 130%, rgba(255,255,255,.14) 0 46px, transparent 47px),
                linear-gradient(120deg, var(--card-primary), var(--card-secondary));
        }

        .c-watermark::before {
            content: "";
            position: absolute; inset: 0;
            background: repeating-linear-gradient(-45deg, var(--card-wash) 0 1px, transparent 1px 7px);
            pointer-events: none;
        }

        .id-card { width: 350px; height: 220px; }

        .swatch:focus-visible,
        .btn:focus-visible { outline: 2px solid var(--card-secondary); outline-offset: 2px; }

        html, body {
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        @page { size: A4; margin: 10mm; }

        @media print {
            html, body { background: #fff !important; }
            .no-print { display: none !important; }
            .cards-grid { gap: 6mm !important; justify-content: flex-start !important; }
            .student-card-wrapper { break-inside: avoid; page-break-inside: avoid; }
            .id-card { box-shadow: none !important; border-color: #cbd5e1 !important; }
        }
    </style>
</head>

<body class='bg-white text-slate-800 antialiased'>

<main >

    <div class="cards-grid flex flex-wrap justify-center gap-x-10 gap-y-8">

    <% if (student.length > 0) { %>
        <% student.forEach((item) => { %>

        <div class="student-card-wrapper flex flex-col gap-3">

            <!-- ============ FRONT ============ -->
            <div class="id-card c-watermark relative bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-lg">

                <div class="c-header h-[58px] px-4 flex items-center gap-3">
                    <img src="<%= logo %>" alt="" class="w-10 h-10 rounded-lg bg-white p-1 object-contain shrink-0">
                    <div class="min-w-0">
                        <h3 class="text-white font-bold text-[12px] leading-tight uppercase truncate"><%= item.schoolName %></h3>
                        <p class="text-white/75 text-[9px] mt-0.5">Student identification card</p>
                    </div>
                </div>

                <div class="relative flex gap-4 px-4 pt-3.5">
                    <img src="<%= item.passport || FALLBACK_AVATAR %>" alt="Photo of <%= item.fullname %>"
                        class="c-border w-[80px] h-[96px] shrink-0 rounded-xl object-cover border-2 bg-slate-100">

                    <div class="min-w-0 flex-1">
                        <h2 class="c-primary-text text-[15px] font-extrabold leading-tight mb-2.5 line-clamp-2"><%= item.fullname %></h2>

                        <dl class="grid grid-cols-[64px_1fr] gap-x-2 gap-y-1.5 text-[10px] leading-tight">
                            <dt class="text-slate-400">Student ID</dt>
                            <dd class="font-semibold text-slate-800 truncate"><%= item.studentId %></dd>

                            <dt class="text-slate-400">Class</dt>
                            <dd class="font-semibold text-slate-800 truncate"><%= item.class %></dd>

                            <dt class="text-slate-400">Admission</dt>
                            <dd class="font-semibold text-slate-800 truncate"><%= item.addmissionNo || 'N/A' %></dd>

                            <dt class="text-slate-400">Session</dt>
                            <dd class="font-semibold text-slate-800 truncate"><%= item.schoolsession || 'N/A' %></dd>
                        </dl>
                    </div>
                </div>

                <div class="c-tint absolute bottom-0 inset-x-0 h-7 px-4 flex items-center justify-between gap-3">
                    <span class="text-[8px] text-slate-500 truncate">Property of <%= item.schoolName %></span>
                    <span class="c-primary-text text-[9px] font-bold shrink-0"><%= item.schoolsession || '' %></span>
                </div>
            </div>


            <!-- ============ BACK ============ -->
            <div class="id-card c-watermark relative flex flex-col bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-lg">

                <div class="c-header h-[40px] shrink-0 px-4 flex items-center justify-between gap-3">
                    <p class="text-white text-[10px] font-semibold uppercase truncate"><%= item.schoolName %></p>
                    <img src="<%= logo %>" alt="" class="w-7 h-7 rounded-md bg-white p-0.5 object-contain shrink-0">
                </div>

                <div class="relative px-5 pt-2.5">
                    <p class="text-[10px] text-slate-500 leading-tight">This card certifies that</p>
                    <p class="c-primary-text text-[13px] font-extrabold uppercase leading-tight mt-0.5 truncate"><%= item.fullname %></p>
                    <p class="text-[10px] text-slate-600 mt-0.5 leading-snug truncate">
                        is a bona fide student of <span class="font-semibold text-slate-800"><%= item.schoolName %></span>.
                    </p>

                    <div class="c-tint c-border border-l-4 rounded-lg mt-2 px-3 py-1.5">
                        <p class="c-primary-text text-[10px] font-bold leading-tight">If found, please return to</p>
                        <p class="text-[10px] font-semibold text-slate-800 mt-0.5 line-clamp-2 leading-snug"><%= address %></p>
                        <% if (phone) { %>
                            <p class="text-[10px] text-slate-600 leading-snug">Call <span class="font-semibold"><%= phone %></span></p>
                        <% } %>
                    </div>
                </div>

                <!-- Signature (left) and barcode (right) -->
                 <div class="relative mt-auto px-5 pb-2.5 flex items-end justify-between gap-4">

                    <div class="w-[110px] shrink-0">
                        <div class="border-b border-slate-400 h-6 flex items-end justify-center">
                            <% if (school.headTeacher.signature) { %>
                                <img src="<%= school.headTeacher.signature ||'' %>" alt="" class="max-w-full max-h-full object-contain">
                            <% } %>
                        </div>
                        <p class="text-[8px] text-slate-500 mt-1">Authorised signature</p>
                    </div>

                    <!--
                        BARCODE SLOT (about 150 x 44 px)
                        1. item.barcode (image URL or data URI) if the student has one
                        2. otherwise a Code 128 barcode generated from the student ID
                    -->
                    <div class="barcode-slot w-[150px] h-[44px] flex items-end justify-end">
                       
                            <img src="/images/barcode.png"  class="max-w-full max-h-full object-contain">
                        
                    </div>
                </div>
            </div>

        </div>

        <% }) %>

    <% } else if (cls) { %>

        <div class="no-print w-full text-center py-20">
            <div class="w-16 h-16 mx-auto rounded-full bg-white shadow-sm flex items-center justify-center text-2xl mb-4">🪪</div>
            <h3 class="font-bold text-lg text-slate-900">No students in <%= classLabel %></h3>
            <p class="text-sm text-slate-500 mt-1">Register students in this class, then come back to generate their cards.</p>
        </div>

    <% } else { %>

        <div class="no-print w-full text-center py-20">
            <div class="w-16 h-16 mx-auto rounded-full bg-white shadow-sm flex items-center justify-center text-2xl mb-4">🪪</div>
            <h3 class="font-bold text-lg text-slate-900">Select a class</h3>
            <p class="text-sm text-slate-500 mt-1">Choose a class to generate its student ID cards.</p>
        </div>

    <% } %>

    </div>
</main>

</body>
</html>
