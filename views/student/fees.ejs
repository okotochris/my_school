
<!DOCTYPE html>
<html lang="en">

<%- include('./partials/head') %>

<body class="bg-slate-50 text-slate-800">

    <div class="min-h-screen">

        <!-- ==========================================
             NAVIGATION
        =========================================== -->

        <%- include('./partials/navigation') %>


        <!-- ==========================================
             MAIN
        =========================================== -->

        <main class="lg:ml-64">

            <!-- HEADER -->

            <%- include('./partials/header') %>


            <!-- ==========================================
                 CONTENT
            =========================================== -->

            <div class="flex flex-col items-center justify-center py-12 px-6 text-center">
                    <div class="w-16 h-16 flex items-center justify-center rounded-full bg-blue-100 text-blue-600 mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg"
                            class="w-8 h-8"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor">
                            <path stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                        </svg>
                    </div>

                    <h3 class="text-lg font-semibold text-gray-800">
                        No Items
                    </h3>

                    <p class="mt-1 text-sm text-gray-500 max-w-sm">
                        No history.
                    </p>
                </div>

        </main>

    </div>


    <!-- ==========================================
         MOBILE MENU SCRIPT
    =========================================== -->

    <script>

        const menuButton = document.getElementById("menuButton");
        const mobileMenu = document.getElementById("mobileMenu");


        if (menuButton && mobileMenu) {

            menuButton.addEventListener("click", (event) => {

                event.stopPropagation();

                mobileMenu.classList.toggle("hidden");

            });


            document.addEventListener("click", (event) => {

                if (
                    !mobileMenu.contains(event.target) &&
                    !menuButton.contains(event.target)
                ) {

                    mobileMenu.classList.add("hidden");

                }

            });

        }


        // ==========================================
        // PAYMENT BUTTON
        // ==========================================

        const paymentAmount =
            document.getElementById("paymentAmount");

        const payButton =
            document.getElementById("payButton");


        if (paymentAmount && payButton) {

            paymentAmount.addEventListener("input", function () {

                let amount = Number(this.value) || 0;

                if (amount > 50000) {
                    amount = 50000;
                    this.value = 50000;
                }

                if (amount < 0) {
                    amount = 0;
                    this.value = 0;
                }

                payButton.innerHTML = `
                    <span>💳</span>
                    Pay ₦${amount.toLocaleString()} Now
                `;

            });


            payButton.addEventListener("click", function () {

                const amount =
                    Number(paymentAmount.value);


                if (!amount || amount < 100) {

                    alert("Please enter a valid payment amount.");

                    return;

                }


                /*
                ==========================================
                LATER CONNECT TO PAYSTACK
                ==========================================

                Example:

                fetch('/student/fees/pay', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        amount: amount
                    })
                });

                Your backend should initialize
                the Paystack transaction.

                Never trust the amount or payment
                status from the frontend.

                ==========================================
                */

                alert(
                    `Payment of ₦${amount.toLocaleString()} will be processed here.`
                );

            });

        }

    </script>

</body>

</html>

