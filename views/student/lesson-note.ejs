<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Lesson Notes</title>
    <%- include('./partials/head') %>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
</head>

<body class="min-h-screen">
    <div class="min-h-screen">
         <%- include('./partials/navigation') %>

    <!-- MAIN -->
    <main class="lg:ml-64">
    <!-- HEADER -->
    <%- include('./partials/header') %>
    <section class="mx-auto max-w-250 p-4 sm:p-6 lg:p-8">
        <!-- SEARCH / INFO -->
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">

            <div>
                <h2 class="text-xl font-bold text-slate-900">
                    Available Lessons
                </h2>

                <p id="studentInfo" class="text-sm text-slate-500 mt-1">
                    Loading...
                </p>
            </div>


            <div class="relative w-full md:w-80">

                <i data-lucide="search"
                   class="absolute left-3 top-1/2 -translate-y-1/2
                          w-4 h-4 text-slate-400">
                </i>

                <input
                    type="text"
                    id="searchInput"
                    placeholder="Search subject or topic..."
                    class="w-full rounded-lg border border-slate-200
                           bg-white py-2.5 pl-10 pr-4 text-sm
                           outline-none
                           focus:border-[#0b2a4a]
                           focus:ring-1 focus:ring-[#0b2a4a]"
                >

            </div>

        </div>


        <!-- LOADING -->
        <div id="loadingState"
             class="flex flex-col items-center justify-center
                    py-20">

            <div class="w-10 h-10 rounded-full
                        border-4 border-slate-200
                        border-t-[#0b2a4a]
                        animate-spin">
            </div>

            <p class="text-sm text-slate-500 mt-4">
                Loading lesson notes...
            </p>

        </div>


        <!-- ERROR -->
        <div id="errorState"
             class="hidden bg-white border border-red-100
                    rounded-2xl p-10 text-center">

            <div class="w-14 h-14 mx-auto rounded-full
                        bg-red-50 text-red-500
                        flex items-center justify-center">

                <i data-lucide="alert-circle" class="w-7 h-7"></i>

            </div>

            <h3 class="text-lg font-semibold text-slate-900 mt-4">
                Unable to load lesson notes
            </h3>

            <p id="errorMessage"
               class="text-sm text-slate-500 mt-1">
                Something went wrong.
            </p>

            <button
                onclick="loadLessonNotes()"
                class="mt-5 inline-flex items-center gap-2
                       rounded-lg bg-[#0b2a4a]
                       px-4 py-2.5
                       text-sm font-medium text-white
                       hover:bg-[#09233f]">

                <i data-lucide="refresh-cw" class="w-4 h-4"></i>

                Try Again

            </button>

        </div>


        <!-- EMPTY -->
        <div id="emptyState"
             class="hidden bg-white border border-slate-200
                    rounded-2xl p-10 text-center">

            <div class="w-14 h-14 mx-auto
                        rounded-full bg-[#0b2a4a]/10
                        text-[#0b2a4a]
                        flex items-center justify-center">

                <i data-lucide="book-open" class="w-7 h-7"></i>

            </div>

            <h3 class="text-lg font-semibold text-slate-900 mt-4">
                No lesson notes available
            </h3>

            <p class="text-sm text-slate-500 mt-1">
                There are currently no lesson notes for your class.
            </p>

        </div>


        <!-- LESSON GRID -->
        <div
            id="lessonGrid"
            class="hidden grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
        </div>


        <!-- SEARCH EMPTY -->
        <div id="searchEmpty"
             class="hidden bg-white border border-slate-200
                    rounded-2xl p-10 text-center">

            <div class="w-12 h-12 mx-auto
                        rounded-full bg-slate-100
                        text-slate-400
                        flex items-center justify-center">

                <i data-lucide="search-x" class="w-6 h-6"></i>

            </div>

            <h3 class="font-semibold text-slate-900 mt-4">
                No matching lesson
            </h3>

            <p class="text-sm text-slate-500 mt-1">
                Try searching for another subject or topic.
            </p>

        </div>
    </section>
    </main>

    </div>

    <script>

        lucide.createIcons();


        const API_URL = "<%= process.env.NEXT_PUBLIC_API_URL %>";


        let lessonNotes = [];


        // ==========================================
        // LOAD LESSON NOTES
        // ==========================================

        async function loadLessonNotes() {

            const loadingState = document.getElementById("loadingState");
            const errorState = document.getElementById("errorState");
            const emptyState = document.getElementById("emptyState");
            const lessonGrid = document.getElementById("lessonGrid");
            const searchEmpty = document.getElementById("searchEmpty");

            try {

                loadingState.classList.remove("hidden");
                errorState.classList.add("hidden");
                emptyState.classList.add("hidden");
                lessonGrid.classList.add("hidden");
                searchEmpty.classList.add("hidden");


                // ==========================================
                // GET STUDENT FROM LOCAL STORAGE
                // ==========================================

                const studentData = localStorage.getItem("student");


                if (!studentData) {

                    throw new Error(
                        "Student information was not found. Please login again."
                    );

                }


                const student = JSON.parse(studentData);


                console.log("Student:", student);


                // ==========================================
                // GET SCHOOL AND CLASS
                // ==========================================

                const school = student.schoolName;
                const studentClass = student.class;


                if (!school || !studentClass) {

                    throw new Error(
                        "Student school or class information is missing."
                    );

                }


                // ==========================================
                // DISPLAY STUDENT INFORMATION
                // ==========================================

                document.getElementById("studentInfo").textContent =
                    `${studentClass} • ${school}`;


                // ==========================================
                // SEND GET REQUEST
                // ==========================================

                const response = await fetch(
                    `/student/lesson-notes?school=${encodeURIComponent(school)}&class=${encodeURIComponent(studentClass)}`,
                    {
                        method: "GET",
                        headers: {
                            "Content-Type": "application/json"
                        }
                    }
                );


                if (!response.ok) {

                    throw new Error(
                        "Unable to retrieve lesson notes."
                    );

                }


                const result = await response.json();


                console.log("Lesson notes:", result);


                // Depending on your API response
                lessonNotes = result.data || result.lessonNotes || result;


                // ==========================================
                // HIDE LOADING
                // ==========================================

                loadingState.classList.add("hidden");


                // ==========================================
                // CHECK EMPTY
                // ==========================================

                if (!Array.isArray(lessonNotes) || lessonNotes.length === 0) {

                    emptyState.classList.remove("hidden");

                    return;

                }


                // ==========================================
                // DISPLAY LESSONS
                // ==========================================

                renderLessons(lessonNotes);

            } catch (error) {

                console.error(error);

                loadingState.classList.add("hidden");

                errorState.classList.remove("hidden");

                document.getElementById("errorMessage").textContent =
                    error.message || "Something went wrong.";

                lucide.createIcons();

            }

        }


        // ==========================================
        // RENDER LESSON CARDS
        // ==========================================

        function renderLessons(lessons) {

            const lessonGrid =
                document.getElementById("lessonGrid");

            lessonGrid.innerHTML = "";


            lessons.forEach(lesson => {

                const card = document.createElement("a");


                /*
                 * Clicking the card takes the student
                 * to the lesson detail page.
                 */
                card.href =
                    `/student/lesson-notes/${lesson._id}`;


                card.className = `
                    lesson-card
                    group
                    block
                    bg-white
                    border
                    border-slate-200
                    rounded-2xl
                    overflow-hidden
                    shadow-sm
                    hover:shadow-md
                    hover:border-[#0b2a4a]/30
                    transition
                    duration-200
                `;


                const statusHTML =
                    lesson.status === "published"

                        ? `
                            <span class="
                                inline-flex
                                items-center
                                gap-1.5
                                rounded-full
                                bg-emerald-50
                                px-2.5
                                py-1
                                text-xs
                                font-semibold
                                text-emerald-700
                            ">
                                <span class="
                                    w-1.5
                                    h-1.5
                                    rounded-full
                                    bg-emerald-500
                                "></span>

                                Published
                            </span>
                        `

                        : `
                            <span class="
                                inline-flex
                                items-center
                                gap-1.5
                                rounded-full
                                bg-amber-50
                                px-2.5
                                py-1
                                text-xs
                                font-semibold
                                text-amber-700
                            ">
                                <span class="
                                    w-1.5
                                    h-1.5
                                    rounded-full
                                    bg-amber-500
                                "></span>

                                Draft
                            </span>
                        `;


                card.innerHTML = `

                    <!-- CARD BODY -->

                    <div class="p-5">

                        <div class="
                            flex
                            items-start
                            justify-between
                            gap-3
                        ">

                            <div class="
                                w-11
                                h-11
                                shrink-0
                                rounded-xl
                                bg-[#0b2a4a]/10
                                flex
                                items-center
                                justify-center
                                text-[#0b2a4a]
                            ">

                                <i
                                    data-lucide="book-open"
                                    class="w-5 h-5">
                                </i>

                            </div>


                            ${statusHTML}

                        </div>


                        <!-- SUBJECT -->

                        <p class="
                            text-xs
                            font-semibold
                            uppercase
                            tracking-wide
                            text-[#0b2a4a]
                            mt-5
                        ">
                            ${escapeHTML(lesson.subject || "")}
                        </p>


                        <!-- TOPIC -->

                        <h3 class="
                            text-lg
                            font-bold
                            text-slate-900
                            mt-1
                            group-hover:text-[#0b2a4a]
                            transition
                        ">
                            ${escapeHTML(lesson.topic || "Untitled Lesson")}
                        </h3>


                        <!-- SUB TOPIC -->

                        ${
                            lesson.subTopic

                                ? `
                                    <p class="
                                        text-sm
                                        text-slate-500
                                        mt-1
                                        line-clamp-2
                                    ">
                                        ${escapeHTML(lesson.subTopic)}
                                    </p>
                                `

                                : ""
                        }


                        <!-- META -->

                        <div class="
                            grid
                            grid-cols-2
                            gap-3
                            mt-5
                        ">


                            <div class="
                                flex
                                items-center
                                gap-2
                            ">

                                <i
                                    data-lucide="users"
                                    class="w-4 h-4 text-slate-400">
                                </i>

                                <div>

                                    <p class="
                                        text-[11px]
                                        text-slate-400
                                    ">
                                        Class
                                    </p>

                                    <p class="
                                        text-xs
                                        font-semibold
                                        text-slate-700
                                    ">
                                        ${escapeHTML(lesson.class || "")}
                                    </p>

                                </div>

                            </div>


                            <div class="
                                flex
                                items-center
                                gap-2
                            ">

                                <i
                                    data-lucide="calendar-days"
                                    class="w-4 h-4 text-slate-400">
                                </i>

                                <div>

                                    <p class="
                                        text-[11px]
                                        text-slate-400
                                    ">
                                        Week
                                    </p>

                                    <p class="
                                        text-xs
                                        font-semibold
                                        text-slate-700
                                    ">
                                        Week ${lesson.week || ""}
                                    </p>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- CARD FOOTER -->

                    <div class="
                        border-t
                        border-slate-100
                        px-5
                        py-3.5
                        flex
                        items-center
                        justify-between
                    ">

                        <div class="
                            flex
                            items-center
                            gap-2
                        ">

                            <div class="
                                w-7
                                h-7
                                rounded-full
                                bg-[#0b2a4a]/10
                                flex
                                items-center
                                justify-center
                                text-[#0b2a4a]
                            ">

                                <i
                                    data-lucide="user"
                                    class="w-3.5 h-3.5">
                                </i>

                            </div>

                            <span class="
                                text-xs
                                text-slate-500
                            ">
                                ${escapeHTML(
                                    lesson.teacherName || "Teacher"
                                )}
                            </span>

                        </div>


                        <span class="
                            flex
                            items-center
                            gap-1
                            text-xs
                            font-semibold
                            text-[#0b2a4a]
                            group-hover:gap-2
                            transition-all
                        ">

                            View lesson

                            <i
                                data-lucide="arrow-right"
                                class="w-4 h-4">
                            </i>

                        </span>

                    </div>
                `;


                lessonGrid.appendChild(card);

            });


            lessonGrid.classList.remove("hidden");


            // Activate Lucide icons
            lucide.createIcons();

        }


        // ==========================================
        // SEARCH
        // ==========================================

        document
            .getElementById("searchInput")
            .addEventListener("input", function () {

                const search =
                    this.value
                        .toLowerCase()
                        .trim();


                const cards =
                    document.querySelectorAll(".lesson-card");


                let found = 0;


                cards.forEach(card => {

                    const text =
                        card.textContent.toLowerCase();


                    if (text.includes(search)) {

                        card.classList.remove("hidden");

                        found++;

                    } else {

                        card.classList.add("hidden");

                    }

                });


                const searchEmpty =
                    document.getElementById("searchEmpty");


                if (search && found === 0) {

                    searchEmpty.classList.remove("hidden");

                } else {

                    searchEmpty.classList.add("hidden");

                }

            });


        // ==========================================
        // HTML ESCAPE
        // ==========================================

        function escapeHTML(value) {

            const div = document.createElement("div");

            div.textContent = value;

            return div.innerHTML;

        }


        // ==========================================
        // LOAD PAGE
        // ==========================================

        document.addEventListener(
            "DOMContentLoaded",
            loadLessonNotes
        );

    </script>

</body>
</html>