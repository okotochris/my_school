
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scheme of Work Details</title>
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        :root {
            --primary: #0b2a4a;
            --secondary: #17619a;
        }

        .bg-primary {
            background-color: var(--primary);
        }

        .text-primary {
            color: var(--primary);
        }

        .border-primary {
            border-color: var(--primary);
        }
    </style>
</head>

<body class="min-h-screen bg-slate-50 text-slate-800">

<%
    const scheme = schemeOfWork || {};
    const weeks = Array.isArray(scheme.weeks) ? scheme.weeks : [];

    const formatDate = (date) => {
        if (!date) return 'Not available';

        return new Date(date).toLocaleDateString('en-NG', {
            day: 'numeric',
            month: 'short',
            year: 'numeric'
        });
    };
%>

<div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 lg:px-8">

    <!-- Back Navigation -->
    <div class="mb-6">
        <a href="/admin/dashboard"
           class="inline-flex items-center gap-2 text-sm font-medium text-slate-500 hover:text-primary">
            <span aria-hidden="true">←</span>
            Back to Dashboard
        </a>
    </div>

    <!-- Page Header -->
    <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
        <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-blue-600">
                Academic Resources
            </p>

            <h1 class="mt-2 text-2xl font-bold text-slate-900 sm:text-3xl">
                Scheme of Work
            </h1>

            <p class="mt-2 text-sm text-slate-500">
                View the complete weekly teaching plan for this subject.
            </p>
        </div>

        <div class="flex flex-wrap gap-3">
            <a href="/admin/scheme-of-work"
               class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-100">
                All Schemes
            </a>

            <% if (scheme.status === 'draft') { %>
                <span class="inline-flex items-center rounded-xl bg-amber-50 px-4 py-2.5 text-sm font-semibold text-amber-700">
                    Draft
                </span>
            <% } else { %>
                <span class="inline-flex items-center rounded-xl bg-green-50 px-4 py-2.5 text-sm font-semibold text-green-700">
                    Published
                </span>
            <% } %>
        </div>
    </div>

    <!-- Overview Card -->
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

        <div class="bg-primary px-5 py-6 text-white sm:px-8">
            <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-white/15 px-3 py-1 text-xs font-semibold">
                    <%= scheme.studentClass || 'Class not specified' %>
                </span>

                <span class="rounded-full bg-white/15 px-3 py-1 text-xs font-semibold">
                    <%= scheme.subject || 'Subject not specified' %>
                </span>
            </div>

            <h2 class="mt-4 text-2xl font-bold sm:text-3xl">
                <%= scheme.subject || 'Untitled Subject' %>
            </h2>

            <p class="mt-2 text-sm text-blue-100">
                <%= scheme.term || 'Term not specified' %>
                <span class="mx-1">•</span>
                <%= scheme.session || 'Session not specified' %>
            </p>
        </div>

        <div class="grid grid-cols-1 divide-y divide-slate-100 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
            <div class="p-5">
                <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                    Total Weeks
                </p>
                <p class="mt-2 text-2xl font-bold text-slate-900">
                    <%= weeks.length %>
                </p>
                <p class="mt-1 text-xs text-slate-500">Teaching weeks planned</p>
            </div>

            <div class="p-5">
                <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                    Prepared By
                </p>
                <p class="mt-2 font-semibold text-slate-900">
                    <%= scheme.teacherName || 'Not specified' %>
                </p>
                <p class="mt-1 text-xs text-slate-500">Teacher</p>
            </div>

            <div class="p-5">
                <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                    Date Created
                </p>
                <p class="mt-2 font-semibold text-slate-900">
                    <%= formatDate(scheme.createdAt) %>
                </p>
                <p class="mt-1 text-xs text-slate-500">Last updated <%= formatDate(scheme.updatedAt) %></p>
            </div>
        </div>
    </div>

    <!-- Weekly Plan -->
    <div class="mt-8">
        <div class="mb-5 flex flex-col justify-between gap-2 sm:flex-row sm:items-end">
            <div>
                <h2 class="text-xl font-bold text-slate-900">Weekly Teaching Plan</h2>
                <p class="mt-1 text-sm text-slate-500">
                    Detailed learning objectives and activities for each week.
                </p>
            </div>

            <span class="text-sm font-medium text-slate-500">
                <%= weeks.length %> week(s)
            </span>
        </div>

        <% if (weeks.length === 0) { %>

            <div class="rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center">
                <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-100 text-2xl">
                    📚
                </div>

                <h3 class="mt-4 font-bold text-slate-900">No weekly plan available</h3>

                <p class="mt-2 text-sm text-slate-500">
                    No teaching weeks have been added to this scheme yet.
                </p>
            </div>

        <% } else { %>

            <div class="space-y-5">
                <% weeks.forEach((week, index) => { %>

                    <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

                        <div class="flex items-start gap-4 border-b border-slate-100 bg-slate-50/80 p-5">
                            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-primary text-lg font-bold text-white">
                                <%= week.week || index + 1 %>
                            </div>

                            <div class="min-w-0 flex-1">
                                <p class="text-xs font-semibold uppercase tracking-wider text-blue-600">
                                    Week <%= week.week || index + 1 %>
                                </p>

                                <h3 class="mt-1 break-words text-lg font-bold text-slate-900">
                                    <%= week.topic || 'Topic not provided' %>
                                </h3>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 gap-5 p-5 md:grid-cols-2">

                            <!-- Subtopics -->
                            <section>
                                <h4 class="flex items-center gap-2 text-sm font-bold text-slate-800">
                                    <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 text-blue-700">01</span>
                                    Subtopics
                                </h4>

                                <div class="mt-3 whitespace-pre-line break-words rounded-xl bg-slate-50 p-4 text-sm leading-6 text-slate-600">
                                    <%= week.subtopics || 'No subtopics added.' %>
                                </div>
                            </section>

                            <!-- Objectives -->
                            <section>
                                <h4 class="flex items-center gap-2 text-sm font-bold text-slate-800">
                                    <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-green-50 text-green-700">02</span>
                                    Learning Objectives
                                </h4>

                                <div class="mt-3 whitespace-pre-line break-words rounded-xl bg-slate-50 p-4 text-sm leading-6 text-slate-600">
                                    <%= week.objectives || 'No learning objectives added.' %>
                                </div>
                            </section>

                            <!-- Activities -->
                            <section>
                                <h4 class="flex items-center gap-2 text-sm font-bold text-slate-800">
                                    <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-purple-50 text-purple-700">03</span>
                                    Teaching Activities
                                </h4>

                                <div class="mt-3 whitespace-pre-line break-words rounded-xl bg-slate-50 p-4 text-sm leading-6 text-slate-600">
                                    <%= week.activities || 'No activities added.' %>
                                </div>
                            </section>

                            <!-- Resources -->
                            <section>
                                <h4 class="flex items-center gap-2 text-sm font-bold text-slate-800">
                                    <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-orange-50 text-orange-700">04</span>
                                    Instructional Resources
                                </h4>

                                <div class="mt-3 whitespace-pre-line break-words rounded-xl bg-slate-50 p-4 text-sm leading-6 text-slate-600">
                                    <%= week.resources || 'No resources added.' %>
                                </div>
                            </section>

                        </div>
                    </article>

                <% }); %>
            </div>

        <% } %>
    </div>

    <!-- Additional Information -->
    <div class="mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-100 px-5 py-4">
            <h2 class="font-bold text-slate-900">Additional Information</h2>
            <p class="mt-1 text-sm text-slate-500">
                Extra notes or instructions for this scheme.
            </p>
        </div>

        <div class="whitespace-pre-line break-words p-5 text-sm leading-7 text-slate-600">
            <%= scheme.additionalInformation || 'No additional information provided.' %>
        </div>
    </div>

    <!-- Footer -->
    <div class="mt-8 flex flex-col justify-between gap-3 border-t border-slate-200 py-5 text-xs text-slate-400 sm:flex-row">
        <p>MySchoolResult — Helping Schools Go Digital</p>
        <p>Scheme of Work Details</p>
    </div>

</div>

</body>
</html>