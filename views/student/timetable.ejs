
<!DOCTYPE html>
<html lang="en">

<%- include('./partials/head') %>

<body class="bg-slate-50 text-slate-800">

    <div class="min-h-screen">

        <!-- ==========================================
             NAVIGATION
        =========================================== -->

        <%- include('./partials/navigation') %>

        <!-- ==========================================
             MAIN
        =========================================== -->
        <main class="lg:ml-64">

            <!-- ==========================================
                 CONTENT
            =========================================== -->

            <section class="mx-auto max-w-[1300px] p-4 sm:p-6 lg:p-8">

                  <!-- HEADER -->

            <%- include('./partials/header') %>
                <!-- ==========================================
                     PAGE HEADER
                =========================================== -->

                <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

                    <div>

                        <h1 class="text-xl font-bold text-slate-900 sm:text-2xl">
                            Class Timetable
                        </h1>

                        <p class="mt-1 text-sm text-slate-500">
                            View your weekly class schedule.
                        </p>

                    </div>


                    <!-- Current term -->

                    <div class="flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 shadow-sm">

                        <span class="text-sm">
                            📅
                        </span>

                        <div>

                            <p class="text-[10px] font-medium uppercase tracking-wide text-slate-400">
                                Academic Session
                            </p>

                            <p class="text-xs font-semibold text-slate-700">
                                2025/2026 • Second Term
                            </p>

                        </div>

                    </div>

                </div>




                <!-- ==========================================
                     TIMETABLE CARD
                =========================================== -->

                <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">


                    <!-- Card Header -->

                    <div id="timetable-header" class="flex flex-col gap-3 border-b border-slate-100 px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">



                        <!-- Print button -->

                        

                    </div>


                    <!-- ======================================
                         TABLE
                    ======================================= -->

                    <div id='time-table' class="overflow-x-auto">

                       

                    </div>

                </div>


              


                <!-- ==========================================
                     NOTICE
                =========================================== -->

                <div class="mt-6 flex gap-3 rounded-xl border border-blue-100 bg-blue-50 p-4">

                    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-blue-100 text-sm">
                        ℹ️
                    </div>

                    <div>

                        <p class="text-xs font-semibold text-blue-900">
                            Timetable Notice
                        </p>

                        <p class="mt-1 text-xs leading-5 text-blue-700">
                            Students are expected to be seated in their
                            classrooms before the start of each period.
                            Timetable changes will be communicated through
                            the student portal.
                        </p>

                    </div>

                </div>

            </section>

        </main>

    </div>


    <!-- ==========================================
         PRINT STYLES
    =========================================== -->
    //lucid-react script
    <script src="https://unpkg.com/lucide@latest/dist/lucide.js"></script>
    <style>

        @media print {

            body {
                background: white !important;
            }

            body * {
                visibility: hidden;
            }

            main,
            main * {
                visibility: visible;
            }

            main {
                margin-left: 0 !important;
            }

            header,
            button,
            #timetable-header,
            nav,
            aside {
                display: none !important;
            }

            section {
                padding: 0 !important;
                max-width: none !important;
            }

            .shadow-sm {
                box-shadow: none !important;
            }

        }

    </style>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        getTimetable()
    })
    async function getTimetable(){
        const saveStudent = localStorage.getItem('student')
        const student = JSON.parse(saveStudent)
        try {
           const result = await fetch(`/admin/timetable/${student.class}/${student.schoolName}`)
           if(!result){
            showMessagePopup("unable to get timetable")
            return;
           }
           const timetable = await result.json()
           render(timetable, student.class)
            
        } catch (error) {
            
            console.log(error)
        }
    }
    function render(timetable, studentClass){
        document.getElementById('timetable-header').innerHTML = `
                 <div class="w-full grid grid-cols-2 sm:grid-cols-5 gap-4 mb-6">

                <div
                    class="bg-white border border-slate-200
                        rounded-2xl p-4"
                >

                    <p class="text-xs text-slate-400">
                        Class
                    </p>

                    <p class="text-lg font-bold text-[#0b2a4a] mt-1">
                       ${studentClass}
                    </p>

                </div>


                <div
                    class="bg-white border border-slate-200
                        rounded-2xl p-4"
                >

                    <p class="text-xs text-slate-400">
                        Periods
                    </p>

                    <p class="text-lg font-bold text-[#0b2a4a] mt-1">
                         ${timetable.length}
                    </p>

                </div>


                <div
                    class="bg-white border border-slate-200
                        rounded-2xl p-4"
                >

                    <p class="text-xs text-slate-400">
                        School Days
                    </p>

                    <p class="text-lg font-bold text-[#0b2a4a] mt-1">
                        ${new Set(timetable.map(item => item.day)).size }
                    </p>

                </div>


                <div
                    class="bg-white border border-slate-200
                        rounded-2xl p-4"
                >

                    <p class="text-xs text-slate-400">
                        Status
                    </p>

                    <p class="text-lg font-bold text-emerald-600 mt-1">
                        Active
                    </p>

                </div>
                <button
                            onclick="window.print()"
                            class="inline-flex w-fit items-center gap-2 rounded-lg bg-[#0b2a4a] px-3 py-2 text-xs font-semibold text-white transition hover:bg-[#17619a]"
                        >
                            🖨️
                            Print Timetable
                        </button>

            </div>
        `

       renderTimetable(timetable, studentClass)
    }

    function renderTimetable(timetable, studentClass) {
    const container = document.getElementById("time-table");

    const days = [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday"
    ];

    // Get unique periods and sort them
    const periods = [
        ...new Set(timetable.map(item => item.period))
    ].sort((a, b) => a - b);

    // Empty timetable
    if (periods.length === 0) {
        container.innerHTML = `
            <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">

                <div class="py-16 text-center">

                    <div class="w-14 h-14 mx-auto rounded-xl bg-blue-50
                                flex items-center justify-center">

                        <i
                            data-lucide="calendar-x"
                            class="w-7 h-7 text-[#17619a]"
                        ></i>

                    </div>

                    <h3 class="text-lg font-semibold text-[#0b2a4a] mt-4">
                        No timetable available
                    </h3>

                    <p class="text-sm text-slate-500 mt-1">
                        No timetable has been created for ${studentClass} yet.
                    </p>

                </div>

            </div>
        `;

        lucide.createIcons();
        return;
    }

    // Render timetable
    container.innerHTML = `
        <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">

            <!-- TABLE TITLE -->
            <div class="px-5 sm:px-6 py-4 border-b border-slate-200
                        flex items-center justify-between">

                <div>

                    <h2 class="font-semibold text-[#0b2a4a]">
                        Weekly Timetable
                    </h2>

                    <p class="text-xs text-slate-400 mt-1">
                        ${studentClass} class schedule
                    </p>

                </div>

            </div>


            <!-- HORIZONTAL SCROLL -->
            <div class="overflow-x-auto">

                <div class="min-w-[1000px]">

                    <!-- DAYS HEADER -->
                    <div class="grid grid-cols-[120px_repeat(5,1fr)]
                                bg-slate-50 border-b border-slate-200">

                        <div class="px-4 py-4 text-xs font-semibold
                                    text-slate-500 uppercase">
                            Time
                        </div>

                        ${days.map(day => `
                            <div class="px-4 py-4 text-center
                                        text-xs font-semibold
                                        text-[#0b2a4a] uppercase">
                                ${day}
                            </div>
                        `).join("")}

                    </div>


                    <!-- PERIODS -->
                    ${periods.map(period => {

                        const periodItems = timetable.filter(
                            item => item.period === period
                        );

                        const firstItem = periodItems[0];

                        return `
                            <div class="grid grid-cols-[120px_repeat(5,1fr)]
                                        border-b border-slate-100
                                        last:border-b-0">

                                <!-- TIME -->
                                <div class="px-4 py-4 bg-slate-50/60
                                            border-r border-slate-100
                                            flex flex-col justify-center">

                                    <span class="text-sm font-semibold
                                                 text-[#0b2a4a]">
                                        ${firstItem.startTime}
                                    </span>

                                    <span class="text-xs text-slate-400 mt-1">
                                        ${firstItem.endTime}
                                    </span>

                                    <span class="text-[10px] text-slate-400
                                                 mt-2 uppercase">
                                        Period ${period}
                                    </span>

                                </div>


                                <!-- DAYS -->
                                ${days.map(day => {

                                    const item = timetable.find(
                                        timetableItem =>
                                            timetableItem.day === day &&
                                            timetableItem.period === period
                                    );

                                    // Empty slot
                                    if (!item) {
                                        return `
                                            <div class="p-2 border-r
                                                        border-slate-100
                                                        last:border-r-0
                                                        min-h-[115px]">

                                                <div class="h-full min-h-[95px]
                                                            flex items-center
                                                            justify-center">

                                                    <span class="text-xs
                                                                 text-slate-300">
                                                        —
                                                    </span>

                                                </div>

                                            </div>
                                        `;
                                    }

                                    // Break
                                    if (item.type === "break") {
                                        return `
                                            <div class="p-2 border-r
                                                        border-slate-100
                                                        last:border-r-0
                                                        min-h-[115px]">

                                                <div class="h-full min-h-[95px]
                                                            rounded-xl
                                                            bg-slate-50
                                                            border border-dashed
                                                            border-slate-200
                                                            flex flex-col
                                                            items-center
                                                            justify-center">

                                                    <i
                                                        data-lucide="coffee"
                                                        class="w-5 h-5 text-slate-400"
                                                    ></i>

                                                    <span class="text-xs
                                                                 font-semibold
                                                                 text-slate-500
                                                                 mt-2">
                                                        Break
                                                    </span>

                                                </div>

                                            </div>
                                        `;
                                    }

                                    // Normal lesson / exam
                                    return `
                                        <div class="p-2 border-r
                                                    border-slate-100
                                                    last:border-r-0
                                                    min-h-[115px]">

                                            <div class="h-full min-h-[95px]
                                                        rounded-xl
                                                        bg-blue-50
                                                        border border-blue-100
                                                        p-3">

                                                <div class="flex items-start
                                                            justify-between
                                                            gap-2">

                                                    <h3 class="text-sm
                                                               font-semibold
                                                               text-[#0b2a4a]">
                                                        ${item.subject}
                                                    </h3>

                                                    ${
                                                        item.type === "exam"
                                                            ? `
                                                                <span class="text-[9px]
                                                                             px-1.5 py-0.5
                                                                             rounded-full
                                                                             bg-amber-100
                                                                             text-amber-700
                                                                             font-semibold">
                                                                    Exam
                                                                </span>
                                                            `
                                                            : ""
                                                    }

                                                </div>


                                                ${
                                                    item.teacher
                                                        ? `
                                                            <div class="flex items-center
                                                                        gap-1.5 mt-3">

                                                                <i
                                                                    data-lucide="user"
                                                                    class="w-3.5 h-3.5
                                                                           text-[#17619a]"
                                                                ></i>

                                                                <span class="text-xs
                                                                             text-slate-600">
                                                                    ${item.teacher}
                                                                </span>

                                                            </div>
                                                        `
                                                        : ""
                                                }


                                                ${
                                                    item.room
                                                        ? `
                                                            <div class="flex items-center
                                                                        gap-1.5 mt-1.5">

                                                                <i
                                                                    data-lucide="map-pin"
                                                                    class="w-3.5 h-3.5
                                                                           text-[#17619a]"
                                                                ></i>

                                                                <span class="text-xs
                                                                             text-slate-500">
                                                                    ${item.room}
                                                                </span>

                                                            </div>
                                                        `
                                                        : ""
                                                }

                                            </div>

                                        </div>
                                    `;

                                }).join("")}

                            </div>
                        `;

                    }).join("")}

                </div>

            </div>

        </div>
    `;

    // Reinitialize Lucide icons after inserting HTML
    lucide.createIcons();
}
</script>
</body>
</html>

