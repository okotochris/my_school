    <!-- ==========================================
         MOBILE MENU SCRIPT
    =========================================== -->

    <script>
       
    window.onload= async function getStudentResult(){
        const savedStudent = localStorage.getItem('student')
        if(!savedStudent){
            console.log('no student')
            return
        }
        const student = JSON.parse(savedStudent)
        console.log(student)
        const response = await fetch(`/api/get_result?studentId=${student.studentId}`);
        const data = await response.json();
        document.querySelector('.term').innerText = `${data[0].term } ${data[0].section }`
        document.getElementById('download').href = `../result/${data[0]._id}/image`
        data[0].subjects.forEach((subject, subjectIndex) => {
        document.querySelector('.result').innerHTML += `
            <tr class="hover:bg-slate-50/50">

                <td class="px-5 py-4 text-xs text-slate-400">
                    ${subjectIndex + 1}
                </td>

                <td class="px-5 py-4">
                    <p class="text-xs font-semibold text-slate-800">
                        ${subject.subjectName}
                    </p>
                </td>

                <td class="px-5 py-4 text-xs text-slate-600">
                    ${subject.firstTest}
                </td>

                <td class="px-5 py-4 text-xs text-slate-600">
                    ${subject.secondTest}
                </td>

                <td class="px-5 py-4 text-xs font-bold text-slate-800">
                    ${subject.cca}
                </td>

                <td class="px-5 py-4 text-xs font-bold text-slate-800">
                    ${subject.exam}
                </td>

                <td class="px-5 py-4 text-xs font-bold text-slate-800">
                    ${subject.total}
                </td>

                <td class="px-5 py-4">

                    <span class="rounded-md bg-blue-50 px-2 py-1 text-[10px] font-bold text-blue-600">
                        ${subject.grade}
                    </span>

                </td>

                <td class="px-5 py-4 text-xs text-slate-500">
                    ${subject.remark}
                </td>

            </tr>
        `;

    });


        renderResults(data)
    }
    function renderResults(data) {
        const container = document.querySelector('.results-list');
    
        let html = '';

        data.forEach(item => {
            const status = item.average >= 50 ? 'pass' : 'fail';

            html += `
                <div class="result-card">
                    
                    <div class="result-top">
                        <div>
                            <p class="term">${item.term}</p>
                            <p class="session">${item.studentClass}</p>
                            <p class="session">${item.section}</p>
                        </div>

                        <div class="result-stats">
                            <p class="avg">${item.average}</p>
                            <span class="status ${status}">
                                ${status.toUpperCase()}
                            </span>
                        </div>
                    </div>

                <div class="result-actions">
                        <button 
                            class="view-btn"
                            onclick="viewResult('${item.studentId}', '${item.term}', '${item.studentClass}', '${item.schoolName}')"
                        >
                            View  Result →
                        </button>
                          <a 
                            class="del-btn"
                            href='../result/${data[0]._id}/image'
                            >
                            download
                        </a>
                    
                    </div>

                </div>
            `;
        });

        container.innerHTML = html;
    }
function viewResult(studentId, term, sclass, school) {
    window.location.href = `/view-student-result?studentId=${studentId}&term=${term}&sclass=${sclass}&school=${school}`;
}

    </script>

