
<!DOCTYPE html>
<html lang="en">

<%- include('./partials/head') %>
<style>
    /* 🔘 BUTTON */
.result-actions{
    display: flex;
    gap: 10px;
}
    /* 📄 RESULTS SECTION */
.results-section {
    margin-top: 30px;
}
.view-btn, .del-btn {
    width: 100%;
    border: none;
    padding: 10px;
    border-radius: 10px;
    color: #fff;
    cursor: pointer;
    transition: 0.3s;
    font-weight: 500;
    box-shadow: 0 4px 12px rgba(79,70,229,0.3);
}
.results-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 15px;
    margin-top: 15px;
}

/* 🧾 RESULT CARD */
.result-card {
    background: linear-gradient(135deg, #ffffff, #f9fafb);
    border: 1px solid #e5e7eb;
    padding: 18px;
    border-radius: 16px;
    transition: 0.3s;
    display: flex;
    flex-direction: column;
    gap: 15px;
    box-shadow: 0 6px 18px rgba(0,0,0,0.06);
    position: relative;
    overflow: hidden;
}

.result-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, #4f46e5, #0ea5e9);
}

.result-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.12);
}

/* 📊 RESULT CONTENT */
.result-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.view-btn {
     background: linear-gradient(135deg, #4f46e5, #0ea5e9);
}
.del-btn {
    background: linear-gradient(135deg, #ef4444, #dc2626);
}
.view-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(79,70,229,0.4);
}

.del-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(239,68,68,0.4);
}

</style>
<body class="bg-slate-50 text-slate-800">

    <div class="min-h-screen">

        <!-- ==========================================
             NAVIGATION
        =========================================== -->

        <%- include('./partials/navigation') %>


        <!-- ==========================================
             MAIN
        =========================================== -->

        <main class="lg:ml-64">

          

            <!-- ==========================================
                 CONTENT
            =========================================== -->

            <section class="mx-auto max-w-[1300px] p-4 sm:p-6 lg:p-8">

            <!-- HEADER -->

            <%- include('./partials/header') %>

                <!-- ==========================================
                     PAGE HEADER
                =========================================== -->

                <div class="mb-6">

                    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">

                        <div>

                            <h1 class="text-xl font-bold text-slate-900 sm:text-2xl">
                                Academic Results
                            </h1>

                            <p class="mt-1 text-sm text-slate-500">
                                View your academic performance and examination results.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- ==========================================
                     RESULT SUMMARY
                =========================================== -->

                <div class="mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-[#0b2a4a] to-[#17619a] p-6 text-white shadow-sm sm:p-8">

                    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-center">


                        <!-- Student -->

                        <div>

                            <p class="term mb-2 text-xs text-blue-100">
                               
                            </p>

                            <h2 class="fullname text-xl font-bold sm:text-2xl">
                         
                            </h2>

                            <p class="studentClass mt-2 text-xs text-blue-100">
                              
                            </p>

                        </div>


                        <!-- Average -->

                        <div class="rounded-xl bg-white/10 px-6 py-4 text-center backdrop-blur-sm">

                            <p class="text-[9px] font-medium uppercase tracking-wider text-blue-200">
                                Overall Average
                            </p>

                            <p class="average mt-1 text-3xl font-bold">
                            %
                            </p>

                            <p class="remark mt-1 text-[10px] text-blue-200">
                                
                            </p>

                        </div>

                    </div>

                </div>


                <!-- ==========================================
                     RESULTS TABLE
                =========================================== -->

                <div class="rounded-xl border border-slate-200 bg-white shadow-sm">


                    <!-- Header -->

                    <div class="flex flex-col justify-between gap-3 border-b border-slate-100 px-5 py-4 sm:flex-row sm:items-center sm:px-6">

                        <div>

                            <h2 class="text-sm font-bold text-slate-900">
                                Subject Results
                            </h2>

                            <p class="term mt-1 text-[10px] text-slate-400">
                                
                            </p>

                        </div>


                        <a
                            id="download"
                            href=""
                            class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-[10px] font-semibold text-slate-600 hover:bg-slate-50"
                        >
                        
                        ✅ download
                        </a>

                    </div>


                    <!-- Table -->

                    <div class="overflow-x-auto">

                        <table class="w-full min-w-[800px]">


                            <thead>

                                <tr class="border-b border-slate-100 bg-slate-50/50">

                                    <th class="px-5 py-3 text-left text-[10px] font-semibold uppercase tracking-wide text-slate-400">
                                        #
                                    </th>

                                    <th class="px-5 py-3 text-left text-[10px] font-semibold uppercase tracking-wide text-slate-400">
                                        Subject
                                    </th>

                                    <th class="px-5 py-3 text-left text-[10px] font-semibold uppercase tracking-wide text-slate-400">
                                       First Test
                                    </th>
                                    <th class="px-5 py-3 text-left text-[10px] font-semibold uppercase tracking-wide text-slate-400">
                                       Second Test
                                    </th>
                                    <th class="px-5 py-3 text-left text-[10px] font-semibold uppercase tracking-wide text-slate-400">
                                        CA
                                    </th>
                                    <th class="px-5 py-3 text-left text-[10px] font-semibold uppercase tracking-wide text-slate-400">
                                        Exam
                                    </th>

                                    

                                    <th class="px-5 py-3 text-left text-[10px] font-semibold uppercase tracking-wide text-slate-400">
                                        Total
                                    </th>

                                    <th class="px-5 py-3 text-left text-[10px] font-semibold uppercase tracking-wide text-slate-400">
                                        Grade
                                    </th>

                                    <th class="px-5 py-3 text-left text-[10px] font-semibold uppercase tracking-wide text-slate-400">
                                        Remark
                                    </th>

                                </tr>

                            </thead>


                            <tbody class="result divide-y divide-slate-100">

                               

                            </tbody>


                            <!-- Total -->

                            <tfoot>

                                <tr class="border-t-2 border-slate-100 bg-slate-50/50">

                                    <td
                                        colspan="4"
                                        class="px-5 py-4 text-xs font-bold text-slate-700"
                                    >
                                        Overall Average
                                    </td>

                                    <td class="average px-5 py-4 text-sm font-bold text-slate-900">
                                       
                                    </td>

                                    <td class="px-5 py-4">

                                        <span class="grade rounded-md bg-blue-50 px-2 py-1 text-[10px] font-bold text-blue-600">
                                        
                                        </span>

                                    </td>

                                    <td class="remark px-5 py-4 text-xs font-semibold text-slate-600">
                                       
                                    </td>

                                </tr>

                            </tfoot>

                        </table>

                    </div>

                </div>

                 <div class="results-section">
                    <h3>📄 Student Results</h3>

                    <div class="results-list"></div>
                </div>
                <!-- ==========================================
                     TEACHER'S REMARK
                =========================================== -->

                <div class="mt-6 grid gap-6 lg:grid-cols-2">


                    <!-- Class Teacher -->

                    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">

                        <div class="flex items-start gap-4">

                            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-sm">
                                💬
                            </div>

                            <div>

                                <p class="text-[10px] font-medium uppercase tracking-wide text-slate-400">
                                    Class Teacher's Remark
                                </p>

                                <p class="mt-2 text-xs leading-6 text-slate-600">
                                    <span class="fullname"></span> has demonstrated very good academic
                                    performance this term. He should continue to
                                    work hard and pay more attention to areas that
                                    require improvement.
                                </p>

                                <p class="mt-3 text-[10px] font-medium text-slate-400">
                                    Class Teacher
                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- Principal -->

                    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">

                        <div class="flex items-start gap-4">

                            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-purple-50 text-sm">
                                🎓
                            </div>

                            <div>

                                <p class="text-[10px] font-medium uppercase tracking-wide text-slate-400">
                                    Principal's Remark
                                </p>

                                <p class="mt-2 text-xs leading-6 text-slate-600">
                                    A very good performance. Keep up the good work
                                    and continue striving for academic excellence.
                                </p>

                                <p class="mt-3 text-[10px] font-medium text-slate-400">
                                    Principal
                                </p>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- ==========================================
                     RESULT NOTICE
                =========================================== -->

                <div class="mt-6 flex items-start gap-3 rounded-xl border border-blue-100 bg-blue-50 p-4">

                    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white text-sm">
                        ℹ️
                    </div>

                    <div>

                        <p class="text-xs font-semibold text-blue-900">
                            Result Information
                        </p>

                        <p class="mt-1 text-[10px] leading-5 text-blue-700">
                            This result is subject to confirmation by the school
                            administration. Contact your school if you notice any
                            error or have questions about your result.
                        </p>

                    </div>

                </div>


            </section>

        </main>

    </div>


    <!-- ==========================================
         MOBILE MENU SCRIPT
    =========================================== -->

    <script>
       
    window.onload= async function getStudentResult(){
        const savedStudent = localStorage.getItem('student')
        if(!savedStudent){
            console.log('no student')
            return
        }
        const student = JSON.parse(savedStudent)
        updateDom(student)
        const response = await fetch(`/api/get_result?studentId=${student.studentId}`);
        const data = await response.json();
        document.querySelector('.term').innerText = `${data[0].term } ${data[0].section }`
        document.getElementById('download').href = `../result/${data[0]._id}/image`
       resultPerfomance(data[0])
       //DISPLAY RESULT INPAGE
        data[0].subjects.forEach((subject, subjectIndex) => {
            document.querySelector('.result').innerHTML += `
            <tr class="hover:bg-slate-50/50">

                <td class="px-5 py-4 text-xs text-slate-400">
                    ${subjectIndex + 1}
                </td>

                <td class="px-5 py-4">
                    <p class="text-xs font-semibold text-slate-800">
                        ${subject.subjectName}
                    </p>
                </td>

                <td class="px-5 py-4 text-xs text-slate-600">
                    ${subject.firstTest}
                </td>

                <td class="px-5 py-4 text-xs text-slate-600">
                    ${subject.secondTest}
                </td>

                <td class="px-5 py-4 text-xs font-bold text-slate-800">
                    ${subject.cca}
                </td>

                <td class="px-5 py-4 text-xs font-bold text-slate-800">
                    ${subject.exam}
                </td>

                <td class="px-5 py-4 text-xs font-bold text-slate-800">
                    ${subject.total}
                </td>

                <td class="px-5 py-4">

                    <span class="rounded-md bg-blue-50 px-2 py-1 text-[10px] font-bold text-blue-600">
                        ${subject.grade}
                    </span>

                </td>

                <td class="px-5 py-4 text-xs text-slate-500">
                    ${subject.remark}
                </td>

            </tr>
        `;

        });
        renderResults(data)
    }
    function renderResults(data) {
        const container = document.querySelector('.results-list');
    
        let html = '';

        data.forEach(item => {
            const status = item.average >= 50 ? 'pass' : 'fail';

            html += `
                <div class="result-card">
                    
                    <div class="result-top">
                        <div>
                            <p class="term">${item.term}</p>
                            <p class="session">${item.studentClass}</p>
                            <p class="session">${item.section}</p>
                        </div>

                        <div class="result-stats">
                            <p class="avg">${item.average}</p>
                            <span class="status ${status}">
                                ${status.toUpperCase()}
                            </span>
                        </div>
                    </div>

                <div class="result-actions">
                        <button 
                            class="view-btn"
                            onclick="viewResult('${item.studentId}', '${item.term}', '${item.studentClass}', '${item.schoolName}')"
                        >
                            View  Result →
                        </button>
                          <a 
                            class="del-btn"
                            href='../result/${data[0]._id}/image'
                            >
                            download
                        </a>
                    
                    </div>

                </div>
            `;
        });

        container.innerHTML = html;
    }
    function viewResult(studentId, term, sclass, school) {
        window.location.href = `/view-student-result?studentId=${studentId}&term=${term}&sclass=${sclass}&school=${school}`;
    }
    function updateDom(student){
         document.querySelectorAll('.fullname').forEach(item=>{
            item.innerText = student.fullname
        })
       // document.querySelector('.studentId').innerHTML = student.studentId
        document.querySelector('.house').innerText = ` ${student.house || ''}`
        document.querySelectorAll('.term').forEach(item=>{
            item.innerText = `${student.schoolsession} • ${student.class} Result|| ''}`
        })
        document.querySelector('.studentClass').innerText =   `${student.class} ${student.house || ''} • Student ID: ${student.studentId}` 
        }
    //set grade, average and remark
    function resultPerfomance(result){
            document.querySelectorAll('.average').forEach(item=>{
                item.innerText = `${result.average}%`
            })
        if(result.average >= 80) { 
            document.querySelectorAll('.grade').forEach(item=>{
                item.innerText = 'A'
            })
            document.querySelectorAll('.remark').forEach(item=>{
                item.innerText = "EXCELLENT"
            })
        } else if (result.average >= 70) { 
            document.querySelectorAll('.grade').forEach(item=>{
                item.innerText = 'B'
            })
            document.querySelectorAll('.remark').forEach(item=>{
                item.innerText = "VERY GOOD"
            })
        } else if (result.average >= 60) { 
            document.querySelectorAll('.grade').forEach(item=>{
                item.innerText = 'C'
            })
            document.querySelectorAll('.remark').forEach(item=>{
                item.innerText = "GOOD"
            })
        } else if (result.average >= 50) { 
            document.querySelectorAll('.grade').forEach(item=>{
                item.innerText = 'D'
            })
            document.querySelectorAll('.remark').forEach(item=>{
                item.innerText = "FAIR"
            })
        } else if (result.average >= 40) { 
            document.querySelectorAll('.grade').forEach(item=>{
                item.innerText = 'E'
            })
            document.querySelectorAll('.remark').forEach(item=>{
                item.innerText = "PASS"
            })
        } else { 
            document.querySelector('.grade').forEach(item=>{
                item.innerText = 'F'
            })
            document.querySelector('.remark').forEach(item=>{
                item.innerText = "FAILED"
            })
        } 

    } 
    </script>

</body>

</html>

