        <script>

            document.addEventListener('DOMContentLoaded', () => {

                const savedStudent = localStorage.getItem('student');

                if (!savedStudent) {
                    console.log('No student found in localStorage');
                    return;
                }

                let student;

                try {
                    student = JSON.parse(savedStudent);
                } catch (error) {
                    console.error('Invalid student data:', error);
                    return;
                }


                // ==========================================
                // STUDENT BASIC INFORMATION
                // ==========================================

                const studentFullname =
                    document.getElementById('studentFullname');

                if (studentFullname) {
                    studentFullname.value = student.fullname || '';
                }


                const studentDob =
                    document.getElementById('studentDob');

                if (studentDob) {
                    studentDob.value = student.dob || '';
                }


                const studentGender =
                    document.getElementById('studentGender');

                if (studentGender) {
                    studentGender.value = student.gender || '';
                }


                const studentEmail =
                    document.getElementById('studentEmail');

                if (studentEmail) {
                    studentEmail.value = student.email || '';
                }


                const studentAddress =
                    document.getElementById('studentAddress');

                if (studentAddress) {
                    studentAddress.value = student.address || '';
                }


                const studentHouse =
                    document.getElementById('studentHouse');

                if (studentHouse) {
                    studentHouse.value = student.house || '';
                }


                // ==========================================
                // STUDENT PASSPORT
                // ==========================================

                const studentPassport =
                    document.getElementById('studentPassport');

                const studentPassportPreview =
                    document.getElementById('studentPassportPreview');


                // Load existing passport

                if (studentPassportPreview) {

                    if (student.passport) {

                        studentPassportPreview.src = student.passport;

                    } else {

                        studentPassportPreview.src =
                            '/IMAGE/default-student.png';

                    }

                }


                // Preview newly selected passport

                if (studentPassport) {

                    studentPassport.addEventListener('change', function () {

                        const file = this.files[0];

                        if (!file) {
                            return;
                        }


                        // Make sure it is an image

                        if (!file.type.startsWith('image/')) {

                            showMassagePopup('Please select an image file.');

                            this.value = '';

                            return;
                        }


                        // Preview image

                        const imageURL =
                            URL.createObjectURL(file);

                        studentPassportPreview.src = imageURL;

                    });

                }


                // ==========================================
                // GUARDIAN INFORMATION
                // KEEP YOUR EXISTING GUARDIAN LOGIC
                // ==========================================

                const guardianName =
                    document.getElementById('guardianName');

                if (guardianName) {
                    guardianName.value =
                        student.guardian?.name || '';
                }


                const relationship =
                    document.getElementById('relationship');

                if (relationship) {
                    relationship.value =
                        student.guardian?.relationship || '';
                }


                const guardianPhone =
                    document.getElementById('guardianPhone');

                if (guardianPhone) {
                    guardianPhone.value =
                        student.guardian?.phone || '';
                }


                const guardianEmail =
                    document.getElementById('guardianEmail');

                if (guardianEmail) {
                    guardianEmail.value =
                        student.guardian?.email || '';
                }


                const guardianAddress =
                    document.getElementById('guardianAddress');

                if (guardianAddress) {
                    guardianAddress.value =
                        student.guardian?.address || '';
                }


                const guardianState =
                    document.getElementById('guardianState');

                if (guardianState) {
                    guardianState.value =
                        student.guardian?.state || '';
                }


                const guardianLga =
                    document.getElementById('guardianLga');

                if (guardianLga) {
                    guardianLga.value =
                        student.guardian?.lga || '';
                }


                // ==========================================
                // EMERGENCY CONTACT
                // ==========================================

                const emergencyName =
                    document.getElementById('emergencyName');

                if (emergencyName) {
                    emergencyName.value =
                        student.emergencyContact?.name || '';
                }


                const emergencyPhone =
                    document.getElementById('emergencyPhone');

                if (emergencyPhone) {
                    emergencyPhone.value =
                        student.emergencyContact?.phone || '';
                }
            });

            async function saveChange(e){
                e.preventDefault();
                 const savedStudent = localStorage.getItem('student');

                if (!savedStudent) {
                    console.log('No student found in localStorage');
                    return;
                }

                let student = JSON.parse(savedStudent);
                const form = document.getElementById('form');
                document.getElementById('saveButton').disabled = true; // Disable the button to prevent multiple submissions
                document.getElementById('saveButton').innerText = 'Saving...'; // Change button text to indicate saving
                const formData = new FormData(form);

                try {
                    const response = await fetch(`/student/profile-update/${student._id}`, {
                        method: 'PATCH',
                        body: formData
                    });

                    if (response.ok) {
                        const result = await response.json();
                        showMessagePopup(result.message || 'Profile updated successfully!');
                        localStorage.setItem('student', JSON.stringify(result.student));
                    } else {
                        const errorResult = await response.json();
                        showMessagePopup(errorResult.message || 'Failed to update profile.');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    showMessagePopup('An error occurred while updating the profile.');
                }finally {
                    // Optionally, you can reset the form or perform other actions here
                    document.getElementById('saveButton').disabled = false; // Re-enable the button
                    document.getElementById('saveButton').innerText = 'Save Changes'; // Reset
                }
            }
        </script>




    </body>

</html>