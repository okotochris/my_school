                        <h2 class="text-2xl font-bold sm:text-3xl">
                            Christian Okotoaza
                        </h2>

                        <p class="mt-2 max-w-lg text-sm leading-6 text-blue-100">
                            Here's what's happening with your academic
                            activities this term.
                        </p>

                    </div>


                    <div class="rounded-xl bg-white/10 p-4 sm:min-w-[180px]">

                        <p class="text-[10px] font-medium uppercase tracking-wider text-blue-200">
                            Current Term
                        </p>

                        <p class="mt-1 text-sm font-semibold">
                            2nd Term • 2025/2026
                        </p>

                    </div>

                </div>

            </div>


            <!-- ==========================================
                 STATISTICS
            =========================================== -->

            <div class="mb-6 grid grid-cols-2 gap-3 sm:grid-cols-2 sm:gap-4 xl:grid-cols-4">


                <!-- Average -->

                <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">

                    <div class="mb-4 flex items-center justify-between">

                        <p class="text-xs font-medium text-slate-500">
                            Overall Average
