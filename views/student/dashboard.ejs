            <!-- ==========================================
                 MAIN GRID
            =========================================== -->

            <div class="grid gap-6 xl:grid-cols-[1.5fr_1fr]">


               

                <div class="chart-container">
                    <h3>📈 Performance</h3>
                    <canvas id="performanceChart"></canvas>
                </div>


                <!-- ======================================
                     ANNOUNCEMENTS
                ======================================= -->

                <div class="rounded-xl border border-slate-200 bg-white shadow-sm">

                    <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">

                        <h3 class="text-sm font-bold text-slate-900">
                            Announcements
                        </h3>

                        <a
                            href="/student/announcements"
                            class="text-xs font-medium text-blue-600"
                        >
                            View all →
                        </a>

                    </div>


                    <div class="divide-y divide-slate-100 px-5">


                        <div class="py-4">

                            <h4 class="text-xs font-semibold text-slate-800">
                                Second Term Examination
                            </h4>

                            <p class="mt-1 text-xs leading-5 text-slate-500">
                                The second term examination timetable
                                has been released.
                            </p>

                            <p class="mt-2 text-[10px] text-slate-400">
                                August 2, 2026
                            </p>

                        </div>


                        <div class="py-4">

                            <h4 class="text-xs font-semibold text-slate-800">
                                School Assembly
                            </h4>

                            <p class="mt-1 text-xs leading-5 text-slate-500">
                                All students are expected to attend
                                Monday morning assembly.
                            </p>

                            <p class="mt-2 text-[10px] text-slate-400">
                                July 30, 2026
                            </p>

                        </div>


                        <div class="py-4">

                            <h4 class="text-xs font-semibold text-slate-800">
                                Sports Activities
                            </h4>

                            <p class="mt-1 text-xs leading-5 text-slate-500">
                                Inter-house sports practice begins
                                next week.
                            </p>

                            <p class="mt-2 text-[10px] text-slate-400">
                                July 28, 2026
                            </p>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ==========================================
                 STUDENT INFORMATION
            =========================================== -->

            <div class="mt-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">

                <div class="mb-6 flex items-center justify-between">

                    <h3 class="text-sm font-bold text-slate-900">
                        Student Information
                    </h3>

                    <a
                        href="/student/profile"
                        class="text-xs font-medium text-blue-600 hover:text-blue-700"
                    >
                        View Profile →
                    </a>

                </div>


                <!-- Student -->

                <div class="flex items-center gap-4">

                    <img
                       
                        class=" h-16 w-16 rounded-xl object-cover"
                        id="profileImage"
                    >

                    <div>

                        <h3 class="fullname text-sm font-bold text-slate-900">
                           
                        </h3>

                        <p class=" mt-1 text-xs text-slate-500">
                            Student ID: <span class="studentId"></span>
                        </p>

                    </div>

                </div>


                <!-- Details -->

                <div class="mt-6 grid grid-cols-2 gap-5 sm:grid-cols-4">

                    <div>

                        <p class="text-[10px] font-medium uppercase text-slate-400">
                            Class
                        </p>

                        <p class="term mt-1 text-xs font-semibold text-slate-700">
                          
                        </p>

                    </div>


                    <div>

                        <p class="text-[10px] font-medium uppercase text-slate-400">
                            Session
                        </p>

                        <p class="schoolSection mt-1 text-xs font-semibold text-slate-700">
                          
                        </p>

                    </div>


                    <div>

                        <p class="text-[10px] font-medium uppercase text-slate-400">
                            Current Term
                        </p>

                        <p class="term mt-1 text-xs font-semibold text-slate-700">
                        </p>

                    </div>


                    <div>

                        <p class="text-[10px] font-medium uppercase text-slate-400">
                            House
                        </p>

                        <p class="house mt-1 text-xs font-semibold text-slate-700">
                        </p>

                    </div>

                </div>

            </div>

        </section>

    </main>

</div>

<script>

    const savedStudent = localStorage.getItem('student')
    if(!savedStudent){
        window.location.href = '/student/student-login'
    }
    const student = JSON.parse(savedStudent)
   
    document.querySelectorAll('.fullname').forEach(item=>{
        item.innerText = student.fullname
    })
    document.querySelector('#profileImage').src = student.passport
    document.querySelector('.studentId').innerHTML = student.studentId
    document.querySelector('.house').innerText = ` ${student.house || ''}`
    document.querySelectorAll('.term').forEach(item=>{
        item.innerText = `${student.class} • ${student.session || ''}`
    })
    document.querySelector('.schoolSection').innerText = student.session || ''
   


   let resultDetails = null;
window.onload = async function resultAnalysisA() {
    const savedStudent = localStorage.getItem('student')
    if(!savedStudent){
        return
    }
    const student = JSON.parse(savedStudent)
    const response = await fetch(`/api/get_result?studentId=${student.studentId}`);
    const data = await response.json();
    const labels = [];
    const scores = [];

    data.forEach(res => {
        labels.push(res.term);
        scores.push(res.average);
    });

    const ctx = document.getElementById('performanceChart').getContext('2d');

    new Chart(ctx, {
        type: 'line',
        data: {
            labels,
            datasets: [{
                label: 'Average Score',
                data: scores,
                borderColor: '#0ea5e9',
                backgroundColor: 'rgba(14, 165, 233, 0.1)',
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { labels: { color: "#1f2937" } }
            },
            scales: {
                x: { ticks: { color: "#6b7280" } },
                y: { ticks: { color: "#6b7280" }, beginAtZero: true }
            }
        }
    });

    renderResults(data);
}

</script>

</body>
</html>

