                    </p>

                </div>


                <!-- Position -->

                <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">

                    <div class="mb-4 flex items-center justify-between">

                        <p class="text-xs font-medium text-slate-500">
                            Class Position
                        </p>

                        <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-50 text-sm font-bold text-emerald-600">
                            #
                        </div>

                    </div>

                    <p class="text-2xl font-bold text-slate-900">
                        5th
                    </p>

                    <p class="mt-1 text-[11px] text-slate-400">
                        Out of 42 students
                    </p>

                </div>


                <!-- Subjects -->

                <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">

                    <div class="mb-4 flex items-center justify-between">

                        <p class="text-xs font-medium text-slate-500">
                            Subjects
                        </p>

                        <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-purple-50 text-sm">
                            📚
                        </div>

                    </div>

                    <p class="text-2xl font-bold text-slate-900">
                        12
                    </p>

                    <p class="mt-1 text-[11px] text-slate-400">
                        Registered subjects
                    </p>

                </div>


                <!-- Assignments -->

                <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">

                    <div class="mb-4 flex items-center justify-between">

                        <p class="text-xs font-medium text-slate-500">
                            Assignments
                        </p>

                        <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-orange-50 text-sm">
                            📝
