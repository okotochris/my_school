                                    <th class="px-5 py-3 text-left text-[11px] font-medium text-slate-500">
                                        Remark
                                    </th>

                                </tr>

                            </thead>


                            <tbody>


                                <tr class="border-b border-slate-50">

                                    <td class="px-5 py-3 text-xs font-medium text-slate-700">
                                        Mathematics
                                    </td>

                                    <td class="px-5 py-3 text-xs text-slate-600">
                                        82
                                    </td>

                                    <td class="px-5 py-3">

                                        <span class="rounded-md bg-emerald-50 px-2 py-1 text-[10px] font-semibold text-emerald-600">
                                            A
                                        </span>

                                    </td>

                                    <td class="px-5 py-3 text-xs text-slate-500">
                                        Excellent
                                    </td>

                                </tr>


                                <tr class="border-b border-slate-50">

                                    <td class="px-5 py-3 text-xs font-medium text-slate-700">
                                        English Language
                                    </td>

                                    <td class="px-5 py-3 text-xs text-slate-600">
                                        76
                                    </td>

                                    <td class="px-5 py-3">

                                        <span class="rounded-md bg-blue-50 px-2 py-1 text-[10px] font-semibold text-blue-600">
                                            B
                                        </span>

                                    </td>

                                    <td class="px-5 py-3 text-xs text-slate-500">
                                        Very Good
                                    </td>

                                </tr>


                                <tr class="border-b border-slate-50">

                                    <td class="px-5 py-3 text-xs font-medium text-slate-700">
                                        Biology
                                    </td>

                                    <td class="px-5 py-3 text-xs text-slate-600">
                                        81
                                    </td>

                                    <td class="px-5 py-3">

                                        <span class="rounded-md bg-emerald-50 px-2 py-1 text-[10px] font-semibold text-emerald-600">
                                            A
                                        </span>

                                    </td>

                                    <td class="px-5 py-3 text-xs text-slate-500">
                                        Excellent
                                    </td>

                                </tr>


                                <tr class="border-b border-slate-50">

                                    <td class="px-5 py-3 text-xs font-medium text-slate-700">
                                        Physics
                                    </td>

                                    <td class="px-5 py-3 text-xs text-slate-600">
                                        73
                                    </td>

                                    <td class="px-5 py-3">

                                        <span class="rounded-md bg-blue-50 px-2 py-1 text-[10px] font-semibold text-blue-600">
                                            B
                                        </span>

                                    </td>

                                    <td class="px-5 py-3 text-xs text-slate-500">
                                        Very Good
                                    </td>

                                </tr>


                                <tr>

                                    <td class="px-5 py-3 text-xs font-medium text-slate-700">
                                        Chemistry
                                    </td>

                                    <td class="px-5 py-3 text-xs text-slate-600">
                                        79
                                    </td>

                                    <td class="px-5 py-3">

                                        <span class="rounded-md bg-blue-50 px-2 py-1 text-[10px] font-semibold text-blue-600">
                                            B
                                        </span>

                                    </td>

                                    <td class="px-5 py-3 text-xs text-slate-500">
                                        Very Good
                                    </td>

                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>


                <!-- ======================================
                     ANNOUNCEMENTS
                ======================================= -->

                <div class="rounded-xl border border-slate-200 bg-white shadow-sm">

                    <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">

                        <h3 class="text-sm font-bold text-slate-900">
                            Announcements
                        </h3>

                        <a
                            href="/student/announcements"
                            class="text-xs font-medium text-blue-600"
                        >
                            View all →
                        </a>

                    </div>


                    <div class="divide-y divide-slate-100 px-5">


                        <div class="py-4">

                            <h4 class="text-xs font-semibold text-slate-800">
                                Second Term Examination
                            </h4>

                            <p class="mt-1 text-xs leading-5 text-slate-500">
                                The second term examination timetable
                                has been released.
                            </p>

                            <p class="mt-2 text-[10px] text-slate-400">
                                August 2, 2026
                            </p>

                        </div>


                        <div class="py-4">

                            <h4 class="text-xs font-semibold text-slate-800">
                                School Assembly
                            </h4>

                            <p class="mt-1 text-xs leading-5 text-slate-500">
                                All students are expected to attend
                                Monday morning assembly.
                            </p>

                            <p class="mt-2 text-[10px] text-slate-400">
                                July 30, 2026
                            </p>

                        </div>


                        <div class="py-4">

                            <h4 class="text-xs font-semibold text-slate-800">
                                Sports Activities
                            </h4>

                            <p class="mt-1 text-xs leading-5 text-slate-500">
                                Inter-house sports practice begins
                                next week.
                            </p>

                            <p class="mt-2 text-[10px] text-slate-400">
                                July 28, 2026
                            </p>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ==========================================
                 STUDENT INFORMATION
            =========================================== -->

            <div class="mt-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">

                <div class="mb-6 flex items-center justify-between">

                    <h3 class="text-sm font-bold text-slate-900">
                        Student Information
                    </h3>

                    <a
                        href="/student/profile"
                        class="text-xs font-medium text-blue-600 hover:text-blue-700"
