
<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head') %>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<body class="bg-slate-50 text-slate-800">

<div class="min-h-screen">

    <!-- ==========================================
        NAVIGATION
    =========================================== -->
    <%- include('./partials/navigation') %>


    <!-- ==========================================
         MAIN
    =========================================== -->

    <main class="lg:ml-64">


        <!-- ==========================================
             TOP BAR
        =========================================== -->

   


        <!-- ==========================================
             CONTENT
        =========================================== -->

        <section class="mx-auto max-w-[1300px] p-4 sm:p-6 lg:p-8">
             <%- include('./partials/header') %>

            <!-- ==========================================
                 WELCOME CARD
            =========================================== -->

            <div
                class="mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-[#0b2a4a] to-[#17619a] p-6 text-white shadow-sm sm:p-8"
            >

                <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-center">

                    <div>

                        <p class="mb-2 text-sm text-blue-100">
