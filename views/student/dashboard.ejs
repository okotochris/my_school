                        </p>

                    </div>


                    <div>

                        <p class="text-[10px] font-medium uppercase text-slate-400">
                            Current Term
                        </p>

                        <p class="mt-1 text-xs font-semibold text-slate-700">
                            Second Term
                        </p>

                    </div>


                    <div>

                        <p class="text-[10px] font-medium uppercase text-slate-400">
                            House
                        </p>

                        <p class="mt-1 text-xs font-semibold text-slate-700">
                            Blue House
                        </p>

                    </div>

                </div>

