                    </div>

                    <p class="text-2xl font-bold text-slate-900">
                        5th
                    </p>

                    <p class="mt-1 text-[11px] text-slate-400">
                        Out of 42 students
                    </p>

                </div>


                <!-- Subjects -->

                <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">

                    <div class="mb-4 flex items-center justify-between">

                        <p class="text-xs font-medium text-slate-500">
                            Subjects
                        </p>

                        <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-purple-50 text-sm">
                            📚
                        </div>

                    </div>

                    <p class="text-2xl font-bold text-slate-900">
                        12
                    </p>

                    <p class="mt-1 text-[11px] text-slate-400">
                        Registered subjects
                    </p>

                </div>


                <!-- Assignments -->

                <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">

                    <div class="mb-4 flex items-center justify-between">

                        <p class="text-xs font-medium text-slate-500">
                            Assignments
                        </p>

                        <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-orange-50 text-sm">
                            📝
                        </div>

                    </div>

                    <p class="text-2xl font-bold text-slate-900">
                        3
                    </p>

                    <p class="mt-1 text-[11px] text-slate-400">
                        Pending assignments
                    </p>

                </div>

            </div>


            <!-- ==========================================
                 MAIN GRID
            =========================================== -->

            <div class="grid gap-6 xl:grid-cols-[1.5fr_1fr]">


                <!-- ======================================
                     RECENT RESULTS
                ======================================= -->

                <div class="rounded-xl border border-slate-200 bg-white shadow-sm">

                    <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">

                        <h3 class="text-sm font-bold text-slate-900">
                            Recent Results
                        </h3>

                        <a
                            href="/student/results"
                            class="text-xs font-medium text-blue-600 hover:text-blue-700"
                        >
                            View all →
                        </a>

                    </div>


                    <div class="overflow-x-auto">

                        <table class="w-full min-w-[550px]">

                            <thead>

                                <tr class="border-b border-slate-100">

                                    <th class="px-5 py-3 text-left text-[11px] font-medium text-slate-500">
                                        Subject
                                    </th>

                                    <th class="px-5 py-3 text-left text-[11px] font-medium text-slate-500">
