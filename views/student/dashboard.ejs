<script>

    const savedStudent = localStorage.getItem('student')
    if(!savedStudent){
        window.location.href = '/student/student-login'
    }
    const student = JSON.parse(savedStudent)
   
    document.querySelectorAll('.fullname').forEach(item=>{
        item.innerText = student.fullname
    })
    document.querySelector('#profileImage').src = student.passport
    document.querySelector('.studentId').innerHTML = student.studentId
    document.querySelector('.house').innerText = ` ${student.house || ''}`
    document.querySelectorAll('.term').forEach(item=>{
        item.innerText = `${student.class} • ${student.session || ''}`
    })
    document.querySelector('.schoolSection').innerText = student.session || ''
   


   let resultDetails = null;
window.onload = async function resultAnalysisA() {
    const savedStudent = localStorage.getItem('student')
    if(!savedStudent){
        return
    }
    const student = JSON.parse(savedStudent)
    const response = await fetch(`/api/get_result?studentId=${student.studentId}`);
    const data = await response.json();
    const labels = [];
    const scores = [];

    data.forEach(res => {
        labels.push(res.term);
        scores.push(res.average);
    });

    const ctx = document.getElementById('performanceChart').getContext('2d');

    new Chart(ctx, {
        type: 'line',
        data: {
            labels,
            datasets: [{
                label: 'Average Score',
                data: scores,
                borderColor: '#0ea5e9',
                backgroundColor: 'rgba(14, 165, 233, 0.1)',
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { labels: { color: "#1f2937" } }
            },
            scales: {
                x: { ticks: { color: "#6b7280" } },
                y: { ticks: { color: "#6b7280" }, beginAtZero: true }
            }
        }
    });

    renderResults(data);
}

</script>

