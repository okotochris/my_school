
<!DOCTYPE html>
<html lang="en">

<%- include('./partials/head') %>

<body class="bg-slate-50 text-slate-800">

    <div class="min-h-screen">

        <!-- ==========================================
             NAVIGATION
        =========================================== -->

        <%- include('./partials/navigation') %>


        <!-- ==========================================
             MAIN
        =========================================== -->

        <main class="lg:ml-64">

            <!-- HEADER -->

            <%- include('./partials/header') %>


            <!-- ==========================================
                 CONTENT
            =========================================== -->

            <section class="mx-auto max-w-[1500px] p-4 sm:p-6 lg:p-8">


                <!-- ==========================================
                     PAGE HEADER
                =========================================== -->

                <div class="mb-6">

                    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

                        <div>

                            <h1 class="text-xl font-bold text-slate-900 sm:text-2xl">
                                Announcements
                            </h1>

                            <p class="mt-1 text-sm text-slate-500">
                                Stay updated with the latest news and information from your school.
                            </p>

                        </div>


                        <!-- Notification -->

                        <div class="flex items-center gap-2 rounded-lg border border-blue-100 bg-blue-50 px-3 py-2">

                            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-blue-100 text-sm">
                                🔔
                            </span>

                            <div>

                                <p class="text-[10px] font-medium text-blue-600">
                                    New announcements
                                </p>

                                <p class="text-xs font-bold text-blue-900">
                                    3 unread
                                </p>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- ==========================================
                     SUMMARY CARDS
                =========================================== -->

                <div class="mb-6 grid grid-cols-2 gap-3 sm:grid-cols-4">


                    <!-- All -->

                    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">

                        <div class="flex items-center justify-between">

                            <p class="text-xs font-medium text-slate-500">
                                All
                            </p>

                            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 text-sm">
                                📢
                            </div>

                        </div>

                        <p class="mt-3 text-2xl font-bold text-slate-900">
                            12
                        </p>

                        <p class="mt-1 text-[10px] text-slate-400">
                            Total announcements
                        </p>

                    </div>


                    <!-- Unread -->

                    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">

                        <div class="flex items-center justify-between">

                            <p class="text-xs font-medium text-slate-500">
                                Unread
                            </p>

                            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-orange-50 text-sm">
                                🔔
                            </div>

                        </div>

                        <p class="mt-3 text-2xl font-bold text-slate-900">
                            3
                        </p>

                        <p class="mt-1 text-[10px] text-slate-400">
                            Need your attention
                        </p>

                    </div>


                    <!-- Academic -->

                    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">

                        <div class="flex items-center justify-between">

                            <p class="text-xs font-medium text-slate-500">
                                Academic
                            </p>

                            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-purple-50 text-sm">
                                📚
                            </div>

                        </div>

                        <p class="mt-3 text-2xl font-bold text-slate-900">
                            5
                        </p>

                        <p class="mt-1 text-[10px] text-slate-400">
                            Academic notices
                        </p>

                    </div>


                    <!-- Events -->

                    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">

                        <div class="flex items-center justify-between">

                            <p class="text-xs font-medium text-slate-500">
                                Events
                            </p>

                            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-50 text-sm">
                                📅
                            </div>

                        </div>

                        <p class="mt-3 text-2xl font-bold text-slate-900">
                            4
                        </p>

                        <p class="mt-1 text-[10px] text-slate-400">
                            School events
                        </p>

                    </div>

                </div>


                <!-- ==========================================
                     SEARCH & FILTER
                =========================================== -->

                <div class="mb-6 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">

                    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">


                        <!-- Search -->

                        <div class="relative w-full sm:max-w-md">

                            <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-sm text-slate-400">
                                🔍
                            </span>

                            <input
                                id="announcementSearch"
                                type="text"
                                placeholder="Search announcements..."
                                class="w-full rounded-lg border border-slate-200 bg-slate-50 py-2.5 pl-9 pr-3 text-xs text-slate-700 outline-none transition focus:border-blue-400 focus:bg-white focus:ring-2 focus:ring-blue-100"
                            >

                        </div>


                        <!-- Filter -->

                        <select
                            id="announcementFilter"
                            class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-xs font-medium text-slate-600 outline-none focus:border-blue-400 sm:w-auto"
                        >

                            <option value="all">
                                All Announcements
                            </option>

                            <option value="academic">
                                Academic
                            </option>

                            <option value="event">
                                Events
                            </option>

                            <option value="general">
                                General
                            </option>

                            <option value="important">
                                Important
                            </option>

                        </select>

                    </div>

                </div>


                <!-- ==========================================
                     ANNOUNCEMENTS
                =========================================== -->

                <div class="grid gap-6 xl:grid-cols-[1.5fr_1fr]">


                    <!-- ======================================
                         ANNOUNCEMENT LIST
                    ======================================= -->

                    <div class="rounded-xl border border-slate-200 bg-white shadow-sm">

                        <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4 sm:px-6">

                            <div>

                                <h2 class="text-sm font-bold text-slate-900">
                                    Recent Announcements
                                </h2>

                                <p class="mt-1 text-xs text-slate-500">
                                    Latest updates from your school.
                                </p>

                            </div>


                            <button
                                onclick="markAllRead()"
                                class="text-xs font-medium text-blue-600 hover:text-blue-700"
                            >
                                Mark all as read
                            </button>

                        </div>


                        <div id="announcementList">


                            <!-- ==================================
                                 ANNOUNCEMENT 1
                            =================================== -->

                            <article
                                class="announcement-item relative border-b border-slate-100 p-5 sm:p-6"
                                data-category="academic"
                                data-title="second term examination timetable"
                            >

                                <!-- Unread indicator -->

                                <span class="absolute right-5 top-6 h-2 w-2 rounded-full bg-blue-600"></span>


                                <div class="flex gap-4">

                                    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-lg">
                                        📚
                                    </div>


                                    <div class="min-w-0 flex-1">

                                        <div class="flex flex-wrap items-center gap-2 pr-5">

                                            <span class="rounded-full bg-blue-50 px-2 py-1 text-[9px] font-semibold text-blue-600">
                                                Academic
                                            </span>

                                            <span class="rounded-full bg-red-50 px-2 py-1 text-[9px] font-semibold text-red-600">
                                                Important
                                            </span>

                                        </div>


                                        <h3 class="mt-2 text-sm font-bold text-slate-900">
                                            Second Term Examination Timetable
                                        </h3>


                                        <p class="mt-2 text-xs leading-5 text-slate-500">
                                            The timetable for the second term examination
                                            has been released. Students are advised to
                                            check the timetable carefully and prepare
                                            adequately for all examinations.
                                        </p>


                                        <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2">

                                            <span class="text-[10px] text-slate-400">
                                                📅 August 2, 2026
                                            </span>

                                            <span class="text-[10px] text-slate-400">
                                                👨‍💼 School Administration
                                            </span>

                                        </div>


                                        <button
                                            onclick="viewAnnouncement(
                                                'Second Term Examination Timetable',
                                                'Academic',
                                                'The timetable for the second term examination has been released. Students are advised to check the timetable carefully and prepare adequately for all examinations.',
                                                'August 2, 2026',
                                                'School Administration'
                                            )"
                                            class="mt-4 text-xs font-semibold text-blue-600 hover:text-blue-700"
                                        >
                                            Read announcement →
                                        </button>

                                    </div>

                                </div>

                            </article>


                            <!-- ==================================
                                 ANNOUNCEMENT 2
                            =================================== -->

                            <article
                                class="announcement-item relative border-b border-slate-100 p-5 sm:p-6"
