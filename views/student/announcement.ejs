
<!DOCTYPE html>
<html lang="en">

<%- include('./partials/head') %>

<body class="bg-slate-50 text-slate-800">

    <div class="min-h-screen">

        <!-- ==========================================
             NAVIGATION
        =========================================== -->

        <%- include('./partials/navigation') %>


        <!-- ==========================================
             MAIN
        =========================================== -->

        <main class="lg:ml-64">

        <section class="mx-auto max-w-[1300px] p-4 sm:p-6 lg:p-8">

            <%- include('./partials/header') %>

            <!-- PAGE HEADER -->
            <div class="mb-6">

                <h1 class="text-xl font-bold text-[#0b2a4a] sm:text-2xl">
                    Announcements
                </h1>

                <p class="mt-1 text-sm text-slate-500">
                    Stay updated with the latest announcements from your school.
                </p>

            </div>


            <!-- ANNOUNCEMENTS -->
            <div class="rounded-xl border border-slate-200 bg-white shadow-sm">

                <div class="border-b border-slate-100 px-5 py-4 sm:px-6">

                    <h2 class="text-sm font-bold text-[#0b2a4a]">
                        Latest Announcements
                    </h2>

                    <p class="mt-1 text-xs text-slate-500">
                        Important information and updates from your school.
                    </p>

                </div>


                <!-- JS WILL INSERT ANNOUNCEMENTS HERE -->
                <div id="announcementList">

                    <div class="px-6 py-16 text-center">

                        <div class="mx-auto flex h-10 w-10 items-center justify-center">
                            <i
                                data-lucide="loader-2"
                                class="w-6 h-6 text-[#17619a] animate-spin"
                            ></i>
                        </div>

                        <p class="mt-3 text-xs text-slate-500">
                            Loading announcements...
                        </p>

                    </div>

                </div>

            </div>

        </section>

</main>

   </div>


    <!-- ==========================================
         ANNOUNCEMENT MODAL
    =========================================== -->

    <div
        id="announcementModal"
        class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 p-4"
    >

        <div
            class="max-h-[90vh] w-full max-w-xl overflow-y-auto rounded-2xl bg-white shadow-xl"
        >

            <!-- Modal Header -->

            <div class="flex items-start justify-between border-b border-slate-100 px-5 py-4 sm:px-6">

                <div class="pr-4">

                    <p
                        id="modalCategory"
                        class="text-[10px] font-semibold uppercase tracking-wide text-blue-600"
                    >
                        Announcement
                    </p>

                    <h2
                        id="modalTitle"
                        class="mt-1 text-base font-bold text-slate-900"
                    >
                        Announcement
                    </h2>

                </div>


                <button
                    onclick="closeAnnouncement()"
                    class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-lg text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
                >
                    ×
                </button>

            </div>


            <!-- Modal Body -->

            <div class="p-5 sm:p-6">

                <div class="mb-5 flex flex-wrap gap-4">

                    <span
                        id="modalDate"
                        class="text-[10px] text-slate-400"
                    >
                        📅 August 2, 2026
                    </span>

                    <span
                        id="modalAuthor"
                        class="text-[10px] text-slate-400"
                    >
                        👨‍💼 School Administration
                    </span>

                </div>


                <div class="rounded-xl bg-slate-50 p-4 sm:p-5">

                    <p
                        id="modalDescription"
                        class="text-sm leading-7 text-slate-600"
                    >
                        Announcement details will appear here.
                    </p>

                </div>


                <!-- Optional attachment -->

                <div class="mt-5 rounded-xl border border-slate-200 p-4">

                    <div class="flex items-center justify-between gap-4">

                        <div class="flex items-center gap-3">

                            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-red-50">
                                📄
                            </div>

                            <div>

                                <p class="text-xs font-semibold text-slate-700">
                                    Announcement Document
                                </p>

                                <p class="mt-1 text-[10px] text-slate-400">
                                    PDF document
                                </p>

                            </div>

                        </div>

                        <button
                            class="text-xs font-semibold text-blue-600 hover:text-blue-700"
                        >
                            Download
                        </button>

                    </div>

                </div>

            </div>


            <!-- Modal Footer -->

            <div class="border-t border-slate-100 bg-slate-50 px-5 py-4 sm:px-6">

                <button
                    onclick="closeAnnouncement()"
                    class="w-full rounded-lg bg-[#0b2a4a] px-4 py-2.5 text-xs font-semibold text-white transition hover:bg-[#17619a]"
                >
                    Close
                </button>

            </div>

        </div>

    </div>


    <!-- ==========================================
         JAVASCRIPT
    =========================================== -->
<script src="https://unpkg.com/lucide@latest"></script>
<script>
  
    lucide.createIcons()
    async function getAnnouncements() {

        const container = document.getElementById('announcementList');

        try {
            const saveStudent = localStorage.getItem('student');
            const student = saveStudent ? JSON.parse(saveStudent) : null;
            console.log('Student:', student);

            const response = await fetch(`/student/announcement-all/${student.schoolName}`);

            const data = await response.json();

            if (!response.ok) {
                throw new Error(
                    data.message || 'Unable to load announcements'
                );
            }

            renderAnnouncements(data.announcements);

        } catch (error) {

            console.error(error);

            container.innerHTML = `
                <div class="px-6 py-16 text-center">

                    <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-red-50 text-red-500">
                        <i data-lucide="alert-circle" class="w-6 h-6"></i>
                    </div>

                    <h3 class="mt-4 text-sm font-bold text-[#0b2a4a]">
                        Unable to load announcements
                    </h3>

                    <p class="mt-1 text-xs text-slate-500">
                        Please try again later.
                    </p>

                    <button
                        onclick="getAnnouncements()"
                        class="mt-4 rounded-lg bg-[#0b2a4a] px-4 py-2 text-xs font-semibold text-white hover:bg-[#17619a]"
                    >
                        Try Again
                    </button>

                </div>
            `;

            lucide.createIcons();
        }
    }


    function renderAnnouncements(announcements) {

        const container = document.getElementById('announcementList');

        if (!announcements || announcements.length === 0) {

            container.innerHTML = `
                <div class="px-6 py-16 text-center">

                    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-[#17619a]/10 text-[#17619a]">
                        <i data-lucide="megaphone" class="w-7 h-7"></i>
                    </div>

                    <h3 class="mt-4 text-sm font-bold text-[#0b2a4a]">
                        No announcements yet
                    </h3>

                    <p class="mt-1 text-xs text-slate-500">
                        There are currently no announcements to display.
                    </p>

                </div>
            `;

            lucide.createIcons();

            return;
        }


        container.innerHTML = announcements.map(announcement => {

            const date = new Date(
                announcement.publishedAt || announcement.createdAt
            ).toLocaleDateString('en-GB', {
                day: 'numeric',
                month: 'short',
                year: 'numeric'
            });


            const image = announcement.image?.url
                ? `
                    <div class="w-full sm:w-40 sm:h-28 shrink-0">
                        <img
                            src="${announcement.image.url}"
                            alt="${escapeHTML(announcement.title)}"
                            class="w-full h-48 sm:h-28 rounded-xl object-cover"
                        >
                    </div>
                `
                : `
                    <div class="w-full sm:w-40 h-32 sm:h-28 shrink-0 rounded-xl bg-[#17619a]/10 flex items-center justify-center text-[#17619a]">
                        <i data-lucide="megaphone" class="w-7 h-7"></i>
                    </div>
                `;


            return `
                <article class="p-5 sm:p-6 border-b border-slate-100 hover:bg-slate-50/50 transition">

                    <div class="flex flex-col gap-5 sm:flex-row">

                        ${image}

                        <div class="min-w-0 flex-1">

                            <div class="flex flex-wrap items-center gap-2 mb-2">

                                ${
                                    announcement.visibility === 'public'
                                    ? `
                                        <span class="inline-flex items-center gap-1 rounded-full bg-blue-50 px-2 py-1 text-[10px] font-semibold text-[#17619a]">
                                            <i data-lucide="globe" class="w-3 h-3"></i>
                                            Public
                                        </span>
                                    `
                                    : `
                                        <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-1 text-[10px] font-semibold text-[#0b2a4a]">
                                            <i data-lucide="lock" class="w-3 h-3"></i>
                                            Private
                                        </span>
                                    `
                                }

                            </div>


                            <h3 class="text-sm sm:text-base font-bold text-[#0b2a4a]">
                                ${escapeHTML(announcement.title)}
                            </h3>


                            <p class="mt-2 text-xs sm:text-sm leading-5 text-slate-500 line-clamp-2">
                                ${escapeHTML(announcement.content)}
                            </p>


                            <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-[10px] sm:text-xs text-slate-400">

                                ${
                                    announcement.author
                                    ? `
                                        <span class="inline-flex items-center gap-1">
                                            <i data-lucide="user" class="w-3.5 h-3.5"></i>
                                            ${escapeHTML(announcement.author)}
                                        </span>
                                    `
                                    : ''
                                }

                                <span class="inline-flex items-center gap-1">
                                    <i data-lucide="calendar" class="w-3.5 h-3.5"></i>
                                    ${date}
                                </span>

                            </div>


                            <div class="mt-4">

                                <a
                                    href="/student/announcement/${announcement._id}"
                                    class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#17619a] hover:text-[#0b2a4a] transition"
                                >
                                    Read Announcement
                                    <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                                </a>

                            </div>

                        </div>

                    </div>

                </article>
            `;

        }).join('');


        lucide.createIcons();
    }


    // Prevent announcement content from injecting HTML
    function escapeHTML(value) {

        const div = document.createElement('div');

        div.textContent = value ?? '';

        return div.innerHTML;
    }


    // Load after page has loaded
    document.addEventListener('DOMContentLoaded', getAnnouncements);
</script>

</body>

</html>

