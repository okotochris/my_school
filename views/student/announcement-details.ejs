<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= announcement.title %></title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
</head>

<body class="bg-slate-50 text-slate-800">

<div class="min-h-screen py-8 sm:py-12">

    <div class="max-w-4xl mx-auto px-4 sm:px-6">

        <!-- BACK -->
        <div class="mb-6">
            <a
                href="/news"
                class="inline-flex items-center gap-2 text-sm font-medium text-slate-500 hover:text-[#17619a] transition"
            >
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
                Back to News
            </a>
        </div>


        <!-- ANNOUNCEMENT CARD -->
        <article class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">

            <!-- IMAGE -->
            <% if (announcement.image && announcement.image.url) { %>

                <div class="w-full bg-slate-100">

                    <img
                        src="<%= announcement.image.url %>"
                        alt="<%= announcement.title %>"
                        class="w-full max-h-[500px] object-cover"
                    >

                </div>

            <% } %>


            <!-- CONTENT -->
            <div class="p-5 sm:p-8 lg:p-10">

                <!-- META -->
                <div class="flex flex-wrap items-center gap-3 mb-5">

                    <% if (announcement.visibility === 'public') { %>

                        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-blue-50 text-[#17619a] text-xs font-semibold">
                            <i data-lucide="globe" class="w-3.5 h-3.5"></i>
                            Public
                        </span>

                    <% } %>


                    <span class="text-sm text-slate-400">
                        <%= new Date(
                            announcement.publishedAt || announcement.createdAt
                        ).toLocaleDateString('en-GB', {
                            day: 'numeric',
                            month: 'long',
                            year: 'numeric'
                        }) %>
                    </span>

                </div>


                <!-- TITLE -->
                <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#0b2a4a] leading-tight">
                    <%= announcement.title %>
                </h1>


                <!-- AUTHOR -->
                <% if (announcement.author) { %>

                    <div class="flex items-center gap-2 mt-4 text-sm text-slate-500">

                        <div class="w-8 h-8 rounded-full bg-[#17619a]/10 text-[#17619a] flex items-center justify-center">
                            <i data-lucide="user" class="w-4 h-4"></i>
                        </div>

                        <span>
                            Posted by <strong class="text-slate-700">
                                <%= announcement.author %>
                            </strong>
                        </span>

                    </div>

                <% } %>


                <!-- DIVIDER -->
                <div class="h-px bg-slate-100 my-7"></div>


                <!-- ANNOUNCEMENT CONTENT -->
                <div class="prose prose-slate max-w-none">

                    <div class="text-slate-600 leading-8 text-base sm:text-lg whitespace-pre-line">
                        <%= announcement.content %>
                    </div>

                </div>

            </div>

        </article>


        <!-- SCHOOL INFORMATION -->
        <div class="mt-6 bg-white rounded-2xl border border-slate-200 p-5 sm:p-6">

            <div class="flex items-center gap-4">

                <div class="w-11 h-11 rounded-xl bg-[#17619a]/10 text-[#17619a] flex items-center justify-center shrink-0">
                    <i data-lucide="school" class="w-5 h-5"></i>
                </div>

                <div>

                    <p class="text-xs uppercase tracking-wide text-slate-400">
                        School
                    </p>

                    <p class="font-semibold text-[#0b2a4a] mt-1">
                        <%= announcement.school %>
                    </p>

                </div>

            </div>

        </div>


        <!-- BACK TO NEWS -->
        <div class="text-center mt-8">

            <a
                href="/news"
                class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-[#17619a] text-white font-medium hover:bg-[#0b2a4a] transition"
            >
                <i data-lucide="newspaper" class="w-4 h-4"></i>
                View More News
            </a>

        </div>

    </div>

</div>


<script>
    lucide.createIcons();
</script>

</body>
</html>