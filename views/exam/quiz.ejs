                    </div>

                </div>



                <!-- Mathematics -->

                <div class="exam-card rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">

                    <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">


                        <div class="flex items-start gap-4">

                            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-purple-50 text-purple-600">

                                <i class="fas fa-calculator text-lg"></i>

                            </div>


                            <div>

                                <div class="flex flex-wrap items-center gap-2">

                                    <h3 class="text-sm font-bold text-slate-900 sm:text-base">

                                        Mathematics

                                    </h3>


                                    <span class="rounded-full bg-emerald-50 px-2 py-1 text-[9px] font-semibold text-emerald-600">

                                        Available

                                    </span>

                                </div>


                                <p class="mt-1 text-xs text-slate-500">

                                    Second Term Examination

                                </p>


                                <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-[10px] text-slate-400">

                                    <span>

                                        <i class="fas fa-clock mr-1"></i>

                                        60 Minutes

                                    </span>


                                    <span>

                                        <i class="fas fa-list-ol mr-1"></i>

                                        50 Questions

                                    </span>


                                    <span>

                                        <i class="fas fa-star mr-1"></i>

                                        50 Marks

                                    </span>

                                </div>

                            </div>

                        </div>


                        <button
                            onclick="startExam('mathematics')"
