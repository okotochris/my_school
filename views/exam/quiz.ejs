                    <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">


                        <div class="flex items-start gap-4">

                            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">

                                <i class="fas fa-dna text-lg"></i>

                            </div>


                            <div>

                                <div class="flex flex-wrap items-center gap-2">

                                    <h3 class="text-sm font-bold text-slate-900 sm:text-base">

                                        Biology

                                    </h3>


                                    <span class="rounded-full bg-amber-50 px-2 py-1 text-[9px] font-semibold text-amber-600">

                                        Starts Soon

                                    </span>

                                </div>


                                <p class="mt-1 text-xs text-slate-500">

                                    Second Term Examination

                                </p>


                                <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-[10px] text-slate-400">

                                    <span>

                                        <i class="fas fa-clock mr-1"></i>

                                        45 Minutes

                                    </span>


                                    <span>

                                        <i class="fas fa-list-ol mr-1"></i>

                                        30 Questions

                                    </span>


                                    <span>

                                        <i class="fas fa-star mr-1"></i>

                                        30 Marks

                                    </span>

                                </div>

                            </div>

                        </div>


                        <button
                            disabled
                            class="flex w-full cursor-not-allowed items-center justify-center gap-2 rounded-xl bg-slate-100 px-5 py-3 text-xs font-semibold text-slate-400 sm:w-auto"
                        >

                            Not Available

                        </button>

                    </div>

                </div>

            </div>

        </section>



        <!-- ==========================================
             INFORMATION
        =========================================== -->

        <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">

            <div class="flex items-start gap-3">

                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-500">

                    <i class="fas fa-info"></i>

                </div>


                <div>

                    <h3 class="text-xs font-bold text-slate-800">

                        Before you begin

                    </h3>


                    <ul class="mt-2 space-y-1.5 text-[10px] leading-5 text-slate-500">

                        <li>

                            <i class="fas fa-check mr-1 text-emerald-500"></i>

                            Make sure you have a stable internet connection.

                        </li>


                        <li>

                            <i class="fas fa-check mr-1 text-emerald-500"></i>

                            Once an examination starts, the timer cannot be paused.

                        </li>


                        <li>

                            <i class="fas fa-check mr-1 text-emerald-500"></i>

                            Make sure you are ready before starting your examination.

                        </li>

                    </ul>

                </div>

            </div>

        </section>



    </main>



    <script>

        function startExam(examId) {

            /*
                In production, don't trust examId from
                the browser alone.

                Your server should verify:

                1. Student is authenticated
                2. Exam exists
                3. Exam is assigned to student's class
                4. Exam is currently available
                5. Student hasn't already submitted it
                6. Student is allowed to start it
            */

            window.location.href =
                `/myschool/quiz/exam_intro?exam=${encodeURIComponent(examId)}`;

        }



        // ==========================================
        // MENU LOGIC
        // ==========================================

        const hamburger =
            document.querySelector(".hamburger");

        const mobileMenu =
            document.querySelector(".mobile-menu");

        const closeMenu =
            document.querySelector(".close-menu");


        if (hamburger && mobileMenu) {

            hamburger.addEventListener("click", () => {

                mobileMenu.style.display = "block";

                setTimeout(() => {

                    mobileMenu.classList.add("active");

                }, 10);

            });

        }


        if (closeMenu && mobileMenu) {

            closeMenu.addEventListener("click", () => {

                mobileMenu.classList.remove("active");

                setTimeout(() => {

                    mobileMenu.style.display = "none";

                }, 300);

            });

        }


        window.addEventListener("resize", () => {

            if (window.innerWidth > 768 && mobileMenu) {

                mobileMenu.classList.remove("active");

                mobileMenu.style.display = "none";

            }

        });


        document.addEventListener("DOMContentLoaded", () => {

            if (window.innerWidth > 768 && mobileMenu) {

                mobileMenu.style.display = "none";

            }

        });

    </script>

</body>

</html>

