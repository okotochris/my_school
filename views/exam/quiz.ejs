                    </h1>


                    <p class="mt-2 max-w-xl text-sm leading-6 text-slate-500">

                        Select an examination assigned to you to view the
                        instructions and begin.

                    </p>

                </div>


                <!-- Student -->

                <div class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm">

                    <div class="flex h-10 w-10 items-center justify-center rounded-full bg-blue-100 font-bold text-blue-700">

                        J

                    </div>


                    <div>

                        <p class="text-xs font-semibold text-slate-800">

                            James11

                        </p>

                        <p class="text-[10px] text-slate-400">

                            Logged in student

                        </p>

                    </div>

                </div>

            </div>

        </section>



        <!-- ==========================================
             CURRENT SESSION
        =========================================== -->

        <div class="mb-6 rounded-2xl border border-blue-100 bg-blue-50 p-4 sm:p-5">

            <div class="flex items-start gap-3">

                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white text-blue-600 shadow-sm">

                    <i class="fas fa-calendar-check"></i>

                </div>


                <div>

                    <p class="text-xs font-bold text-blue-900">

                        Current Academic Session

                    </p>

                    <p class="mt-1 text-xs text-blue-700">

                        2025/2026 • Second Term

                    </p>

                </div>

            </div>

        </div>



        <!-- ==========================================
             AVAILABLE EXAMS
        =========================================== -->

        <section>

            <div class="mb-4 flex items-center justify-between">

                <div>

                    <h2 class="text-sm font-bold text-slate-900">

                        Your Examinations

                    </h2>

                    <p class="mt-1 text-[11px] text-slate-400">

                        Examinations available for your class

                    </p>

                </div>


                <span class="rounded-full bg-emerald-50 px-3 py-1 text-[10px] font-semibold text-emerald-600">

                    3 Available

                </span>

            </div>



            <!-- ==========================================
                 EXAM CARD
            =========================================== -->

            <div class="space-y-4">


                <!-- English -->

                <div class="exam-card rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">

                    <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">


                        <!-- Exam Information -->

                        <div class="flex items-start gap-4">


                            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600">

                                <i class="fas fa-book text-lg"></i>

                            </div>


                            <div>

                                <div class="flex flex-wrap items-center gap-2">

                                    <h3 class="text-sm font-bold text-slate-900 sm:text-base">

                                        English Language

                                    </h3>


                                    <span class="rounded-full bg-emerald-50 px-2 py-1 text-[9px] font-semibold text-emerald-600">

                                        Available

                                    </span>

                                </div>


                                <p class="mt-1 text-xs text-slate-500">

                                    Second Term Examination

                                </p>


                                <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-[10px] text-slate-400">

