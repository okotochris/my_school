<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Timetables</title>
    <link rel="stylesheet" href="/styles/global.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        .primary-bg {
            background-color: #0b2a4a;
        }

        .secondary-bg {
            background-color: #17619a;
        }

        .primary-text {
            color: #0b2a4a;
        }

        .secondary-text {
            color: #17619a;
        }
    </style>
</head>

<body class="bg-slate-50 text-slate-800">

    <!-- Your shared header can go here -->
    <%- include('./partials/header') %>
        <div class="admin-container">
            <%- include('./partials/navigation.ejs') %>
                <main class="w-full ">

                    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

                        <!-- PAGE HEADER -->
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">

                            <div>
                                <div class="flex items-center gap-2 mb-2">
                                    <div class="w-9 h-9 rounded-xl primary-bg flex items-center justify-center">
                                        <i data-lucide="calendar-days" class="w-5 h-5 text-white"></i>
                                    </div>

                                    <span class="text-sm font-medium secondary-text">
                                        School Management
                                    </span>
                                </div>

                                <h1 class="text-2xl sm:text-3xl font-bold primary-text">
                                    Timetables
                                </h1>

                                <p class="text-sm text-slate-500 mt-1">
                                    Manage class timetables and weekly schedules.
                                </p>
                            </div>


                            <!-- ADD BUTTON -->
                            <button type="button" onclick="openTimetableModal()" class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-[#17619a] hover:bg-[#0b2a4a] text-white font-semibold text-sm transition shadow-sm">
                                <i data-lucide="plus" class="w-5 h-5"></i>
                                Add Timetable
                            </button>

                        </div>
                        <div class="bg-white border border-slate-200 rounded-2xl p-5 my-5">

                            <div class="mb-5">
                                <h2 class="text-lg font-semibold text-[#0b2a4a]">
                                    Select Class
                                </h2>

                                <p class="text-sm text-slate-500 mt-1">
                                    Select a class to view its timetable.
                                </p>
                            </div>

                            <div class="flex flex-wrap gap-3">

                                <% classes.forEach(studentClass => { %>

                                    <a
                                        href="/admin/timetable/<%= encodeURIComponent(studentClass) %>"
                                        class="inline-flex items-center gap-2
                                            px-5 py-3 rounded-xl
                                            border border-slate-200
                                            bg-white text-slate-700
                                            text-sm font-semibold
                                            hover:border-[#17619a]
                                            hover:bg-[#17619a]
                                            hover:text-white
                                            transition"
                                    >

                                        <i data-lucide="calendar-days" class="w-4 h-4"></i>

                                        <%= studentClass %>

                                    </a>

                                <% }) %>

                            </div>

                        </div>
                        <!-- CLASS TIMETABLE CARDS -->

                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">

                            <% if (timetables && timetables.length> 0) { %>

                                <% timetables.forEach((item)=> { %>

                                    <div  class="group bg-white border border-slate-200 rounded-2xl p-5
                                        hover:border-[#17619a] hover:shadow-md
                                        transition-all duration-200">

                                        <!-- TOP -->
                                        <div class="flex items-start justify-between gap-3">

                                            <div class="w-12 h-12 rounded-xl bg-blue-50 flex items-center justify-center shrink-0 group-hover:bg-[#17619a] transition">
                                                <i data-lucide="calendar-days" class="w-6 h-6 text-[#17619a]group-hover:text-white transition"></i>
                                            </div>

                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold">
                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                                Active
                                            </span>

                                        </div>


                                        <!-- CLASS NAME -->
                                        <div class="mt-5">

                                            <h3 class="text-lg font-bold text-[#0b2a4a]group-hover:text-[#17619a] transition">
                                                <%= item.studentClass %>
                                            </h3>

                                            <p class="text-sm text-slate-500 mt-1">
                                                Weekly class timetable
                                            </p>

                                        </div>


                                        <!-- STATS -->
                                        <div class="mt-5 pt-4 border-t border-slate-100 grid grid-cols-2 gap-4">

                                            <div>
                                                <p class="text-xs text-slate-400">
                                                    Periods
                                                </p>

                                                <p class="text-sm font-semibold text-slate-700 mt-1">
                                                    <%= item.period || 0 %>
                                                </p>
                                            </div>


                                            <div>
                                                <p class="text-xs text-slate-400">
                                                    School Days
                                                </p>

                                                <p class="text-sm font-semibold text-slate-700 mt-1">
                                                    <%= item.day || 0 %>
                                                </p>
                                            </div>

                                        </div>


                                        <!-- VIEW -->
                                        <div 
                                            onclick="handleDelete('<%= item._id %>')"
                                            class="mt-5 flex items-center justify-between text-sm font-medium text-[#17619a]">
                                            <span>
                                                Delete
                                            </span>

                                            <span class="w-8 h-8 rounded-lg bg-red-50 flex items-center justify-center group-hover:bg-red-500                                transition">
                                                <i data-lucide="trash" class="w-4 h-4 text-red-800 group-hover:text-white transition"></i>
                                            </span>
                                        
                                        </div>

                                    </div>

                                    <% }) %>

                                        <% } else { %>

                                            <!-- EMPTY STATE -->

                                            <div class="col-span-full bg-white border border-slate-200rounded-2xl py-16 px-6 text-center">

                                                <div class="w-16 h-16 mx-auto rounded-2xl bg-blue-50 flex items-center justify-center mb-4">
                                                    <i data-lucide="calendar-days" class="w-8 h-8 text-[#17619a]"></i>
                                                </div>

                                                <h3 class="text-lg font-semibold text-[#0b2a4a]">
                                                    No timetables found
                                                </h3>

                                                <p class="text-sm text-slate-500 mt-1 max-w-sm mx-auto">
                                                    Create a timetable for a class to get started.
                                                </p>

                                            </div>

                                            <% } %>

                        </div>

                        <script>
                            if (window.lucide) {
                                lucide.createIcons();
                            }
                        </script>




                    </div>

                </main>
                <!-- TIMETABLE MODAL -->
                <div id="timetableModal" class="fixed inset-0 z-50 hidden">

                    <!-- BACKDROP -->
                    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" onclick="closeTimetableModal()">
                    </div>


                    <!-- MODAL -->
                    <div class="relative h-full flex items-center justify-center px-4">

                        <div class="w-full max-w-2xl bg-white rounded-2xl shadow-2xl
                   overflow-hidden max-h-[90vh] overflow-y-auto">

                            <!-- HEADER -->
                            <div class="px-6 py-5 border-b border-slate-100
                       flex items-center justify-between sticky top-0
                       bg-white z-10">

                                <div>
                                    <h2 class="text-lg font-bold text-[#0b2a4a]">
                                        Add Timetable
                                    </h2>

                                    <p class="text-sm text-slate-500 mt-1">
                                        Add a class timetable period.
                                    </p>
                                </div>

                                <button type="button" onclick="closeTimetableModal()" class="w-9 h-9 rounded-lg flex items-center justify-center
                           text-slate-400 hover:text-slate-700
                           hover:bg-slate-100 transition">
                                    <i data-lucide="x" class="w-5 h-5"></i>
                                </button>

                            </div>


                            <!-- FORM -->
                            <form id="timetableForm" class="p-6 space-y-5">

                                <!-- CLASS + DAY -->
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

                                    <div>
                                        <label class="block text-sm font-medium text-slate-700 mb-2">
                                            Class
                                        </label>

                                        <select onchange="getSubject(this.value)" name="studentClass" required class="w-full px-4 py-3 rounded-xl border border-slate-200
                                   bg-white text-sm focus:outline-none
                                   focus:ring-2 focus:ring-[#17619a]/20
                                   focus:border-[#17619a]">
                                            <option value="">Select class</option>
                                            <option value="NURSERY 1">Nursery 1</option>
                                            <option value="NURSERY 2">Nursery 2</option>
                                            <option value="BASIC 1">Basic 1</option>
                                            <option value="BASIC 2">Basic 2</option>
                                            <option value="BASIC 3">Basic 3</option>
                                            <option value="BASIC 4">Basic 4</option>
                                            <option value="BASIC 5">Basic 5</option>
                                            <option value="BASIC 6">Basic 6</option>
                                            <option value="JSS 1">JSS 1</option>
                                            <option value="JSS 2">JSS 2</option>
                                            <option value="JSS 3">JSS 3</option>
                                            <option value="SS 1">SS 1</option>
                                            <option value="SS 2">SS 2</option>
                                            <option value="SS 3">SS 3</option>
                                        </select>
                                    </div>


                                    <div>
                                        <label class="block text-sm font-medium text-slate-700 mb-2">
                                            Day
                                        </label>

                                        <select name="day" required class="w-full px-4 py-3 rounded-xl border border-slate-200
                                   bg-white text-sm focus:outline-none
                                   focus:ring-2 focus:ring-[#17619a]/20
                                   focus:border-[#17619a]">
                                            <option value="">Select day</option>
                                            <option value="Monday">Monday</option>
                                            <option value="Tuesday">Tuesday</option>
                                            <option value="Wednesday">Wednesday</option>
                                            <option value="Thursday">Thursday</option>
                                            <option value="Friday">Friday</option>
                                            <option value="Saturday">Saturday</option>
                                        </select>
                                    </div>

                                </div>


                                <!-- SUBJECT + TEACHER -->
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

                                    <div>
                                        <label class="block text-sm font-medium text-slate-700 mb-2">
                                            Subject
                                        </label>

                                        <select id="subject" name="subject" required class="w-full px-4 py-3 rounded-xl border border-slate-200
                                   text-sm focus:outline-none
                                   focus:ring-2 focus:ring-[#17619a]/20
                                   focus:border-[#17619a]">
                                            <option value="">Select subject</option>
                                        </select>
                                    </div>


                                    <div>
                                        <label class="block text-sm font-medium text-slate-700 mb-2">
                                            Teacher
                                        </label>

                                        <input type="text" name="teacher" placeholder="Teacher's name" class="w-full px-4 py-3 rounded-xl border border-slate-200
                                   text-sm focus:outline-none
                                   focus:ring-2 focus:ring-[#17619a]/20
                                   focus:border-[#17619a]">
                                    </div>

                                </div>


                                <!-- START + END TIME -->
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

                                    <div>
                                        <label class="block text-sm font-medium text-slate-700 mb-2">
                                            Start Time
                                        </label>

                                        <input type="time" name="startTime" required class="w-full px-4 py-3 rounded-xl border border-slate-200
                                   text-sm focus:outline-none
                                   focus:ring-2 focus:ring-[#17619a]/20
                                   focus:border-[#17619a]">
                                    </div>


                                    <div>
                                        <label class="block text-sm font-medium text-slate-700 mb-2">
                                            End Time
                                        </label>

                                        <input type="time" name="endTime" required class="w-full px-4 py-3 rounded-xl border border-slate-200
                                   text-sm focus:outline-none
                                   focus:ring-2 focus:ring-[#17619a]/20
                                   focus:border-[#17619a]">
                                    </div>

                                </div>


                                <!-- PERIOD + ROOM -->
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

                                    <div>
                                        <label class="block text-sm font-medium text-slate-700 mb-2">
                                            Period
                                        </label>

                                        <input type="number" name="period" min="1" required placeholder="e.g. 1" class="w-full px-4 py-3 rounded-xl border border-slate-200
                                   text-sm focus:outline-none
                                   focus:ring-2 focus:ring-[#17619a]/20
                                   focus:border-[#17619a]">
                                    </div>


                                    <div>
                                        <label class="block text-sm font-medium text-slate-700 mb-2">
                                            Room
                                        </label>

                                        <input type="text" name="room" placeholder="e.g. Room 5" class="w-full px-4 py-3 rounded-xl border border-slate-200
                                   text-sm focus:outline-none
                                   focus:ring-2 focus:ring-[#17619a]/20
                                   focus:border-[#17619a]">
                                    </div>

                                </div>


                                <!-- TYPE -->
                                <div>

                                    <label class="block text-sm font-medium text-slate-700 mb-2">
                                        Timetable Type
                                    </label>

                                    <select name="type" class="w-full px-4 py-3 rounded-xl border border-slate-200
                               bg-white text-sm focus:outline-none
                               focus:ring-2 focus:ring-[#17619a]/20
                               focus:border-[#17619a]">
                                        <option value="lesson">Lesson</option>
                                        <option value="break">Break</option>
                                        <option value="assembly">Assembly</option>
                                        <option value="exam">Exam</option>
                                        <option value="other">Other</option>
                                    </select>

                                </div>


                                <!-- ACTIONS -->
                                <div class="flex flex-col-reverse sm:flex-row sm:justify-end
                           gap-3 pt-4 border-t border-slate-100">

                                    <button type="button" onclick="closeTimetableModal()" class="px-5 py-3 rounded-xl border border-slate-200
                               text-slate-600 hover:bg-slate-50
                               text-sm font-medium transition">
                                        Cancel
                                    </button>

                                    <button type="submit" id="saveTimetableBtn" class="px-5 py-3 rounded-xl bg-[#17619a]
                               hover:bg-[#0b2a4a] text-white
                               text-sm font-semibold transition
                               inline-flex items-center justify-center gap-2">
                                        <i data-lucide="save" class="w-4 h-4"></i>
                                        Save Timetable
                                    </button>

                                </div>

                            </form>

                        </div>

                    </div>

                </div>
        </div>
        <script>
            //GET SUBJECTS BASED ON CLASS
            async function getSubject(studentClass) {
                let subjectClass = studentClass.replace(/[0-9]/g, '').trim();

                if (subjectClass === 'SS') {
                    subjectClass = 'Senior';
                } else if (subjectClass === 'JS') {
                    subjectClass = 'Junior';
                } else if (subjectClass === 'BASIC') {
                    subjectClass = 'Basic';
                } else {
                    subjectClass = 'Nursery';
                }

                try {
                    const result = await fetch(`/admin/get-subject/${subjectClass}`);

                    if (!result.ok) {
                        console.log('Something went wrong:', result.status);
                        return;
                    }
                    const { subject } = await result.json()
                    renderSubject(subject)
                } catch (err) {
                    console.log(err);
                }
            }
            function renderSubject(data) {
                const subject = document.getElementById('subject');
                subject.innerHTML = `<option value="">Select subject</option>`
                data.subjects.forEach(element => {
                    subject.innerHTML += `
                    <option value="${element.subjectName}">
                        ${element.subjectName}
                    </option>
                `;
                });
            }

        </script>
        <script>

            lucide.createIcons();
            // SEARCH
            const searchInput = document.getElementById('searchInput');
            const classFilter = document.getElementById('classFilter');

            function filterTimetables() {

                const search =
                    searchInput.value.toLowerCase().trim();

                const selectedClass =
                    classFilter.value.toLowerCase();

                document.querySelectorAll('.timetable-item')
                    .forEach(item => {

                        const className =
                            item.dataset.class;

                        const matchesSearch =
                            className.includes(search);

                        const matchesClass =
                            !selectedClass ||
                            className === selectedClass;

                        item.style.display =
                            matchesSearch && matchesClass
                                ? ''
                                : 'none';
                    });
            }


            searchInput.addEventListener(
                'input',
                filterTimetables
            );

            classFilter.addEventListener(
                'change',
                filterTimetables
            );

        </script>
        <script>

            function openTimetableModal() {
                document
                    .getElementById('timetableModal')
                    .classList.remove('hidden');

                document.body.classList.add('overflow-hidden');
            }


            function closeTimetableModal() {
                document
                    .getElementById('timetableModal')
                    .classList.add('hidden');

                document.body.classList.remove('overflow-hidden');
            }


            // Close with Escape
            document.addEventListener('keydown', (e) => {

                if (e.key === 'Escape') {
                    closeTimetableModal();
                }

            });


            // Submit
            document
                .getElementById('timetableForm')
                .addEventListener('submit', async function (e) {

                    e.preventDefault();

                    const formData = new FormData(this);

                    const button =
                        document.getElementById('saveTimetableBtn');

                    button.disabled = true;

                    button.innerHTML = `
                    <span class="w-4 h-4 border-2 border-white/40
                                border-t-white rounded-full animate-spin"></span>
                    Saving...
                `;

                    try {

                        const response = await fetch('/admin/timetable', {
                            method: 'POST',
                            body: formData
                        });

                        const data = await response.json();

                        if (!response.ok) {
                            throw new Error(
                                data.message || 'Failed to save timetable'
                            );
                        }

                        closeTimetableModal();

                        // Reload to show the new timetable
                        window.location.reload();

                    } catch (error) {

                        console.error(error);

                        showMessagePopup(error.message);

                        button.disabled = false;

                        button.innerHTML = `
                        <i data-lucide="save" class="w-4 h-4"></i>
                        Save Timetable
                    `;

                        lucide.createIcons();
                    }

                });


            //delete record
            async function handleDelete(_id){
                console.log(_id)
               try {
                 const result = await fetch(`/admin/timetalbe-delete/${_id}`, {method:'Delete'})
                if(!result){
                    showMessagePopup('Unable to delete')
                    return
                }
                showMessagePopup('Deleted successfuly')
                window.location.reload()
               } catch (error) {
                console.log(error)
                showMessagePopup("Server error")
               }
            }
            lucide.createIcons();

        </script>
</body>

</html>