<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Choose Result Template - MySchoolResult</title>

    <script src="https://cdn.tailwindcss.com"></script>
     <link rel="stylesheet" href="/styles/global.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#1e3a8a',
                        secondary: '#2563eb'
                    }
                }
            }
        }
    </script>
</head>

<body class="bg-slate-100 min-h-screen">
    <%- include("./partials/header.ejs") %>

    <div class="flex">
    <%- include("./partials/navigation.ejs") %>
    <!-- Main -->
    <div  class="flex-1">
         <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

        <!-- Heading -->
        <div class="text-center max-w-2xl mx-auto mb-8">

            <span class="inline-flex items-center px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold mb-3">
                Result Templates
            </span>

            <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">
                Choose a Result Template
            </h2>

            <p class="mt-2 text-sm sm:text-base text-slate-500">
                Select the design you want your school's student results to use.
                You can preview each template before selecting it.
            </p>

        </div>


        <!-- Search + Filter -->
        <div class="bg-white border border-slate-200 rounded-2xl p-4 mb-8">

            <div class="flex flex-col lg:flex-row gap-4 justify-between">

                <!-- Search -->
                <div class="relative w-full lg:max-w-sm">

                    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400"
                         fill="none"
                         stroke="currentColor"
                         viewBox="0 0 24 24">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M21 21l-4.35-4.35m2.35-5.65a8 8 0 11-16 0 8 8 0 0116 0z"/>

                    </svg>

                    <input
                        id="searchInput"
                        type="text"
                        placeholder="Search templates..."
                        class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 outline-none text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                    >

                </div>


                <!-- Filters -->
                <div class="flex flex-wrap gap-2">

                    <button
                        onclick="filterTemplates('all', this)"
                        class="filter-btn active px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-medium">
                        All
                    </button>

                    <button
                        onclick="filterTemplates('modern', this)"
                        class="filter-btn px-4 py-2 rounded-lg bg-slate-100 text-slate-600 text-sm font-medium hover:bg-slate-200">
                        Modern
                    </button>

                    <button
                        onclick="filterTemplates('classic', this)"
                        class="filter-btn px-4 py-2 rounded-lg bg-slate-100 text-slate-600 text-sm font-medium hover:bg-slate-200">
                        Classic
                    </button>

                    <button
                        onclick="filterTemplates('professional', this)"
                        class="filter-btn px-4 py-2 rounded-lg bg-slate-100 text-slate-600 text-sm font-medium hover:bg-slate-200">
                        Professional
                    </button>

                </div>

            </div>

        </div>


        <!-- Templates -->
        <div id="templateGrid"
             class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">


            <!-- Template 1 -->
            <div class="template-card group"
                 data-name="template-1"
                 data-category="modern">

                <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden hover:border-blue-400 hover:shadow-xl transition duration-300">

                    <!-- Preview -->
                    <div class="bg-slate-100 p-5">

                        <div class="aspect-[210/297] bg-white shadow-lg rounded-sm overflow-hidden">

                            <div class="h-8 bg-blue-700"></div>

                            <div class="p-3">

                                <div class="text-center">
                                    <div class="w-8 h-8 rounded-full bg-blue-100 mx-auto mb-2"></div>

                                    <div class="h-2 w-24 bg-slate-800 mx-auto rounded"></div>
                                    <div class="h-1.5 w-16 bg-slate-300 mx-auto mt-1 rounded"></div>
                                </div>

                                <div class="mt-5 grid grid-cols-2 gap-2">
                                    <div class="h-2 bg-slate-200 rounded"></div>
                                    <div class="h-2 bg-slate-200 rounded"></div>
                                </div>

                                <div class="mt-4 space-y-1">
                                    <div class="h-2 bg-blue-100 rounded"></div>
                                    <div class="h-2 bg-slate-100 rounded"></div>
                                    <div class="h-2 bg-slate-100 rounded"></div>
                                    <div class="h-2 bg-slate-100 rounded"></div>
                                    <div class="h-2 bg-slate-100 rounded"></div>
                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- Info -->
                    <div class="p-4">

                        <div class="flex justify-between items-start gap-3">

                            <div>
                                <h3 class="font-bold text-slate-900">
                                    Modern Blue
                                </h3>

                                <p class="text-xs text-slate-500 mt-1">
                                    Clean and modern school result design.
                                </p>
                            </div>

                            <span class="text-[10px] px-2 py-1 rounded-full bg-blue-50 text-blue-700 font-semibold">
                                Modern
                            </span>

                        </div>

                        <div class="flex gap-2 mt-4">

                            <button
                                onclick="previewTemplate('template-1')"
                                class="flex-1 py-2 rounded-lg border border-slate-200 text-sm font-medium text-slate-600 hover:bg-slate-50">
                                Preview
                            </button>

                            <button
                                onclick="selectTemplate(1, 'template-1')"
                                class="flex-1 py-2 rounded-lg bg-blue-600 text-white text-sm font-medium hover:bg-blue-700">
                                Use Template
                            </button>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Template 2 -->
