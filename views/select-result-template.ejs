    <!-- Preview Modal -->
    <div id="previewModal"
         class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm p-4">

        <div class="min-h-full flex items-center justify-center">

            <div class="bg-white rounded-2xl w-full max-w-4xl max-h-[95vh] overflow-hidden shadow-2xl">

                <!-- Modal Header -->
                <div class="flex items-center justify-between px-5 py-4 border-b">

                    <div>
                        <h3 id="previewTitle"
                            class="font-bold text-lg text-slate-900">
                            Template Preview
                        </h3>

                        <p class="text-xs text-slate-500">
                            Preview before selecting your template
